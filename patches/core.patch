index 0000000..c36a0e4
--- /dev/null
+++ b/test/accessibility/test_input.cpp
@@ -0,0 +1,192 @@
+// Host names, button overrides, release semantics and modifier consumption.
+#include "harness.hpp"
+
+#include <vector>
+
+#include "accessibility/bounded_memory.hpp"
+#include "accessibility/host_input.hpp"
+#include "accessibility/lua_reader.hpp"
+#include "accessibility/speech.hpp"
+
+using namespace MelonDsDs::access;
+
+namespace {
+    constexpr uint32_t Bit(unsigned id) { return 1u << id; }
+
+    struct Fixture {
+        std::vector<uint8_t> ram = std::vector<uint8_t>(0x100, 0);
+        BoundedMemory ramView {ram.data(), ram.size()};
+        BoundedMemory romView;
+        RecordingSpeechSink sink;
+        std::vector<std::string> logs;
+        SpeechDispatcher speech {&sink, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }};
+        LuaReader reader {ReaderHost {&ramView, &romView, &speech, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }}};
+    };
+}
+
+TEST_CASE(host_names_follow_bizhawk_sdl_layout_and_ds_button_order) {
+    REQUIRE_EQ(std::string(HostPadName(retro_id::L2)), std::string("X1 LeftTrigger"));
+    REQUIRE_EQ(std::string(HostPadName(retro_id::R2)), std::string("X1 RightTrigger"));
+    REQUIRE_EQ(std::string(HostPadName(retro_id::L3)), std::string("X1 LeftThumb"));
+    REQUIRE_EQ(std::string(HostPadName(retro_id::R3)), std::string("X1 RightThumb"));
+    REQUIRE_EQ(std::string(HostPadName(retro_id::X)), std::string("X1 Y"));   // top face button
+    REQUIRE_EQ(std::string(HostPadName(retro_id::A)), std::string("X1 B"));   // right face button
+    REQUIRE_EQ(std::string(HostPadName(retro_id::B)), std::string("X1 A"));
+    REQUIRE_EQ(std::string(HostPadName(retro_id::Y)), std::string("X1 X"));
+    REQUIRE_EQ(std::string(HostPadName(retro_id::UP)), std::string("X1 DpadUp"));
+    REQUIRE(HostPadName(16) == nullptr);
+
+    REQUIRE(RetroIdForDsButton(DsButton::A) == retro_id::A);
+    REQUIRE(RetroIdForDsButton(DsButton::X) == retro_id::X);
+    REQUIRE(RetroIdForDsButton(DsButton::Select) == retro_id::SELECT);
+    REQUIRE(!RetroIdForDsButton(DsButton::Touch).has_value());
+    REQUIRE(!RetroIdForDsButton(DsButton::Power).has_value());
+    REQUIRE(DsButtonFromName("Touch") == DsButton::Touch);
+    REQUIRE(DsButtonFromName("LidClose") == DsButton::LidClose);
+    REQUIRE(!DsButtonFromName("Bogus").has_value());
+    REQUIRE_EQ(std::string(DsButtonName(DsButton::Microphone)), std::string("Microphone"));
+    REQUIRE_EQ(size_t(DsButton::Touch), size_t(14));   // 15th mnemonic character
+}
+
+TEST_CASE(input_get_reports_exactly_the_held_host_inputs) {
+    Fixture f;
+    const char* script = R"(
+        local now = input.get()
+        local n = 0
+        for _ in pairs(now) do n = n + 1 end
+        speech.say(tostring(now["X1 LeftTrigger"] == true and now["X1 DpadUp"] == true and now["R"] == true
+            and now["X1 A"] == nil and now["Q"] == nil) .. " " .. n)
+        emu.frameadvance()
+    )";
+    REQUIRE(f.reader.Load(script, "input.lua"));
+    HostInputSnapshot snap;
+    snap.joypadMask = Bit(retro_id::L2) | Bit(retro_id::UP);
+    snap.keyboardLetters = 1u << ('R' - 'A');
+    REQUIRE(f.reader.StepFrame(snap) == LuaReader::Status::Running);
+    REQUIRE_EQ(f.sink.events[0].text, std::string("true 3"));
+}
+
+TEST_CASE(joypad_set_blocks_forces_and_clears_and_is_wiped_every_frame) {
+    Fixture f;
+    const char* script = R"(
+        joypad.set({Up = false, A = false})      -- frame 1: block two buttons
+        emu.frameadvance()
+        emu.frameadvance()                        -- frame 2: nothing asserted, nothing may stay blocked
+        joypad.set({Up = false})
+        joypad.set({})                            -- frame 3: cleared again within the frame
+        emu.frameadvance()
+        joypad.set({B = true, Touch = false})     -- frame 4: force B, hide the native touch
+        emu.frameadvance()
+    )";
+    REQUIRE(f.reader.Load(script, "set.lua"));
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::UP) | Bit(retro_id::A);
+    raw.pointerPressed = true;
+    LayerConfig layer {false, false};
+
+    REQUIRE(f.reader.StepFrame(raw) == LuaReader::Status::Running);
+    FilteredInput out = ApplyInputLayer(raw, f.reader.Overrides(), layer);
+    REQUIRE_EQ(out.joypadMask, 0u);
+    REQUIRE(!out.suppressPointer);
+
+    REQUIRE(f.reader.StepFrame(raw) == LuaReader::Status::Running);
+    REQUIRE(!f.reader.Overrides().Any());
+    out = ApplyInputLayer(raw, f.reader.Overrides(), layer);
+    REQUIRE_EQ(out.joypadMask, raw.joypadMask);
+
+    REQUIRE(f.reader.StepFrame(raw) == LuaReader::Status::Running);
+    REQUIRE(!f.reader.Overrides().Any());
+    out = ApplyInputLayer(raw, f.reader.Overrides(), layer);
+    REQUIRE_EQ(out.joypadMask, raw.joypadMask);
+
+    REQUIRE(f.reader.StepFrame(raw) == LuaReader::Status::Running);
+    out = ApplyInputLayer(raw, f.reader.Overrides(), layer);
+    REQUIRE_EQ(out.joypadMask, raw.joypadMask | Bit(retro_id::B));
+    REQUIRE(out.suppressPointer);
+    REQUIRE(!out.touchOverride);
+}
+
+TEST_CASE(getimmediate_reports_the_physical_state_regardless_of_overrides) {
+    Fixture f;
+    const char* script = R"(
+        joypad.set({Up = false})
+        local phys = joypad.getimmediate()
+        local bools, nums = 0, 0
+        for k, v in pairs(phys) do
+            if type(v) == "boolean" then bools = bools + 1 elseif type(v) == "number" then nums = nums + 1 end
+        end
+        speech.say(tostring(phys.Up) .. " " .. tostring(phys.A) .. " " .. tostring(phys.Touch) .. " "
+            .. tostring(phys.LidOpen) .. " " .. type(phys["Touch X"]) .. " " .. bools .. " " .. nums)
+        emu.frameadvance()
+    )";
+    REQUIRE(f.reader.Load(script, "immediate.lua"));
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::UP);
+    raw.pointerPressed = true;
+    REQUIRE(f.reader.StepFrame(raw) == LuaReader::Status::Running);
+    REQUIRE_EQ(f.sink.events[0].text, std::string("true false true false number 17 4"));
+}
+
+TEST_CASE(layer_consumes_l2_r2_always_and_l3_only_in_accessibility_role) {
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::L2) | Bit(retro_id::R2) | Bit(retro_id::L3) | Bit(retro_id::R3) | Bit(retro_id::A);
+    InputOverrides none;
+
+    FilteredInput out = ApplyInputLayer(raw, none, LayerConfig {true, true});
+    REQUIRE_EQ(out.joypadMask, Bit(retro_id::R3) | Bit(retro_id::A));
+
+    out = ApplyInputLayer(raw, none, LayerConfig {true, false});
+    REQUIRE_EQ(out.joypadMask, Bit(retro_id::R3) | Bit(retro_id::A) | Bit(retro_id::L3));
+
+    out = ApplyInputLayer(raw, none, LayerConfig {false, true});
+    REQUIRE_EQ(out.joypadMask, raw.joypadMask);
+    REQUIRE(!out.suppressPointer);
+    REQUIRE(!out.touchOverride);
+}
+
+TEST_CASE(release_latch_pattern_from_the_reader_works_against_the_physical_snapshot) {
+    // The reader's pad_step: while the trigger is held block everything; after release keep blocking only
+    // what is still physically down. It relies on joypad.set({}) followed by joypad.getimmediate().
+    Fixture f;
+    const char* script = R"(
+        local latched = {}
+        while true do
+            local now = input.get()
+            local mod = now["X1 LeftTrigger"] and true or false
+            joypad.set({})
+            local phys = joypad.getimmediate()
+            local block = {}
+            if mod then
+                for _, b in ipairs({"Up","Down","Left","Right","Start","Select","B","A","Y","X","L","R"}) do
+                    block[b] = false
+                    latched[b] = phys[b] and true or nil
+                end
+            else
+                for b in pairs(latched) do
+                    if phys[b] then block[b] = false else latched[b] = nil end
+                end
+            end
+            if next(block) ~= nil then joypad.set(block) end
+            emu.frameadvance()
+        end
+    )";
+    REQUIRE(f.reader.Load(script, "latch.lua"));
+    LayerConfig layer {true, true};
+
+    HostInputSnapshot held;   // trigger held with Up
+    held.joypadMask = Bit(retro_id::L2) | Bit(retro_id::UP);
+    REQUIRE(f.reader.StepFrame(held) == LuaReader::Status::Running);
+    REQUIRE_EQ(ApplyInputLayer(held, f.reader.Overrides(), layer).joypadMask, 0u);
+
+    HostInputSnapshot released;   // trigger released, Up still physically down: must stay blocked
+    released.joypadMask = Bit(retro_id::UP);
+    REQUIRE(f.reader.StepFrame(released) == LuaReader::Status::Running);
+    REQUIRE_EQ(ApplyInputLayer(released, f.reader.Overrides(), layer).joypadMask, 0u);
+
+    HostInputSnapshot idle;
+    REQUIRE(f.reader.StepFrame(idle) == LuaReader::Status::Running);
+    HostInputSnapshot fresh;   // a new press of Up after the latch cleared reaches the game
+    fresh.joypadMask = Bit(retro_id::UP);
+    REQUIRE(f.reader.StepFrame(fresh) == LuaReader::Status::Running);
+    REQUIRE_EQ(ApplyInputLayer(fresh, f.reader.Overrides(), layer).joypadMask, Bit(retro_id::UP));
+}
diff --git a/test/accessibility/test_lifecycle.cpp b/test/accessibility/test_lifecycle.cpp
new file mode 100644
index 0000000..25309c5
--- /dev/null
+++ b/test/accessibility/test_lifecycle.cpp
@@ -0,0 +1,200 @@
+// ReaderSession lifecycle: game guard, restart, failure, detach, configuration. No stuck keys or touch.
+#include "harness.hpp"
+
+#include <cstring>
+#include <vector>
+
+#include "accessibility/bounded_memory.hpp"
+#include "accessibility/host_input.hpp"
+#include "accessibility/reader_session.hpp"
+#include "accessibility/speech.hpp"
+
+using namespace MelonDsDs::access;
+
+namespace {
+    constexpr uint32_t Bit(unsigned id) { return 1u << id; }
+
+    struct Fixture {
+        std::vector<uint8_t> ram = std::vector<uint8_t>(0x400000, 0);   // the DS main RAM window
+        std::vector<uint8_t> rom = std::vector<uint8_t>(0x1000, 0);
+        RecordingSpeechSink sink;
+        std::vector<std::string> logs;
+        SpeechDispatcher speech {&sink, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }};
+        ReaderSession session {&speech, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }};
+
+        void SetGame(const char* code, uint8_t revision) {
+            std::memcpy(rom.data() + 0x0C, code, 4);
+            rom[0x1E] = revision;
+        }
+
+        SupportedGame Attach(std::string_view script) {
+            return session.Attach(rom.data(), rom.size(), BoundedMemory(ram.data(), ram.size()),
+                                  BoundedMemory::ReadOnly(rom.data(), rom.size()), script, "session.lua");
+        }
+
+        size_t CountEvents(const char* needle) const {
+            size_t n = 0;
+            for (const SpeechEvent& e : sink.events) {
+                if (e.text.find(needle) != std::string::npos) ++n;
+            }
+            return n;
+        }
+    };
+
+    const char* kTouchScript = R"(
+        speech.say("hello " .. emu.framecount())
+        while true do
+            joypad.set({Up = false})
+            joypad.setfrommnemonicstr("|10,20,100,0,..............T..|")
+            emu.frameadvance()
+        end
+    )";
+}
+
+TEST_CASE(session_refuses_unsupported_games_before_any_ram_access) {
+    Fixture f;
+    f.SetGame("IRDO", 0);   // Black 2
+    REQUIRE(f.Attach("mainmemory.write_u8(0, 1) speech.say('ran') emu.frameadvance()") == SupportedGame::None);
+    REQUIRE(!f.session.Active());
+    REQUIRE(f.session.Game() == SupportedGame::None);
+    REQUIRE_EQ(f.CountEvents("not available"), size_t(1));
+    REQUIRE_EQ(f.CountEvents("ran"), size_t(0));
+
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::L2) | Bit(retro_id::L3) | Bit(retro_id::A);
+    FilteredInput out = f.session.FrameStep(raw);
+    REQUIRE_EQ(out.joypadMask, raw.joypadMask);   // no layer for an unsupported game: the core keeps its shortcuts
+    REQUIRE(!out.touchOverride);
+    REQUIRE(!f.session.TakeTouchCommand().apply);
+    REQUIRE_EQ(unsigned(f.ram[0]), 0u);
+
+    f.SetGame("IRBO", 1);   // right game, wrong revision
+    REQUIRE(f.Attach("speech.say('ran') emu.frameadvance()") == SupportedGame::None);
+    REQUIRE_EQ(f.CountEvents("ran"), size_t(0));
+}
+
+TEST_CASE(session_runs_a_supported_game_and_restart_resets_everything) {
+    Fixture f;
+    f.SetGame("IRBO", 0);
+    REQUIRE(f.Attach(kTouchScript) == SupportedGame::Black);
+    REQUIRE(f.session.Active());
+    REQUIRE(f.session.Game() == SupportedGame::Black);
+    REQUIRE_EQ(f.sink.events.size(), size_t(0));   // nothing runs before the first frame
+
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::UP) | Bit(retro_id::L2) | Bit(retro_id::L3);
+    raw.pointerPressed = true;
+    FilteredInput out = f.session.FrameStep(raw);
+    REQUIRE_EQ(f.CountEvents("hello 0"), size_t(1));
+    REQUIRE_EQ(out.joypadMask, 0u);   // Up blocked by the reader, L2/L3 consumed by the layer, mnemonic released the rest
+    REQUIRE(out.touchOverride);
+    REQUIRE(out.touchDown);
+    REQUIRE(out.suppressPointer);
+    ReaderSession::TouchCommand touch = f.session.TakeTouchCommand();
+    REQUIRE(touch.apply);
+    REQUIRE(touch.down);
+    REQUIRE_EQ(unsigned(touch.x), 10u);
+    REQUIRE_EQ(unsigned(touch.y), 20u);
+    REQUIRE(!f.session.TakeTouchCommand().apply);   // consumed
+    REQUIRE_EQ(f.session.FrameCount(), uint64_t(1));
+
+    f.session.Restart("reset");
+    REQUIRE(f.session.Active());
+    REQUIRE_EQ(f.session.FrameCount(), uint64_t(0));
+    touch = f.session.TakeTouchCommand();   // the finger that was down must be lifted before the reader runs again
+    REQUIRE(touch.apply);
+    REQUIRE(!touch.down);
+
+    out = f.session.FrameStep(raw);
+    REQUIRE_EQ(f.CountEvents("hello 0"), size_t(2));   // startup line spoken again, framecount restarted
+    REQUIRE(out.touchDown);
+}
+
+TEST_CASE(session_failure_releases_touch_and_overrides_but_keeps_the_layer) {
+    Fixture f;
+    f.SetGame("IRAO", 0);
+    const char* script = R"(
+        joypad.set({A = false})
+        joypad.setfrommnemonicstr("|10,20,100,0,..............T..|")
+        emu.frameadvance()
+        error("dead")
+    )";
+    REQUIRE(f.Attach(script) == SupportedGame::White);
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::A) | Bit(retro_id::L2);
+    FilteredInput out = f.session.FrameStep(raw);
+    REQUIRE(out.touchDown);
+    REQUIRE(f.session.TakeTouchCommand().down);
+
+    out = f.session.FrameStep(raw);
+    REQUIRE(!f.session.Active());
+    REQUIRE(f.session.Status() == LuaReader::Status::Failed);
+    REQUIRE_CONTAINS(f.session.LastError(), "dead");
+    REQUIRE_EQ(out.joypadMask, Bit(retro_id::A));   // override gone; L2 still consumed (layer stays configured)
+    REQUIRE(!out.touchOverride);
+    ReaderSession::TouchCommand touch = f.session.TakeTouchCommand();
+    REQUIRE(touch.apply);
+    REQUIRE(!touch.down);
+    REQUIRE_EQ(f.CountEvents("Accessibility reader stopped"), size_t(1));
+
+    out = f.session.FrameStep(raw);   // stays dead, no new commands
+    REQUIRE(!f.session.TakeTouchCommand().apply);
+    REQUIRE_EQ(f.CountEvents("Accessibility reader stopped"), size_t(1));
+}
+
+TEST_CASE(session_detach_releases_touch_and_stops_consuming_modifiers) {
+    Fixture f;
+    f.SetGame("IRBO", 0);
+    REQUIRE(f.Attach(kTouchScript) == SupportedGame::Black);
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::L2);
+    f.session.FrameStep(raw);
+    REQUIRE(f.session.TakeTouchCommand().down);
+
+    f.session.Detach();
+    REQUIRE(!f.session.Active());
+    REQUIRE(f.session.Game() == SupportedGame::None);
+    ReaderSession::TouchCommand touch = f.session.TakeTouchCommand();
+    REQUIRE(touch.apply);
+    REQUIRE(!touch.down);
+
+    FilteredInput out = f.session.FrameStep(raw);
+    REQUIRE_EQ(out.joypadMask, raw.joypadMask);   // nothing attached: pass-through
+    REQUIRE(!f.session.TakeTouchCommand().apply);
+}
+
+TEST_CASE(session_config_can_disable_the_reader_and_the_layer) {
+    Fixture f;
+    f.SetGame("IRBO", 0);
+    SessionConfig cfg;
+    cfg.readerEnabled = false;
+    f.session.SetConfig(cfg);
+    REQUIRE(f.Attach(kTouchScript) == SupportedGame::Black);
+    REQUIRE(!f.session.Active());
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::L2) | Bit(retro_id::A);
+    REQUIRE_EQ(f.session.FrameStep(raw).joypadMask, raw.joypadMask);
+    REQUIRE_EQ(f.sink.events.size(), size_t(0));
+
+    cfg.readerEnabled = true;
+    cfg.layer.layerEnabled = false;
+    f.session.SetConfig(cfg);
+    REQUIRE(f.Attach("while true do emu.frameadvance() end") == SupportedGame::Black);
+    REQUIRE(f.session.Active());
+    REQUIRE_EQ(f.session.FrameStep(raw).joypadMask, raw.joypadMask);   // layer off: L2 reaches the core
+
+    cfg.layer.layerEnabled = true;
+    cfg.layer.consumeL3 = false;
+    f.session.SetConfig(cfg);
+    raw.joypadMask = Bit(retro_id::L2) | Bit(retro_id::L3) | Bit(retro_id::A);
+    REQUIRE_EQ(f.session.FrameStep(raw).joypadMask, Bit(retro_id::L3) | Bit(retro_id::A));
+}
+
+TEST_CASE(session_compile_failure_is_reported_and_leaves_no_reader) {
+    Fixture f;
+    f.SetGame("IRBO", 0);
+    REQUIRE(f.Attach("this is not lua") == SupportedGame::Black);
+    REQUIRE(!f.session.Active());
+    REQUIRE(f.session.Status() == LuaReader::Status::Failed);
+    REQUIRE_EQ(f.CountEvents("Accessibility reader stopped"), size_t(1));
+}
diff --git a/test/accessibility/test_lua_frames.cpp b/test/accessibility/test_lua_frames.cpp
new file mode 100644
index 0000000..71ed4fe
--- /dev/null
+++ b/test/accessibility/test_lua_frames.cpp
@@ -0,0 +1,248 @@
+// Coroutine timing: exactly one resume per frame, and every way a reader can die is reported.
+#include "harness.hpp"
+
+#include <vector>
+
+#include "accessibility/bounded_memory.hpp"
+#include "accessibility/lua_reader.hpp"
+#include "accessibility/speech.hpp"
+
+using namespace MelonDsDs::access;
+
+namespace {
+    struct Fixture {
+        std::vector<uint8_t> ram = std::vector<uint8_t>(0x1000, 0);
+        std::vector<uint8_t> rom = std::vector<uint8_t>(0x200, 0);
+        BoundedMemory ramView {ram.data(), ram.size()};
+        BoundedMemory romView = BoundedMemory::ReadOnly(rom.data(), rom.size());
+        RecordingSpeechSink sink;
+        std::vector<std::string> logs;
+        SpeechDispatcher speech {&sink, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }};
+        LuaReader reader {ReaderHost {&ramView, &romView, &speech, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }}};
+    };
+}
+
+TEST_CASE(step_frame_resumes_exactly_once_and_framecount_is_visible) {
+    Fixture f;
+    const char* script = R"(
+        local n = 0
+        while true do
+            n = n + 1
+            speech.say("frame " .. n .. " fc " .. emu.framecount(), false)
+            emu.frameadvance()
+        end
+    )";
+    REQUIRE(f.reader.Load(script, "frames.lua"));
+    REQUIRE_EQ(f.sink.events.size(), size_t(0));   // nothing runs before the first frame
+    REQUIRE_EQ(f.reader.FrameCount(), uint64_t(0));
+
+    REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Running);
+    REQUIRE_EQ(f.sink.events.size(), size_t(1));
+    REQUIRE_EQ(f.sink.events[0].text, std::string("frame 1 fc 0"));
+    REQUIRE_EQ(f.reader.FrameCount(), uint64_t(1));
+
+    REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Running);
+    REQUIRE_EQ(f.sink.events.size(), size_t(2));
+    REQUIRE_EQ(f.sink.events[1].text, std::string("frame 2 fc 1"));
+    REQUIRE_EQ(f.reader.FrameCount(), uint64_t(2));
+
+    for (int i = 0; i < 100; ++i) REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Running);
+    REQUIRE_EQ(f.sink.events.size(), size_t(102));
+    REQUIRE_EQ(f.reader.FrameCount(), uint64_t(102));
+}
+
+TEST_CASE(runtime_error_stops_the_reader_and_is_spoken_and_logged) {
+    Fixture f;
+    const char* script = R"(
+        speech.say("start")
+        joypad.set({Up = false})
+        emu.frameadvance()
+        local t = nil
+        return t.boom
+    )";
+    REQUIRE(f.reader.Load(script, "crash.lua"));
+    REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Running);
+    REQUIRE_EQ(f.sink.events.size(), size_t(1));
+    REQUIRE(f.reader.Overrides().buttons[size_t(DsButton::Up)] == 0);
+
+    REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Failed);
+    REQUIRE_CONTAINS(f.reader.LastError(), "crash.lua");
+    REQUIRE_CONTAINS(f.reader.LastError(), "attempt to index");
+    REQUIRE_CONTAINS(f.reader.LastError(), "stack traceback");
+    REQUIRE(!f.reader.Overrides().Any());   // nothing stays blocked after a crash
+
+    REQUIRE_EQ(f.sink.events.size(), size_t(2));
+    REQUIRE(f.sink.events[1].interrupt);
+    REQUIRE_CONTAINS(f.sink.events[1].text, "Accessibility reader stopped");
+    REQUIRE_CONTAINS(f.sink.events[1].text, "attempt to index");
+
+    bool logged = false;
+    for (const std::string& line : f.logs) {
+        if (line.find("reader stopped") != std::string::npos && line.find("stack traceback") != std::string::npos) logged = true;
+    }
