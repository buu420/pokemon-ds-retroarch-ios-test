+// ------------------------------------------------------------------------------------------ mainmemory
+
+int LuaReader::L_mm_read_u8(lua_State* L) {
+    LuaReader& self = Self(L);
+    uint64_t off = 0;
+    uint8_t v = 0;
+    BoundedMemory* mem = self._host.mainRam;
+    if (!ArgToU64(L, 1, off) || !mem || !mem->ReadU8(off, v)) {
+        self.NoteViolation("mainmemory.read_u8", off, 1, mem);
+        v = 0;
+    }
+    lua_pushinteger(L, v);
+    return 1;
+}
+
+int LuaReader::L_mm_read_u16(lua_State* L) {
+    LuaReader& self = Self(L);
+    uint64_t off = 0;
+    uint16_t v = 0;
+    BoundedMemory* mem = self._host.mainRam;
+    if (!ArgToU64(L, 1, off) || !mem || !mem->ReadU16LE(off, v)) {
+        self.NoteViolation("mainmemory.read_u16_le", off, 2, mem);
+        v = 0;
+    }
+    lua_pushinteger(L, v);
+    return 1;
+}
+
+int LuaReader::L_mm_read_u32(lua_State* L) {
+    LuaReader& self = Self(L);
+    uint64_t off = 0;
+    uint32_t v = 0;
+    BoundedMemory* mem = self._host.mainRam;
+    if (!ArgToU64(L, 1, off) || !mem || !mem->ReadU32LE(off, v)) {
+        self.NoteViolation("mainmemory.read_u32_le", off, 4, mem);
+        v = 0;
+    }
+    lua_pushinteger(L, lua_Integer(v));
+    return 1;
+}
+
+int LuaReader::L_mm_write_u8(lua_State* L) {
+    LuaReader& self = Self(L);
+    uint64_t off = 0;
+    int isnum = 0;
+    lua_Integer value = lua_tointegerx(L, 2, &isnum);
+    BoundedMemory* mem = self._host.mainRam;
+    if (!ArgToU64(L, 1, off) || !isnum || !mem || !mem->WriteU8(off, uint8_t(value & 0xFF))) {
+        self.NoteViolation("mainmemory.write_u8", off, 1, mem);
+        return 0;
+    }
+    ++self._writes;
+    return 0;
+}
+
+int LuaReader::L_mm_read_bytes(lua_State* L) {
+    LuaReader& self = Self(L);
+    uint64_t off = 0, len = 0;
+    BoundedMemory* mem = self._host.mainRam;
+    if (!ArgToU64(L, 1, off) || !ArgToU64(L, 2, len)) {
+        self.NoteViolation("mainmemory.read_bytes_as_array", off, len, mem);
+        lua_newtable(L);
+        return 1;
+    }
+    if (len == 0) {
+        lua_newtable(L);
+        return 1;
+    }
+    if (len > kMaxBytesArray || !mem || !mem->InRange(off, len)) {
+        self.NoteViolation("mainmemory.read_bytes_as_array", off, len, mem);
+        lua_newtable(L);
+        return 1;
+    }
+    try {
+        self._scratch.resize(size_t(len));
+    }
+    catch (...) {
+        self.NoteViolation("mainmemory.read_bytes_as_array(alloc)", off, len, mem);
+        lua_newtable(L);
+        return 1;
+    }
+    mem->ReadBytes(off, size_t(len), self._scratch.data());
+    lua_createtable(L, int(len), 0);
+    for (size_t i = 0; i < size_t(len); ++i) {
+        lua_pushinteger(L, self._scratch[i]);
+        lua_rawseti(L, -2, lua_Integer(i) + 1);
+    }
+    return 1;
+}
+
+// ---------------------------------------------------------------------------------------------- memory
+
+int LuaReader::L_mem_getmemorydomainlist(lua_State* L) {
+    LuaReader& self = Self(L);
+    lua_createtable(L, 2, 0);
+    lua_Integer index = 0; // BizHawk's domain list is zero-indexed.
+    if (self._host.mainRam && self._host.mainRam->Valid()) {
+        lua_pushliteral(L, "Main RAM");
+        lua_rawseti(L, -2, index++);
+    }
+    if (self._host.rom && self._host.rom->Valid()) {
+        lua_pushliteral(L, "ROM");
+        lua_rawseti(L, -2, index);
+    }
+    return 1;
+}
+
+int LuaReader::L_mem_getmemorydomainsize(lua_State* L) {
+    LuaReader& self = Self(L);
+    const BoundedMemory* domain = nullptr;
+    if (lua_isnoneornil(L, 1)) {
+        domain = self._host.mainRam;
+    }
+    else if (lua_type(L, 1) == LUA_TSTRING) {
+        size_t length = 0;
+        const char* text = lua_tolstring(L, 1, &length);
+        std::string_view name(text, length);
+        if (name.empty() || EqualsIgnoreCase(name, "Main RAM")) domain = self._host.mainRam;
+        else if (EqualsIgnoreCase(name, "ROM")) domain = self._host.rom;
+    }
+    // Do not use DomainFor's legacy RAM fallback: an unknown cartridge domain must
+    // never appear available to a reader validating ROM filesystem offsets.
+    lua_pushinteger(L, domain && domain->Valid() ? lua_Integer(domain->Size()) : 0);
+    return 1;
+}
+
+int LuaReader::L_mem_read_u8(lua_State* L) {
+    LuaReader& self = Self(L);
+    uint64_t off = 0;
+    uint8_t v = 0;
+    BoundedMemory* mem = self.DomainFor(L, 2);
+    if (!ArgToU64(L, 1, off) || !mem || !mem->ReadU8(off, v)) {
+        self.NoteViolation("memory.read_u8", off, 1, mem);
+        v = 0;
+    }
+    lua_pushinteger(L, v);
+    return 1;
+}
