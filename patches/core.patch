@@ -0,0 +1,108 @@
+/*
+    melonDS DS Access: the policy half of RetroArch's native speech extension.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#include "native_speech.hpp"
+
+using namespace MelonDsDs::access;
+using namespace MelonDsDs::access::native_speech;
+
+std::string NativeSpeechCaps::Describe() const {
+    try {
+        if (!present) return "legacy frontend (no speech capability query; interrupt only, no stop)";
+        std::string text = backend.empty() ? std::string("unknown") : backend;
+        text += " [";
+        bool first = true;
+        auto add = [&](bool on, const char* name) {
+            if (!on) return;
+            if (!first) text += ' ';
+            text += name;
+            first = false;
+        };
+        add(CanSpeak(), "speak");
+        add(CanInterrupt(), "interrupt");
+        add(CanQueue(), "queue");
+        add(CanStop(), "stop");
+        if (first) text += "nothing available";
+        text += "]";
+        return text;
+    }
+    catch (...) {
+        return std::string("(out of memory describing capabilities)");
+    }
+}
+
+NativeSpeechPlan MelonDsDs::access::PlanNativeSay(const NativeSpeechCaps& caps, bool interrupt) noexcept {
+    NativeSpeechPlan plan;
+
+    if (!caps.present) {
+        // An old frontend. Ask for nothing beyond what it has always done, and do not trust its answer:
+        // accessibility_speak_priority returns true even when the narrator is switched off.
+        plan.send = true;
+        plan.flags = 0;
+        plan.resultIsHonest = false;
+        plan.degraded = !interrupt;   // a queued line will interrupt; the dispatcher logs that
+        return plan;
+    }
+
+    if (!caps.CanSpeak()) {
+        // The extension is there and told us there is nothing to speak through, which is what the user
+        // switching the narrator off looks like. Saying so beats reporting a success nobody heard.
+        plan.send = false;
+        plan.refusal = "the frontend reports no speech backend is available";
+        return plan;
+    }
+
+    if (interrupt) {
+        if (caps.CanInterrupt()) {
+            plan.flags = kFlagInterrupt;
+            plan.resultIsHonest = true;
+        }
+        else {
+            // Speaking is all it offers, and legacy speech already interrupts, so this is not a downgrade.
+            plan.flags = 0;
+        }
+    }
+    else {
+        if (caps.CanQueue()) {
+            plan.flags = kFlagQueue;
+            plan.resultIsHonest = true;
+        }
+        else if (caps.CanInterrupt()) {
+            // Honest about what happens: the line is still spoken, but it cuts the one before it.
+            plan.flags = kFlagInterrupt;
+            plan.resultIsHonest = true;
+            plan.degraded = true;
+        }
+        else {
+            plan.flags = 0;
+            plan.degraded = true;
+        }
+    }
+
+    plan.send = true;
+    return plan;
+}
+
+NativeSpeechPlan MelonDsDs::access::PlanNativeStop(const NativeSpeechCaps& caps) noexcept {
+    NativeSpeechPlan plan;
+
+    if (!caps.present) {
+        plan.send = false;
+        plan.refusal = "this frontend has no stop request";
+        return plan;
+    }
+    if (!caps.CanStop()) {
+        plan.send = false;
+        plan.refusal = caps.CanSpeak()
+            ? "the frontend's speech backend cannot stop speech"
+            : "the frontend reports no speech backend is available";
+        return plan;
+    }
+
+    plan.send = true;
+    plan.flags = kFlagStop;
+    plan.resultIsHonest = true;
+    return plan;
+}
diff --git a/src/libretro/accessibility/native_speech.hpp b/src/libretro/accessibility/native_speech.hpp
new file mode 100644
index 0000000..7ad9434
--- /dev/null
+++ b/src/libretro/accessibility/native_speech.hpp
@@ -0,0 +1,72 @@
+/*
+    melonDS DS Access: the policy half of RetroArch's native speech extension.
+
+    This header deliberately contains no libretro and no melonDS. It is the part that decides WHAT to ask
+    the frontend for, so the decisions can be regression-tested without a frontend; frontend_speech.cpp is
+    the thin part that actually makes the environment calls.
+
+    Contract: C:\RetroArch-Win64\dev\pokemon-ds-accessibility\native-speech-contract.md
+
+      RETRO_ENVIRONMENT_GET_ACCESSIBILITY_SPEECH_INTERFACE (83 | EXPERIMENTAL) reports what the frontend's
+      CURRENT speech backend can really do. A frontend without the extension answers false, so an old
+      frontend can never be mistaken for one that queues or stops. Only a capability that was reported may
+      be requested through retro_accessibility_speech::flags.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace MelonDsDs::access {
+    /// Mirrors the libretro values; frontend_speech.cpp static_asserts them against the real header so the
+    /// two can never drift apart.
+    namespace native_speech {
+        inline constexpr unsigned kFlagInterrupt = 1u << 0;
+        inline constexpr unsigned kFlagQueue     = 1u << 1;
+        inline constexpr unsigned kFlagStop      = 1u << 2;
+
+        inline constexpr uint64_t kCapSpeak     = 1ull << 0;
+        inline constexpr uint64_t kCapInterrupt = 1ull << 1;
+        inline constexpr uint64_t kCapQueue     = 1ull << 2;
+        inline constexpr uint64_t kCapStop      = 1ull << 3;
+    }
+
+    /// What the frontend told us it can do right now.
+    struct NativeSpeechCaps {
+        /// The frontend answered the capability query at all. False means an old frontend, and the core
+        /// must then behave exactly as it always has: flags 0, no stop.
+        bool present = false;
+        uint64_t bits = 0;
+        std::string backend;   // "nvda", "sapi", "powershell", "disabled", ...
+
+        [[nodiscard]] bool CanSpeak() const noexcept { return present && (bits & native_speech::kCapSpeak); }
+        [[nodiscard]] bool CanInterrupt() const noexcept { return present && (bits & native_speech::kCapInterrupt); }
+        [[nodiscard]] bool CanQueue() const noexcept { return present && (bits & native_speech::kCapQueue); }
+        [[nodiscard]] bool CanStop() const noexcept { return present && (bits & native_speech::kCapStop); }
+
+        [[nodiscard]] std::string Describe() const;
+    };
+
+    /// The decision for one request.
+    struct NativeSpeechPlan {
+        /// False means do not call the frontend at all; the caller reports failure.
+        bool send = false;
+        /// Value for retro_accessibility_speech::flags. Zero is the legacy request.
+        unsigned flags = 0;
+        /// True when the frontend's return value is trustworthy (it is, for any non-zero flags).
+        bool resultIsHonest = false;
+        /// True when the request had to be downgraded, e.g. a queued line on a backend that cannot queue.
+        bool degraded = false;
+        /// Set when send is false, for the log.
+        const char* refusal = nullptr;
+    };
+
+    /// Plan a speech.say(text, interrupt) request.
+    NativeSpeechPlan PlanNativeSay(const NativeSpeechCaps& caps, bool interrupt) noexcept;
+
+    /// Plan a speech.stop() request.
+    NativeSpeechPlan PlanNativeStop(const NativeSpeechCaps& caps) noexcept;
+}
diff --git a/src/libretro/accessibility/prism_speech.cpp b/src/libretro/accessibility/prism_speech.cpp
new file mode 100644
index 0000000..f63d8dc
--- /dev/null
+++ b/src/libretro/accessibility/prism_speech.cpp
@@ -0,0 +1,240 @@
+/*
+    melonDS DS Access: speech through the pinned prism.dll.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#ifdef _WIN32
+
+#include "prism_speech.hpp"
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+#include <algorithm>
+#include <vector>
+
+#include "sha256.hpp"
+
+using namespace MelonDsDs::access;
+
+namespace {
+    std::wstring Utf8ToWide(const std::string& s) {
+        if (s.empty()) return std::wstring();
+        int n = MultiByteToWideChar(CP_UTF8, 0, s.data(), int(s.size()), nullptr, 0);
+        std::wstring w(size_t(n > 0 ? n : 0), L'\0');
+        if (n > 0) MultiByteToWideChar(CP_UTF8, 0, s.data(), int(s.size()), w.data(), n);
+        return w;
+    }
+
+    std::string LastErrorText() {
+        DWORD code = GetLastError();
+        char buf[256];
+        DWORD n = FormatMessageA(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, nullptr, code,
+                                 MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT), buf, sizeof(buf), nullptr);
+        std::string text = n ? std::string(buf, n) : std::string();
+        while (!text.empty() && (text.back() == '\n' || text.back() == '\r' || text.back() == ' ')) text.pop_back();
+        return "error " + std::to_string(code) + (text.empty() ? "" : ": " + text);
+    }
+
+    template<typename Fn>
+    bool Resolve(HMODULE module, const char* symbol, Fn& out, std::string& missing) {
+        FARPROC proc = GetProcAddress(module, symbol);
+        if (!proc) {
+            if (!missing.empty()) missing += ", ";
+            missing += symbol;
+            return false;
+        }
+        out = reinterpret_cast<Fn>(reinterpret_cast<void*>(proc));
+        return true;
+    }
+}
+
+PrismSpeech::PrismSpeech(LogFn log) noexcept : _log(std::move(log)) {}
+
+PrismSpeech::~PrismSpeech() {
+    Unload();
+}
+
+void PrismSpeech::Log(LogLevel level, std::string_view message) const noexcept {
+    if (!_log) return;
+    try {
+        _log(level, message);
+    }
+    catch (...) {
+    }
+}
+
+std::string PrismSpeech::ErrorText(int code) const noexcept {
+    std::string text = "prism error " + std::to_string(code);
+    if (_errorString) {
+        const char* s = _errorString(code);
+        if (s && *s) {
+            text += " (";
+            text += s;
+            text += ")";
+        }
+    }
+    return text;
+}
+
+std::string PrismSpeech::HashFile(const std::string& pathUtf8, std::string& error) noexcept {
+    std::wstring wpath = Utf8ToWide(pathUtf8);
+    HANDLE file = CreateFileW(wpath.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING,
+                              FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE) {
+        error = "cannot open " + pathUtf8 + ": " + LastErrorText();
+        return std::string();
+    }
+    LARGE_INTEGER size {};
+    if (!GetFileSizeEx(file, &size) || size.QuadPart <= 0 || size.QuadPart > (64ll << 20)) {
+        error = "unexpected file size for " + pathUtf8;
+        CloseHandle(file);
+        return std::string();
+    }
+    std::vector<unsigned char> bytes;
+    try {
+        bytes.resize(size_t(size.QuadPart));
+    }
+    catch (...) {
+        error = "out of memory reading " + pathUtf8;
+        CloseHandle(file);
+        return std::string();
+    }
+    size_t total = 0;
+    while (total < bytes.size()) {
+        DWORD chunk = 0;
+        DWORD want = DWORD(std::min<size_t>(bytes.size() - total, 1u << 20));
+        if (!ReadFile(file, bytes.data() + total, want, &chunk, nullptr) || chunk == 0) {
+            error = "read failure on " + pathUtf8 + ": " + LastErrorText();
+            CloseHandle(file);
+            return std::string();
+        }
+        total += chunk;
+    }
+    CloseHandle(file);
+    return Sha256Hex(bytes.data(), bytes.size());
+}
+
+bool PrismSpeech::Load(const std::string& dllPathUtf8, std::string& error) noexcept {
+    Unload();
+
+    _sha256 = HashFile(dllPathUtf8, error);
+    if (_sha256.empty()) {
+        return false;
+    }
+    if (_sha256 != kPinnedSha256) {
+        error = "prism.dll hash mismatch at " + dllPathUtf8 + ": got " + _sha256 + ", expected " + kPinnedSha256
+              + " (the reader is pinned to the original package's DLL and its configuration ABI)";
+        return false;
+    }
+
+    std::wstring wpath = Utf8ToWide(dllPathUtf8);
+    HMODULE module = LoadLibraryExW(wpath.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+    if (!module) {
+        error = "LoadLibrary failed for " + dllPathUtf8 + ": " + LastErrorText();
+        return false;
+    }
+    _module = module;
+
+    std::string missing;
+    Resolve(module, "prism_init", _init, missing);
+    Resolve(module, "prism_shutdown", _shutdown, missing);
+    Resolve(module, "prism_registry_acquire_best", _acquireBest, missing);
+    Resolve(module, "prism_backend_free", _backendFree, missing);
+    Resolve(module, "prism_backend_initialize", _backendInit, missing);
+    Resolve(module, "prism_backend_name", _backendName_, missing);
+    Resolve(module, "prism_backend_speak", _speak, missing);
+    Resolve(module, "prism_backend_stop", _stop, missing);
+    std::string optionalMissing;
+    Resolve(module, "prism_error_string", _errorString, optionalMissing);
+    if (!missing.empty()) {
+        error = "prism.dll is missing required exports: " + missing;
+        Unload();
+        return false;
+    }
+
+    ConfigV2 config {kConfigVersion};
+    _ctx = _init(&config);
+    if (!_ctx) {
+        error = "prism_init returned null (config version " + std::to_string(kConfigVersion) + ")";
+        Unload();
+        return false;
+    }
+
+    _backend = _acquireBest(_ctx);
+    if (!_backend) {
+        error = "prism_registry_acquire_best returned no backend: no screen reader or speech engine is available";
+        Unload();
+        return false;
+    }
+
+    int rc = _backendInit(_backend);
+    if (rc != kPrismOk && rc != kPrismAlreadyInitialized) {
+        error = "prism_backend_initialize failed: " + ErrorText(rc);
+        Unload();
+        return false;
+    }
+
+    const char* name = _backendName_(_backend);
+    _backendName = (name && *name) ? name : "unknown";
+    _name = "prism:" + _backendName;
+    Log(LogLevel::Info, "prism loaded from " + dllPathUtf8 + " sha256=" + _sha256 + " backend=" + _backendName);
+    return true;
+}
+
+void PrismSpeech::Unload() noexcept {
+    if (_backend && _backendFree) {
+        _backendFree(_backend);
+    }
+    _backend = nullptr;
+    if (_ctx && _shutdown) {
+        _shutdown(_ctx);
+    }
+    _ctx = nullptr;
+    if (_module) {
+        FreeLibrary(static_cast<HMODULE>(_module));
+        _module = nullptr;
+    }
+    _init = nullptr;
+    _shutdown = nullptr;
+    _acquireBest = nullptr;
+    _backendFree = nullptr;
+    _backendInit = nullptr;
+    _backendName_ = nullptr;
+    _speak = nullptr;
+    _stop = nullptr;
+    _errorString = nullptr;
+    _name = "prism:unloaded";
+    _backendName.clear();
+}
+
+bool PrismSpeech::Say(std::string_view utf8, bool interrupt) noexcept {
+    if (!_backend || !_speak) return false;
+    std::string text;
+    try {
+        text.assign(utf8.data(), utf8.size());
+    }
+    catch (...) {
+        return false;
+    }
+    int rc = _speak(_backend, text.c_str(), interrupt);
+    if (rc != kPrismOk) {
+        Log(LogLevel::Error, "prism_backend_speak failed: " + ErrorText(rc));
+        return false;
+    }
+    return true;
+}
+
+bool PrismSpeech::Stop() noexcept {
+    if (!_backend || !_stop) return false;
+    int rc = _stop(_backend);
+    if (rc != kPrismOk) {
+        Log(LogLevel::Error, "prism_backend_stop failed: " + ErrorText(rc));
+        return false;
+    }
+    return true;
+}
+
+#endif // _WIN32
diff --git a/src/libretro/accessibility/prism_speech.hpp b/src/libretro/accessibility/prism_speech.hpp
new file mode 100644
index 0000000..c00a442
--- /dev/null
+++ b/src/libretro/accessibility/prism_speech.hpp
@@ -0,0 +1,90 @@
+/*
+    melonDS DS Access: speech through the exact prism.dll shipped with the original BizHawk package.
+
+    The DLL is pinned by SHA-256. Its configuration ABI is Prism's version 2 (v0.16 line), where
+    PrismConfig is a single version byte; newer headers are NOT a substitute (version 3 grew the struct).
+    The call sequence mirrors the decompiled BizHawk wrapper: prism_init -> prism_registry_acquire_best ->
+    prism_backend_initialize (OK or ALREADY_INITIALIZED) -> prism_backend_speak(text, interrupt) /
+    prism_backend_stop. Ownership: the acquired backend handle is released with prism_backend_free and the
+    context with prism_shutdown before the library is unloaded.
+
+    This object is not thread-safe and must be used from the emulation thread only.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#ifdef _WIN32
+
+#include <string>
+#include <string_view>
+
+#include "speech.hpp"
+
+namespace MelonDsDs::access {
+    class PrismSpeech final : public SpeechSink {
+    public:
+        static constexpr const char* kPinnedSha256 = "25e90d2e3a1aba6d54072ba4079eac209bf752f2a6e267be446b584416efb648";
+        static constexpr unsigned char kConfigVersion = 2;
+        static constexpr int kPrismOk = 0;
+        static constexpr int kPrismAlreadyInitialized = 15;
+
+        explicit PrismSpeech(LogFn log) noexcept;
+        ~PrismSpeech() override;
+        PrismSpeech(const PrismSpeech&) = delete;
+        PrismSpeech& operator=(const PrismSpeech&) = delete;
+
+        /// Verifies the hash, loads the DLL and initialises the best available backend.
+        /// On failure `error` describes the cause and the object stays unusable.
+        bool Load(const std::string& dllPathUtf8, std::string& error) noexcept;
+        void Unload() noexcept;
+
+        bool Say(std::string_view utf8, bool interrupt) noexcept override;
+        bool Stop() noexcept override;
+        [[nodiscard]] const char* Name() const noexcept override { return _name.c_str(); }
+
+        [[nodiscard]] bool Ready() const noexcept { return _backend != nullptr; }
+        [[nodiscard]] const std::string& BackendName() const noexcept { return _backendName; }
+        [[nodiscard]] const std::string& FileSha256() const noexcept { return _sha256; }
+
+        /// Computes the SHA-256 of a file; empty on read failure.
+        static std::string HashFile(const std::string& pathUtf8, std::string& error) noexcept;
+
+    private:
+        struct Context;
+        struct Backend;
+        struct ConfigV2 { unsigned char version; };
+
+        using InitFn = Context* (*)(ConfigV2*);
+        using ShutdownFn = void (*)(Context*);
+        using AcquireBestFn = Backend* (*)(Context*);
+        using BackendFreeFn = void (*)(Backend*);
+        using BackendInitFn = int (*)(Backend*);
+        using BackendNameFn = const char* (*)(Backend*);
+        using BackendSpeakFn = int (*)(Backend*, const char*, bool);
+        using BackendStopFn = int (*)(Backend*);
+        using ErrorStringFn = const char* (*)(int);
+
+        std::string ErrorText(int code) const noexcept;
+        void Log(LogLevel level, std::string_view message) const noexcept;
+
+        LogFn _log;
+        void* _module = nullptr;
+        Context* _ctx = nullptr;
+        Backend* _backend = nullptr;
+        InitFn _init = nullptr;
+        ShutdownFn _shutdown = nullptr;
+        AcquireBestFn _acquireBest = nullptr;
+        BackendFreeFn _backendFree = nullptr;
+        BackendInitFn _backendInit = nullptr;
+        BackendNameFn _backendName_ = nullptr;
+        BackendSpeakFn _speak = nullptr;
+        BackendStopFn _stop = nullptr;
+        ErrorStringFn _errorString = nullptr;
+        std::string _name = "prism:unloaded";
+        std::string _backendName;
+        std::string _sha256;
+    };
+}
+
+#endif // _WIN32
diff --git a/src/libretro/accessibility/reader_locator.cpp b/src/libretro/accessibility/reader_locator.cpp
new file mode 100644
index 0000000..fd09cfe
--- /dev/null
+++ b/src/libretro/accessibility/reader_locator.cpp
@@ -0,0 +1,187 @@
+/*
+    melonDS DS Access: where the reader script and prism.dll live.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#include "reader_locator.hpp"
+
+#include <cstdio>
+#include <cstring>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#include <sys/stat.h>
+#endif
+
+#include "embedded/melondsds_access_reader.h"
+#include "environment.hpp"
+#include "sha256.hpp"
+
+using namespace MelonDsDs::access;
+
+namespace {
+#ifdef _WIN32
+    std::wstring Utf8ToWide(const std::string& s) {
+        if (s.empty()) return std::wstring();
+        int n = MultiByteToWideChar(CP_UTF8, 0, s.data(), int(s.size()), nullptr, 0);
+        std::wstring w(size_t(n > 0 ? n : 0), L'\0');
+        if (n > 0) MultiByteToWideChar(CP_UTF8, 0, s.data(), int(s.size()), w.data(), n);
+        return w;
+    }
+
+    std::string WideToUtf8(const wchar_t* s, size_t len) {
+        if (!s || len == 0) return std::string();
+        int n = WideCharToMultiByte(CP_UTF8, 0, s, int(len), nullptr, 0, nullptr, nullptr);
+        std::string out(size_t(n > 0 ? n : 0), '\0');
+        if (n > 0) WideCharToMultiByte(CP_UTF8, 0, s, int(len), out.data(), n, nullptr, nullptr);
+        return out;
+    }
+
+    bool FileExists(const std::string& pathUtf8) noexcept {
+        DWORD attrs = GetFileAttributesW(Utf8ToWide(pathUtf8).c_str());
+        return attrs != INVALID_FILE_ATTRIBUTES && !(attrs & FILE_ATTRIBUTE_DIRECTORY);
+    }
+#else
+    bool FileExists(const std::string& path) noexcept {
+        struct stat st {};
+        return stat(path.c_str(), &st) == 0 && S_ISREG(st.st_mode);
+    }
+#endif
+
+    /// Directory of the shared library this function is compiled into, without a trailing separator.
+    std::optional<std::string> ModuleDirectory() noexcept {
+#ifdef _WIN32
+        HMODULE module = nullptr;
+        if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                reinterpret_cast<LPCWSTR>(&ModuleDirectory), &module) || !module) {
+            return std::nullopt;
+        }
+        wchar_t buffer[MAX_PATH * 2];
+        DWORD len = GetModuleFileNameW(module, buffer, DWORD(sizeof(buffer) / sizeof(buffer[0])));
+        if (len == 0 || len >= sizeof(buffer) / sizeof(buffer[0])) return std::nullopt;
+        std::string path = WideToUtf8(buffer, len);
+        size_t slash = path.find_last_of("\\/");
+        if (slash == std::string::npos) return std::nullopt;
+        return path.substr(0, slash);
+#else
+        Dl_info info {};
+        if (!dladdr(reinterpret_cast<void*>(&ModuleDirectory), &info) || !info.dli_fname) return std::nullopt;
+        std::string path = info.dli_fname;
+        size_t slash = path.find_last_of('/');
+        if (slash == std::string::npos) return std::nullopt;
+        return path.substr(0, slash);
+#endif
+    }
+
+    std::string Join(std::string_view dir, std::string_view name) {
+        std::string out(dir);
+        if (!out.empty() && out.back() != '/' && out.back() != '\\') {
+#ifdef _WIN32
+            out += '\\';
+#else
+            out += '/';
+#endif
+        }
+        out.append(name);
+        return out;
+    }
+}
+
+std::vector<std::string> MelonDsDs::access::DataDirectoryCandidates() noexcept {
+    std::vector<std::string> dirs;
+    try {
+        if (std::optional<std::string> module = ModuleDirectory()) {
+            dirs.push_back(Join(*module, kDataSubdirectory));
+        }
+        if (std::optional<std::string_view> sysdir = retro::get_system_directory()) {
+            dirs.push_back(Join(*sysdir, kDataSubdirectory));
+        }
+    }
+    catch (...) {
+    }
+    return dirs;
+}
+
+std::optional<std::string> MelonDsDs::access::LocateDataFile(std::string_view fileName) noexcept {
+    try {
+        for (const std::string& dir : DataDirectoryCandidates()) {
+            std::string path = Join(dir, fileName);
+            if (FileExists(path)) return path;
+        }
+    }
+    catch (...) {
+    }
+    return std::nullopt;
+}
+
+bool MelonDsDs::access::ReadWholeFile(const std::string& pathUtf8, std::string& out, std::string& error) noexcept {
+    try {
+#ifdef _WIN32
+        FILE* f = _wfopen(Utf8ToWide(pathUtf8).c_str(), L"rb");
+#else
+        FILE* f = std::fopen(pathUtf8.c_str(), "rb");
+#endif
+        if (!f) {
+            error = "cannot open " + pathUtf8;
+            return false;
+        }
+        out.clear();
+        char buffer[1 << 16];
+        size_t n;
+        while ((n = std::fread(buffer, 1, sizeof(buffer), f)) > 0) {
+            out.append(buffer, n);
+            if (out.size() > (64u << 20)) {
+                std::fclose(f);
+                error = pathUtf8 + " is unreasonably large";
+                return false;
+            }
+        }
+        bool failed = std::ferror(f) != 0;
+        std::fclose(f);
+        if (failed) {
+            error = "read error on " + pathUtf8;
+            return false;
+        }
+        return true;
+    }
+    catch (...) {
+        error = "out of memory reading " + pathUtf8;
+        return false;
+    }
+}
+
+bool MelonDsDs::access::LoadReaderSource(ReaderSource& out, std::string& error) noexcept {
+    try {
+        if (std::optional<std::string> path = LocateDataFile(kReaderFileName)) {
+            std::string text;
+            std::string readError;
+            if (ReadWholeFile(*path, text, readError) && !text.empty()) {
+                out.text = std::move(text);
+                out.origin = *path;
+                out.sha256 = Sha256Hex(out.text.data(), out.text.size());
+                return true;
+            }
+            retro::warn("[accessibility] reader file at {} could not be read ({}); using the embedded copy", *path,
+                        readError.empty() ? "empty file" : readError);
+        }
+
+        size_t length = std::strlen(embedded_melondsds_access_reader);
+        if (length == 0) {
+            error = "the embedded reader is empty";
+            return false;
+        }
+        out.text.assign(embedded_melondsds_access_reader, length);
+        out.origin = "embedded";
+        out.sha256 = Sha256Hex(out.text.data(), out.text.size());
+        return true;
+    }
+    catch (...) {
+        error = "out of memory loading the reader";
+        return false;
+    }
+}
