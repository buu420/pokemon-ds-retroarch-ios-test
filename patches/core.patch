+
+    constexpr retro_core_option_v2_definition AccessControllerLayer {
+        config::accessibility::CONTROLLER_LAYER,
+        "Accessibility Controller Layer (L2 / R2)",
+        nullptr,
+        "Holding L2 turns the pad into the reader's navigation layer and R2 into its touch layer, "
+        "exactly as in the original BizHawk setup. While this is enabled, L2 and R2 are consumed by the "
+        "reader: the core's pointer speed-up, the L2+Y lid toggle and the R2 joystick touch are unavailable. "
