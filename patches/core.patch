diff --git a/test/accessibility/harness.hpp b/test/accessibility/harness.hpp
new file mode 100644
index 0000000..820123e
--- /dev/null
+++ b/test/accessibility/harness.hpp
@@ -0,0 +1,93 @@
+// Minimal test harness for the melonDS DS Access adapter tests (no external dependency).
+#pragma once
+
+#include <cstdio>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <type_traits>
+#include <vector>
+
+namespace testing {
+    struct Failure : std::runtime_error {
+        using std::runtime_error::runtime_error;
+    };
+
+    /// A test that could not run (a missing optional dependency). Counted separately, never as a pass.
+    struct Skipped : std::runtime_error {
+        using std::runtime_error::runtime_error;
+    };
+
+    struct Case {
+        const char* name;
+        void (*fn)();
+    };
+
+    inline std::vector<Case>& Registry() {
+        static std::vector<Case> cases;
+        return cases;
+    }
+
+    struct Registrar {
+        Registrar(const char* name, void (*fn)()) { Registry().push_back({name, fn}); }
+    };
+
+    inline std::string Where(const char* file, int line) {
+        return std::string(file) + ":" + std::to_string(line);
+    }
+
+    template<typename T>
+    std::string Show(const T& value) {
+        std::ostringstream out;
+        if constexpr (std::is_enum_v<T>) {
+            out << static_cast<long long>(value);
+        }
+        else if constexpr (std::is_same_v<T, bool>) {
+            out << (value ? "true" : "false");
+        }
+        else if constexpr (std::is_same_v<T, std::string_view>) {
+            out << '"' << std::string(value) << '"';
+        }
+        else if constexpr (std::is_same_v<T, std::string> || std::is_same_v<T, const char*>) {
+            out << '"' << value << '"';
+        }
+        else if constexpr (std::is_same_v<T, unsigned char>) {
+            out << unsigned(value);
+        }
+        else {
+            out << value;
+        }
+        return out.str();
+    }
+}
+
+#define TEST_CASE(name) \
+    static void name(); \
+    static ::testing::Registrar name##_registrar(#name, name); \
+    static void name()
+
+#define SKIP_TEST(reason)     throw ::testing::Skipped(reason)
+
+#define REQUIRE(cond) \
+    do { \
+        if (!(cond)) throw ::testing::Failure(::testing::Where(__FILE__, __LINE__) + " REQUIRE(" #cond ") failed"); \
+    } while (0)
+
+#define REQUIRE_EQ(a, b) \
+    do { \
+        const auto& _lhs = (a); \
+        const auto& _rhs = (b); \
+        if (!(_lhs == _rhs)) \
+            throw ::testing::Failure(::testing::Where(__FILE__, __LINE__) + " REQUIRE_EQ(" #a ", " #b ") failed: " \
+                                     + ::testing::Show(_lhs) + " != " + ::testing::Show(_rhs)); \
+    } while (0)
+
+#define REQUIRE_CONTAINS(haystack, needle) \
+    do { \
+        std::string _h(haystack); \
+        std::string _n(needle); \
+        if (_h.find(_n) == std::string::npos) \
+            throw ::testing::Failure(::testing::Where(__FILE__, __LINE__) + " REQUIRE_CONTAINS failed: " \
+                                     + ::testing::Show(_h) + " does not contain " + ::testing::Show(_n)); \
+    } while (0)
diff --git a/test/accessibility/test_bounded_memory.cpp b/test/accessibility/test_bounded_memory.cpp
new file mode 100644
index 0000000..799aa28
--- /dev/null
+++ b/test/accessibility/test_bounded_memory.cpp
@@ -0,0 +1,169 @@
+// Full-width RAM bounds, at the C++ boundary and through the Lua surface.
+#include "harness.hpp"
+
+#include <cstdint>
+#include <vector>
+
+#include "accessibility/bounded_memory.hpp"
+#include "accessibility/lua_reader.hpp"
+#include "accessibility/speech.hpp"
+
+using namespace MelonDsDs::access;
+
+namespace {
+    std::vector<uint8_t> Pattern(size_t n) {
+        std::vector<uint8_t> v(n);
+        for (size_t i = 0; i < n; ++i) v[i] = uint8_t(i * 7 + 3);
+        return v;
+    }
+}
+
+TEST_CASE(bounded_memory_checks_every_width_at_the_end) {
+    std::vector<uint8_t> buf = Pattern(16);
+    BoundedMemory m(buf.data(), buf.size());
+    uint8_t b = 0;
+    uint16_t h = 0;
+    uint32_t w = 0;
+
+    REQUIRE(m.ReadU8(15, b));
+    REQUIRE_EQ(unsigned(b), unsigned(buf[15]));
+    REQUIRE(!m.ReadU8(16, b));
+
+    REQUIRE(m.ReadU16LE(14, h));
+    REQUIRE_EQ(unsigned(h), unsigned(buf[14]) | (unsigned(buf[15]) << 8));
+    REQUIRE(!m.ReadU16LE(15, h));   // second byte would be out of range
+
+    REQUIRE(m.ReadU32LE(12, w));
+    REQUIRE_EQ(w, uint32_t(buf[12]) | (uint32_t(buf[13]) << 8) | (uint32_t(buf[14]) << 16) | (uint32_t(buf[15]) << 24));
+    REQUIRE(!m.ReadU32LE(13, w));
+    REQUIRE(!m.ReadU32LE(14, w));
+    REQUIRE(!m.ReadU32LE(15, w));
+    REQUIRE(!m.ReadU32LE(16, w));
+
+    uint8_t out[8] = {};
+    REQUIRE(m.ReadBytes(8, 8, out));
+    REQUIRE_EQ(unsigned(out[7]), unsigned(buf[15]));
+    REQUIRE(!m.ReadBytes(9, 8, out));   // last byte out of range: nothing copied
+    REQUIRE(!m.ReadBytes(16, 1, out));
+
+    REQUIRE(!m.InRange(UINT64_MAX, 4));
+    REQUIRE(!m.InRange(0, UINT64_MAX));
+    REQUIRE(!m.InRange(0, 0));
+    REQUIRE(m.InRange(0, 16));
+    REQUIRE(!m.InRange(0, 17));
+
+    REQUIRE(m.WriteU8(15, 0xAA));
+    REQUIRE_EQ(unsigned(buf[15]), 0xAAu);
+    REQUIRE(!m.WriteU8(16, 0x01));
+}
+
+TEST_CASE(bounded_memory_read_only_and_unbound_views) {
+    std::vector<uint8_t> buf = Pattern(8);
+    BoundedMemory ro = BoundedMemory::ReadOnly(buf.data(), buf.size());
+    uint8_t b = 0;
+    REQUIRE(ro.ReadU8(3, b));
+    REQUIRE(!ro.Writable());
+    REQUIRE(!ro.WriteU8(3, 1));
+    REQUIRE_EQ(unsigned(buf[3]), unsigned(uint8_t(3 * 7 + 3)));
+
+    BoundedMemory none;
+    uint32_t w = 0;
+    REQUIRE(!none.Valid());
+    REQUIRE(!none.ReadU8(0, b));
+    REQUIRE(!none.ReadU32LE(0, w));
+    REQUIRE(!none.WriteU8(0, 1));
+    REQUIRE(!none.InRange(0, 1));
+}
+
+namespace {
+    struct LuaFixture {
+        std::vector<uint8_t> ram;
+        std::vector<uint8_t> rom;
+        BoundedMemory ramView;
+        BoundedMemory romView;
+        RecordingSpeechSink sink;
+        std::vector<std::string> logs;
+        SpeechDispatcher speech;
+        LuaReader reader;
+
+        explicit LuaFixture(size_t ramSize)
+            : ram(Pattern(ramSize)), rom(0x200, 0),
+              ramView(ram.data(), ram.size()), romView(BoundedMemory::ReadOnly(rom.data(), rom.size())),
+              speech(&sink, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }),
+              reader(ReaderHost {&ramView, &romView, &speech,
+                                 [this](LogLevel, std::string_view m) { logs.emplace_back(m); }}) {}
+    };
+}
+
+TEST_CASE(lua_mainmemory_reads_are_width_checked_and_fail_closed) {
+    LuaFixture f(0x1000);
+    const char* script = R"(
+        local v32 = mainmemory.read_u32_le(0x0FFC)
+        local bad32 = mainmemory.read_u32_le(0x0FFD)
+        local v16 = mainmemory.read_u16_le(0x0FFE)
+        local bad16 = mainmemory.read_u16_le(0x0FFF)
+        local v8 = mainmemory.read_u8(0x0FFF)
+        local bad8 = mainmemory.read_u8(0x1000)
+        local neg = mainmemory.read_u8(-1)
+        local arr = mainmemory.read_bytes_as_array(0x0FF0, 16)
+        local badarr = mainmemory.read_bytes_as_array(0x0FF1, 16)
+        mainmemory.write_u8(0x0FFF, 0x5A)
+        mainmemory.write_u8(0x1000, 0x5A)
+        speech.say(string.format("%d %d %d %d %d %d %d %d %s %d %d", v32, bad32, v16, bad16, v8, bad8, neg,
+            #arr, tostring(arr[0]), arr[1], #badarr))
+        emu.frameadvance()
+    )";
+    const std::vector<uint8_t> before = f.ram;   // every read in the script happens before its write
+    REQUIRE(f.reader.Load(script, "bounds.lua"));
+    REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Running);
+    REQUIRE_EQ(f.sink.events.size(), size_t(1));
+
+    uint32_t v32 = uint32_t(before[0xFFC]) | (uint32_t(before[0xFFD]) << 8) | (uint32_t(before[0xFFE]) << 16) | (uint32_t(before[0xFFF]) << 24);
+    uint16_t v16 = uint16_t(uint16_t(before[0xFFE]) | (uint16_t(before[0xFFF]) << 8));
+    uint8_t v8 = before[0xFFF];
+    std::string expected = std::to_string(v32) + " 0 " + std::to_string(unsigned(v16)) + " 0 " + std::to_string(unsigned(v8))
+        + " 0 0 16 nil " + std::to_string(unsigned(before[0xFF0])) + " 0";
+    REQUIRE_EQ(f.sink.events[0].text, expected);
+    REQUIRE_EQ(unsigned(f.ram[0xFFF]), 0x5Au);
+    REQUIRE_EQ(f.reader.BoundsViolations(), uint64_t(6));   // bad32, bad16, bad8, neg, badarr, bad write
+    REQUIRE_EQ(f.reader.RamWrites(), uint64_t(1));
+}
+
+TEST_CASE(lua_memory_rom_domain_reads_header_and_never_main_ram) {
+    LuaFixture f(0x100);
+    f.rom[0x0C] = 'I'; f.rom[0x0D] = 'R'; f.rom[0x0E] = 'B'; f.rom[0x0F] = 'O'; f.rom[0x1E] = 0;
+    f.ram[0x0C] = 'X';
+    const char* script = R"(
+        local c = {}
+        for i = 0, 3 do c[i + 1] = string.char(memory.read_u8(0x0C + i, "ROM")) end
+        local code = table.concat(c)
+        local ram = string.char(memory.read_u8(0x0C))
+        local rev = memory.read_u8(0x1E, "rom")
+        local past = memory.read_u8(0x200, "ROM")
+        local u16 = memory.read_u16_le(0x0C, "ROM")
+        speech.say(code .. " " .. ram .. " " .. rev .. " " .. past .. " " .. u16)
+        emu.frameadvance()
+    )";
+    REQUIRE(f.reader.Load(script, "rom.lua"));
+    REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Running);
+    REQUIRE_EQ(f.sink.events.size(), size_t(1));
+    REQUIRE_EQ(f.sink.events[0].text, std::string("IRBO X 0 0 ") + std::to_string(unsigned('I') | (unsigned('R') << 8)));
+    REQUIRE_EQ(f.reader.BoundsViolations(), uint64_t(1));
+}
+
+TEST_CASE(lua_read_bytes_as_array_refuses_oversized_requests) {
+    LuaFixture f(0x100);
+    const char* script = R"(
+        local big = mainmemory.read_bytes_as_array(0, 1 << 21)
+        local zero = mainmemory.read_bytes_as_array(0, 0)
+        local float = mainmemory.read_u8(4.0)
+        local frac = mainmemory.read_u8(4.5)
+        speech.say(#big .. " " .. #zero .. " " .. float .. " " .. frac)
+        emu.frameadvance()
+    )";
+    REQUIRE(f.reader.Load(script, "big.lua"));
+    REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Running);
+    // 4.5 floors to 4 (the reader never passes fractions; flooring keeps it fail-safe rather than fatal).
+    REQUIRE_EQ(f.sink.events[0].text, std::string("0 0 ") + std::to_string(unsigned(f.ram[4])) + " " + std::to_string(unsigned(f.ram[4])));
+    REQUIRE_EQ(f.reader.BoundsViolations(), uint64_t(1));
+}
diff --git a/test/accessibility/test_cart_identity.cpp b/test/accessibility/test_cart_identity.cpp
new file mode 100644
index 0000000..d4fd19c
--- /dev/null
+++ b/test/accessibility/test_cart_identity.cpp
@@ -0,0 +1,53 @@
+// Exact game-code/revision pairs gate the reader's absolute memory addresses.
+#include "harness.hpp"
+
+#include <cstring>
+#include <vector>
+
+#include "accessibility/cart_identity.hpp"
+
+using namespace MelonDsDs::access;
+
+namespace {
+    std::vector<uint8_t> Header(const char* code, uint8_t revision, size_t length = 0x200) {
+        std::vector<uint8_t> h(length, 0);
+        std::memcpy(h.data(), "POKEMON B", 9);
+        if (length > kGameCodeOffset + 4) std::memcpy(h.data() + kGameCodeOffset, code, 4);
+        if (length > kRomVersionOffset) h[kRomVersionOffset] = revision;
+        return h;
+    }
+}
+
+TEST_CASE(identity_reads_code_and_revision_from_real_offsets) {
+    auto h = Header("IRBO", 0);
+    CartIdentity id = ReadCartIdentity(h.data(), h.size());
+    REQUIRE(id.valid);
+    REQUIRE_EQ(std::string(id.code), std::string("IRBO"));
+    REQUIRE_EQ(unsigned(id.revision), 0u);
+}
+
+TEST_CASE(black_and_white_revision_zero_gate_rejects_other_versions) {
+    REQUIRE(ClassifyGame(ReadCartIdentity(Header("IRBO", 0).data(), 0x200)) == SupportedGame::Black);
+    REQUIRE(ClassifyGame(ReadCartIdentity(Header("IRAO", 0).data(), 0x200)) == SupportedGame::White);
+    REQUIRE(ClassifyGame(ReadCartIdentity(Header("IRBO", 1).data(), 0x200)) == SupportedGame::None);   // revision 1
+    REQUIRE(ClassifyGame(ReadCartIdentity(Header("IRAO", 2).data(), 0x200)) == SupportedGame::None);
+    REQUIRE(ClassifyGame(ReadCartIdentity(Header("IRBJ", 0).data(), 0x200)) == SupportedGame::None);   // Japan
+    REQUIRE(ClassifyGame(ReadCartIdentity(Header("IRBE", 0).data(), 0x200)) == SupportedGame::None);
+    REQUIRE(ClassifyGame(ReadCartIdentity(Header("IRDO", 0).data(), 0x200)) == SupportedGame::None);   // Black 2
+    REQUIRE(ClassifyGame(ReadCartIdentity(Header("IREO", 0).data(), 0x200)) == SupportedGame::None);   // White 2
+    REQUIRE(ClassifyGame(ReadCartIdentity(Header("####", 0).data(), 0x200)) == SupportedGame::None);   // homebrew
+    REQUIRE_EQ(std::string(GameName(SupportedGame::Black)), std::string("black"));
+    REQUIRE_EQ(std::string(GameName(SupportedGame::White)), std::string("white"));
+    REQUIRE_EQ(std::string(GameName(SupportedGame::None)), std::string("none"));
+}
+
+TEST_CASE(short_or_missing_headers_are_invalid) {
+    auto h = Header("IRBO", 0);
+    REQUIRE(!ReadCartIdentity(h.data(), 0x1F).valid);   // ROMVersion at 0x1E needs 0x20 bytes
+    REQUIRE(ReadCartIdentity(h.data(), 0x20).valid);
+    REQUIRE(!ReadCartIdentity(nullptr, 0x200).valid);
+    REQUIRE(ClassifyGame(ReadCartIdentity(h.data(), 0x10)) == SupportedGame::None);
+
+    std::vector<uint8_t> garbage(0x200, 0xFF);
+    REQUIRE(!ReadCartIdentity(garbage.data(), garbage.size()).valid);
+}
