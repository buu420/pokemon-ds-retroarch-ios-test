+
+    // A dead reader stays dead and silent: no more speech, no more overrides.
+    REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Failed);
+    REQUIRE_EQ(f.sink.events.size(), size_t(2));
+}
+
+TEST_CASE(returned_chunk_is_reported_not_silent) {
