+// ------------------------------------------- final pass: never lose a line, and speak fatal config errors
+
+namespace {
+    /// Refuses only the calls named in `failOn` (1-based). A refused call speaks nothing, like a real
+    /// backend that rejected the request.
+    struct IntermittentSink final : SpeechSink {
+        std::vector<int> failOn;
+        int calls = 0;
+        std::vector<SpeechEvent> events;
+
+        bool Say(std::string_view text, bool interrupt) noexcept override {
+            ++calls;
+            for (int c : failOn) {
+                if (c == calls) return false;
+            }
+            events.push_back({SpeechEvent::Kind::Say, std::string(text), interrupt});
+            return true;
+        }
+        bool Stop() noexcept override { return true; }
+        [[nodiscard]] const char* Name() const noexcept override { return "prism:NVDA"; }
+    };
+}
+
+TEST_CASE(review_a_single_speech_failure_still_delivers_that_exact_line) {
+    // Missing game information is the worst outcome this tool has, so ONE refused line must still reach the
+    // player -- immediately, and as itself, not two lines later and not as a diagnostic. Configured with the
+    // production policy, so it cannot pass against a threshold the core does not ship.
+    IntermittentSink primary;
+    primary.failOn = {2};
+    RecordingSpeechSink fallback;
+    fallback.name = "frontend";
+    SpeechDispatcher speech(&primary, nullptr);
+    speech.SetFallbackSink(&fallback, SpeechDispatcher::kDefaultFailureThreshold);
+    REQUIRE(SpeechDispatcher::kDefaultFailureThreshold > 1);   // otherwise this proves nothing
+
+    REQUIRE(speech.Say("Chargestone Cave", true));
+    REQUIRE_EQ(primary.events.size(), size_t(1));
+    REQUIRE_EQ(fallback.events.size(), size_t(0));
+
+    // The one refused line.
+    REQUIRE(speech.Say("Zebstrika, 84 of 84 HP", false));
+    REQUIRE_EQ(fallback.events.size(), size_t(1));
+    REQUIRE_EQ(fallback.events[0].text, std::string("Zebstrika, 84 of 84 HP"));   // verbatim
+    REQUIRE(!fallback.events[0].interrupt);                                       // and still a queued line
+    REQUIRE_EQ(speech.Replays(), uint64_t(1));
+    REQUIRE_EQ(speech.ConsecutiveFailures(), uint64_t(1));
+    REQUIRE(!speech.Demoted());
+    REQUIRE(speech.Sink() == &primary);        // one hiccup must not cost a working screen reader
+
+    // Everything after it goes back to the primary, with no residue.
+    REQUIRE(speech.Say("Continue, 1 of 7", true));
+    REQUIRE_EQ(primary.events.size(), size_t(2));
+    REQUIRE_EQ(primary.events[1].text, std::string("Continue, 1 of 7"));
+    REQUIRE_EQ(fallback.events.size(), size_t(1));
+    REQUIRE_EQ(speech.ConsecutiveFailures(), uint64_t(0));
+    REQUIRE_EQ(speech.Replays(), uint64_t(1));
+    REQUIRE(!speech.Demoted());
+}
+
+TEST_CASE(review_a_replay_carries_a_pending_diagnostic_and_spends_it) {
+    // A diagnostic riding on a line that the primary refuses must be heard through the replay, and must not
+    // then be said a second time on the next line.
+    IntermittentSink primary;
+    primary.failOn = {1};
+    RecordingSpeechSink fallback;
+    fallback.name = "frontend";
+    SpeechDispatcher speech(&primary, nullptr);
+    speech.SetFallbackSink(&fallback, SpeechDispatcher::kDefaultFailureThreshold);
+
+    speech.AnnounceProblem("Speech backend failed.", 300);
+    REQUIRE(speech.Say("Pokemon black accessibility loader running.", true));
+    REQUIRE_EQ(fallback.events.size(), size_t(1));
+    REQUIRE_CONTAINS(fallback.events[0].text, "Speech backend failed.");
+    REQUIRE_CONTAINS(fallback.events[0].text, "loader running.");
+    REQUIRE(!speech.HasPendingAnnouncement());   // spent, because it was heard
+
+    REQUIRE(speech.Say("Continue, 1 of 7", true));
+    REQUIRE_EQ(primary.events.size(), size_t(1));
+    REQUIRE_EQ(primary.events[0].text, std::string("Continue, 1 of 7"));
+}
+
+TEST_CASE(review_without_a_fallback_a_refused_line_is_still_reported_as_failed) {
+    // The replay only exists when there is somewhere to replay to. With no fallback the caller must still
+    // learn the line was lost, rather than being told it was spoken.
+    RecordingSpeechSink only;
+    only.failSay = true;
+    SpeechDispatcher speech(&only, nullptr);
+
+    REQUIRE(!speech.Say("Chargestone Cave", true));
+    REQUIRE_EQ(speech.Replays(), uint64_t(0));
+    REQUIRE_EQ(speech.ConsecutiveFailures(), uint64_t(1));
+    REQUIRE(!speech.Demoted());
+}
+
+TEST_CASE(review_a_fatal_configuration_error_is_composed_for_speech) {
+    // The real missing-NAND text the error screen shows (exceptions.cpp): the problem, then the fix.
+    std::string text = ComposeFatalError(
+        "DSi mode requires a NAND image, but none was found.",
+        "Place your NAND file in your frontend's system folder (any name works), then restart the core. "
+        "If you want to play a regular DS game, try disabling DSi mode in the core options.");
+    REQUIRE_CONTAINS(text, "DSi mode requires a NAND image");
+    REQUIRE_CONTAINS(text, "try disabling DSi mode in the core options.");
+    REQUIRE_EQ(text.find("..."), std::string::npos);   // no doubled sentence punctuation
+
+    // A message with no terminator gets one before the recovery action is appended.
+    REQUIRE_EQ(ComposeFatalError("Something broke", "Do this"), std::string("Something broke. Do this"));
+    REQUIRE_EQ(ComposeFatalError("Something broke!", "Do this"), std::string("Something broke! Do this"));
+
+    // emulator_exception's single-argument constructor copies what() into the user message, so an
+    // identical pair must be said once, not twice.
+    REQUIRE_EQ(ComposeFatalError("Only one thing.", "Only one thing."), std::string("Only one thing."));
+    REQUIRE_EQ(ComposeFatalError("Only one thing.", ""), std::string("Only one thing."));
+    REQUIRE_EQ(ComposeFatalError("", ""), std::string());
+}
+
+TEST_CASE(review_a_fatal_configuration_error_is_spoken_immediately_not_deferred) {
+    // The error screen's branch of Run() returns before Tick() is ever reached, so a deferred announcement
+    // would never be delivered. It has to go out on the spot, and log-only mode must still see the text.
+    RecordingSpeechSink sink;
+    std::vector<std::string> logs;
+    SpeechDispatcher speech(&sink, [&](LogLevel, std::string_view m) { logs.emplace_back(m); });
+
+    std::string text = ComposeFatalError("DSi mode requires a NAND image, but none was found.",
+                                         "Place your NAND file in your frontend's system folder.");
+    REQUIRE(speech.Say(text, true));
+    REQUIRE_EQ(sink.events.size(), size_t(1));       // without a single Tick()
+    REQUIRE(!speech.HasPendingAnnouncement());
+    REQUIRE_CONTAINS(sink.events[0].text, "DSi mode requires a NAND image");
+    REQUIRE_CONTAINS(sink.events[0].text, "system folder.");
+
+    bool logged = false;
+    for (const std::string& line : logs) {
+        if (line.find("DSi mode requires a NAND image") != std::string::npos
+            && line.find("speech say interrupt=true") != std::string::npos) logged = true;
+    }
+    REQUIRE(logged);                                  // the full text reaches the log in every mode
+}
diff --git a/test/accessibility/test_speech.cpp b/test/accessibility/test_speech.cpp
new file mode 100644
index 0000000..5b612aa
--- /dev/null
+++ b/test/accessibility/test_speech.cpp
@@ -0,0 +1,118 @@
+// Interrupt / queue / stop semantics and full-text logging.
+#include "harness.hpp"
+
+#include <vector>
+
+#include "accessibility/bounded_memory.hpp"
+#include "accessibility/lua_reader.hpp"
+#include "accessibility/speech.hpp"
+
+using namespace MelonDsDs::access;
+
+namespace {
+    struct Fixture {
+        std::vector<uint8_t> ram = std::vector<uint8_t>(0x100, 0);
+        BoundedMemory ramView {ram.data(), ram.size()};
+        BoundedMemory romView;
+        RecordingSpeechSink sink;
+        std::vector<std::string> logs;
+        SpeechDispatcher speech {&sink, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }};
+        LuaReader reader {ReaderHost {&ramView, &romView, &speech, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }}};
+    };
+
+    struct InterruptOnlySink final : SpeechSink {
+        std::vector<SpeechEvent> events;
+        bool Say(std::string_view text, bool interrupt) noexcept override {
+            events.push_back({SpeechEvent::Kind::Say, std::string(text), interrupt});
+            return true;
+        }
+        bool Stop() noexcept override { return false; }
+        const char* Name() const noexcept override { return "frontend"; }
+        bool SupportsQueue() const noexcept override { return false; }
+    };
+}
+
+TEST_CASE(say_interrupt_queue_and_stop_arrive_in_order_with_the_right_flags) {
+    Fixture f;
+    const char* script = R"(
+        speech.say("a")
+        speech.say("b", false)
+        speech.say("c", true)
+        speech.stop()
+        speech.say(42)
+        speech.say("d", nil)
+        speech.output("e", false)
+        emu.frameadvance()
+    )";
+    REQUIRE(f.reader.Load(script, "speech.lua"));
+    REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Running);
+    const auto& ev = f.sink.events;
+    REQUIRE_EQ(ev.size(), size_t(7));
+    REQUIRE(ev[0].kind == SpeechEvent::Kind::Say); REQUIRE_EQ(ev[0].text, std::string("a")); REQUIRE(ev[0].interrupt);
+    REQUIRE(ev[1].kind == SpeechEvent::Kind::Say); REQUIRE_EQ(ev[1].text, std::string("b")); REQUIRE(!ev[1].interrupt);
+    REQUIRE(ev[2].kind == SpeechEvent::Kind::Say); REQUIRE_EQ(ev[2].text, std::string("c")); REQUIRE(ev[2].interrupt);
+    REQUIRE(ev[3].kind == SpeechEvent::Kind::Stop);
+    REQUIRE(ev[4].kind == SpeechEvent::Kind::Say); REQUIRE_EQ(ev[4].text, std::string("42")); REQUIRE(ev[4].interrupt);
+    REQUIRE(ev[5].kind == SpeechEvent::Kind::Say); REQUIRE_EQ(ev[5].text, std::string("d")); REQUIRE(ev[5].interrupt);   // nil = default = interrupt
+    REQUIRE(ev[6].kind == SpeechEvent::Kind::Say); REQUIRE_EQ(ev[6].text, std::string("e")); REQUIRE(!ev[6].interrupt);
+}
+
+TEST_CASE(unicode_text_passes_through_byte_exact) {
+    Fixture f;
+    // "Pokémon ♪ ← é" with the same UTF-8 bytes the reader produces.
+    const char* script = "speech.say(\"Pok\xC3\xA9mon \xE2\x99\xAA \xE2\x86\x90 \xC3\xA9\", false) emu.frameadvance()";
+    REQUIRE(f.reader.Load(script, "utf8.lua"));
+    REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Running);
+    REQUIRE_EQ(f.sink.events.size(), size_t(1));
+    REQUIRE_EQ(f.sink.events[0].text, std::string("Pok\xC3\xA9mon \xE2\x99\xAA \xE2\x86\x90 \xC3\xA9"));
+    bool logged = false;
+    for (const std::string& line : f.logs) {
+        if (line.find("speech say interrupt=false backend=log text=\"Pok\xC3\xA9mon \xE2\x99\xAA \xE2\x86\x90 \xC3\xA9\"") != std::string::npos) logged = true;
+    }
+    REQUIRE(logged);
+}
+
+TEST_CASE(dispatcher_logs_every_action_and_reports_failures) {
+    std::vector<std::string> logs;
+    RecordingSpeechSink sink;
+    SpeechDispatcher speech(&sink, [&](LogLevel, std::string_view m) { logs.emplace_back(m); });
+
+    REQUIRE(speech.Say("line one\nline \"two\"", true));
+    REQUIRE(speech.Stop());
+    REQUIRE_EQ(logs.size(), size_t(2));
+    REQUIRE_EQ(logs[0], std::string("speech say interrupt=true backend=log text=\"line one\\nline \\\"two\\\"\""));
+    REQUIRE_EQ(logs[1], std::string("speech stop backend=log"));
+    REQUIRE_EQ(speech.Failures(), uint64_t(0));
+
+    sink.failSay = true;
+    REQUIRE(!speech.Say("x", false));
+    REQUIRE_EQ(speech.Failures(), uint64_t(1));
+    REQUIRE_CONTAINS(speech.LastError(), "rejected");
+    bool failureLogged = false;
+    for (const std::string& line : logs) {
+        if (line.find("speech FAILED") != std::string::npos) failureLogged = true;
+    }
+    REQUIRE(failureLogged);
+
+    speech.SetSink(nullptr);
+    REQUIRE(!speech.Say("y", true));
+    REQUIRE(!speech.Stop());
+    REQUIRE_EQ(speech.Failures(), uint64_t(3));
+}
+
+TEST_CASE(queue_requests_to_an_interrupt_only_backend_are_logged_as_degraded) {
+    std::vector<std::string> logs;
+    InterruptOnlySink sink;
+    SpeechDispatcher speech(&sink, [&](LogLevel, std::string_view m) { logs.emplace_back(m); });
+    REQUIRE(speech.Say("queued", false));
+    REQUIRE_EQ(sink.events.size(), size_t(1));
+    REQUIRE(!sink.events[0].interrupt);   // the request is passed through unchanged
+    REQUIRE_CONTAINS(logs[0], "degraded=queue-spoken-as-interrupt");
+    REQUIRE(speech.Say("now", true));
+    REQUIRE(logs[1].find("degraded") == std::string::npos);
+}
+
+TEST_CASE(escape_for_log_keeps_one_line) {
+    REQUIRE_EQ(SpeechDispatcher::EscapeForLog("a\tb\rc\x01"), std::string("a\\tb\\rc\\x01"));
+    REQUIRE_EQ(SpeechDispatcher::EscapeForLog("back\\slash"), std::string("back\\\\slash"));
+}
diff --git a/test/accessibility/test_touch.cpp b/test/accessibility/test_touch.cpp
new file mode 100644
index 0000000..093bbe4
--- /dev/null
+++ b/test/accessibility/test_touch.cpp
@@ -0,0 +1,132 @@
+// Synthetic touch: mnemonic parsing, tap/drag frame sequences, pointer suppression, no-op setanalog.
+#include "harness.hpp"
+
+#include <vector>
+
+#include "accessibility/bounded_memory.hpp"
+#include "accessibility/host_input.hpp"
+#include "accessibility/lua_reader.hpp"
+#include "accessibility/speech.hpp"
+
+using namespace MelonDsDs::access;
+
+namespace {
+    constexpr uint32_t Bit(unsigned id) { return 1u << id; }
+
+    struct Fixture {
+        std::vector<uint8_t> ram = std::vector<uint8_t>(0x100, 0);
+        BoundedMemory ramView {ram.data(), ram.size()};
+        BoundedMemory romView;
+        RecordingSpeechSink sink;
+        std::vector<std::string> logs;
+        SpeechDispatcher speech {&sink, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }};
+        LuaReader reader {ReaderHost {&ramView, &romView, &speech, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }}};
+    };
+}
+
+TEST_CASE(mnemonic_parsing_matches_the_bizhawk_melonds_layout) {
+    auto down = ParseMnemonic("|100,50,100,0,..............T..|");
+    REQUIRE(down.has_value());
+    REQUIRE(down->active);
+    REQUIRE(down->touchDown);
+    REQUIRE_EQ(unsigned(down->x), 100u);
+    REQUIRE_EQ(unsigned(down->y), 50u);
+    REQUIRE_EQ(down->pressed, 1u << unsigned(DsButton::Touch));
+
+    auto up = ParseMnemonic("|128,96,100,0,.................|");
+    REQUIRE(up.has_value());
+    REQUIRE(!up->touchDown);
+    REQUIRE_EQ(up->pressed, 0u);
+
+    auto clamped = ParseMnemonic("|300,200,100,0,..............T..|");
+    REQUIRE(clamped.has_value());
+    REQUIRE_EQ(unsigned(clamped->x), 255u);
+    REQUIRE_EQ(unsigned(clamped->y), 191u);
+
+    auto buttons = ParseMnemonic("|0,0,0,0,U......A.........|");
+    REQUIRE(buttons.has_value());
+    REQUIRE_EQ(buttons->pressed, (1u << unsigned(DsButton::Up)) | (1u << unsigned(DsButton::A)));
+    REQUIRE(!buttons->touchDown);
+
+    REQUIRE(!ParseMnemonic("").has_value());
+    REQUIRE(!ParseMnemonic("|1,2|").has_value());
+    REQUIRE(!ParseMnemonic("|1,2,3,4,.....|").has_value());              // too few button characters
+    REQUIRE(!ParseMnemonic("|1,2,3,4,..................|").has_value()); // too many
+    REQUIRE(!ParseMnemonic("1,2,3,4,.................").has_value());    // missing bars
+    REQUIRE(!ParseMnemonic("|x,2,3,4,.................|").has_value());  // non-numeric axis
+}
+
+TEST_CASE(a_mnemonic_sets_every_button_and_takes_over_the_touch_screen) {
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::B) | Bit(retro_id::DOWN);
+    raw.pointerPressed = true;
+    InputOverrides ov;
+    ov.mnemonic = *ParseMnemonic("|10,20,100,0,U......A......T..|");
+
+    FilteredInput out = ApplyInputLayer(raw, ov, LayerConfig {false, false});
+    REQUIRE_EQ(out.joypadMask, Bit(retro_id::UP) | Bit(retro_id::A));   // player's B and Down are suppressed
+    REQUIRE(out.suppressPointer);
+    REQUIRE(out.touchOverride);
+    REQUIRE(out.touchDown);
+    REQUIRE_EQ(unsigned(out.touchX), 10u);
+    REQUIRE_EQ(unsigned(out.touchY), 20u);
+
+    ov.mnemonic = *ParseMnemonic("|128,96,100,0,.................|");
+    out = ApplyInputLayer(raw, ov, LayerConfig {false, false});
+    REQUIRE_EQ(out.joypadMask, 0u);
+    REQUIRE(out.touchOverride);
+    REQUIRE(!out.touchDown);
+}
+
+TEST_CASE(the_readers_tap_gesture_produces_the_expected_frame_sequence) {
+    Fixture f;
+    // The reader's reg.touch.tap: one released frame first (so the press is an edge), N held frames, one released.
+    const char* script = R"(
+        local function mnemonic(x, y, down)
+            local b = {}
+            for i = 1, 17 do b[i] = "." end
+            if down then b[15] = "T" end
+            return string.format("|%d,%d,100,0,%s|", x, y, table.concat(b))
+        end
+        local frames = { false, {10, 20}, {10, 20}, {10, 20}, false }
+        for _, fr in ipairs(frames) do
+            if fr then joypad.setfrommnemonicstr(mnemonic(fr[1], fr[2], true))
+            else joypad.setfrommnemonicstr(mnemonic(128, 96, false)) end
+            emu.frameadvance()
+        end
+        joypad.setanalog({ ["Touch X"] = "", ["Touch Y"] = "" })
+        emu.frameadvance()
+        while true do emu.frameadvance() end
+    )";
+    REQUIRE(f.reader.Load(script, "tap.lua"));
+    HostInputSnapshot raw;
+    raw.pointerPressed = true;   // the player's finger must not disturb the gesture
+    LayerConfig layer {true, true};
+
+    struct Expect { bool over; bool down; };
+    const Expect expected[] = {{true, false}, {true, true}, {true, true}, {true, true}, {true, false}, {false, false}};
+    for (const Expect& e : expected) {
+        REQUIRE(f.reader.StepFrame(raw) == LuaReader::Status::Running);
+        FilteredInput out = ApplyInputLayer(raw, f.reader.Overrides(), layer);
+        REQUIRE_EQ(out.touchOverride, e.over);
+        REQUIRE_EQ(out.touchDown, e.down);
+        REQUIRE_EQ(out.suppressPointer, e.over);
+        if (e.down) {
+            REQUIRE_EQ(unsigned(out.touchX), 10u);
+            REQUIRE_EQ(unsigned(out.touchY), 20u);
+        }
+    }
+    REQUIRE(!f.reader.Overrides().Any());   // setanalog is a no-op and nothing is sticky
+}
+
+TEST_CASE(a_bad_mnemonic_is_ignored_and_logged_without_killing_the_reader) {
+    Fixture f;
+    REQUIRE(f.reader.Load("joypad.setfrommnemonicstr('|nope|') emu.frameadvance()", "bad.lua"));
+    REQUIRE(f.reader.StepFrame(HostInputSnapshot {}) == LuaReader::Status::Running);
+    REQUIRE(!f.reader.Overrides().mnemonic.active);
+    bool logged = false;
+    for (const std::string& line : f.logs) {
+        if (line.find("unparseable mnemonic") != std::string::npos) logged = true;
+    }
+    REQUIRE(logged);
+}
