diff --git a/src/libretro/accessibility/CMakeLists.txt b/src/libretro/accessibility/CMakeLists.txt
new file mode 100644
index 0000000..2b808c7
--- /dev/null
+++ b/src/libretro/accessibility/CMakeLists.txt
@@ -0,0 +1,79 @@
+# melonDS DS Access: Lua 5.4 runtime, the libretro-free adapter library, and the embedded reader copy.
+#
+# Everything in melondsds_access_core is testable without melonDS or libretro; the core glue that binds
+# it to the console lives in accessibility.cpp / frontend_speech.cpp / reader_locator.cpp and is added to
+# the core target by src/libretro/CMakeLists.txt.
+
+include(FetchContent)
+
+set(MELONDSDS_LUA_VERSION "5.4.9")
+set(MELONDSDS_LUA_SHA256 "2335b6c582a52654f94612bf10d2f4672805d05329aa6568b1d8cd9e5c6fb8e6")
+
+FetchContent_Declare(lua
+    URL "https://www.lua.org/ftp/lua-${MELONDSDS_LUA_VERSION}.tar.gz"
+    URL_HASH "SHA256=${MELONDSDS_LUA_SHA256}"
+    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
+)
+message(STATUS "Using Lua ${MELONDSDS_LUA_VERSION} from lua.org (sha256 ${MELONDSDS_LUA_SHA256})")
+# The tarball has no CMakeLists.txt, so this only downloads and extracts it.
+FetchContent_MakeAvailable(lua)
+
+file(GLOB MELONDSDS_LUA_SOURCES CONFIGURE_DEPENDS "${lua_SOURCE_DIR}/src/*.c")
+list(FILTER MELONDSDS_LUA_SOURCES EXCLUDE REGEX "/(lua|luac|onelua)\\.c$")
+
+add_library(melondsds_lua STATIC ${MELONDSDS_LUA_SOURCES})
+target_include_directories(melondsds_lua PUBLIC "${lua_SOURCE_DIR}/src")
+set_target_properties(melondsds_lua PROPERTIES C_STANDARD 99 POSITION_INDEPENDENT_CODE ON)
+if (CMAKE_C_COMPILER_ID STREQUAL "GNU" OR CMAKE_C_COMPILER_ID MATCHES "Clang")
+    target_compile_options(melondsds_lua PRIVATE -O2 -Wno-implicit-fallthrough)
+endif ()
+
+# iOS has no system(). Use Lua's guarded l_system override with its own iOS fallback,
+# without enabling the POSIX/popen paths that LUA_USE_IOS also selects.
+# Pass -D as a compiler option: CMake generators discard function-like definitions
+# from COMPILE_DEFINITIONS. The reader's custom os.clock remains unchanged.
+# IOS also includes Mac Catalyst, which sets MACOS and does provide system().
+if (IOS AND NOT MACOS)
+    target_compile_options(melondsds_lua PRIVATE "-Dl_system(cmd)=((cmd)==NULL?0:-1)")
+endif ()
+
+add_library(melondsds_access_core STATIC
+    bounded_memory.hpp
+    cart_identity.cpp
+    cart_identity.hpp
+    env_override.cpp
+    env_override.hpp
+    host_input.cpp
+    host_input.hpp
+    lua_reader.cpp
+    lua_reader.hpp
+    native_speech.cpp
+    native_speech.hpp
+    reader_session.cpp
+    reader_session.hpp
+    sha256.cpp
+    sha256.hpp
+    speech.cpp
+    speech.hpp
+)
+if (WIN32)
+    target_sources(melondsds_access_core PRIVATE prism_speech.cpp prism_speech.hpp)
+endif ()
+target_compile_features(melondsds_access_core PUBLIC cxx_std_17)
+target_link_libraries(melondsds_access_core PUBLIC melondsds_lua)
+target_include_directories(melondsds_access_core PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/..")
+set_target_properties(melondsds_access_core PROPERTIES POSITION_INDEPENDENT_CODE ON)
+if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+    target_compile_options(melondsds_access_core PRIVATE -Wall -Wextra -Werror=return-type)
+endif ()
+
+# The reader copy is embedded as a fallback; the file next to the core takes precedence at runtime.
+if (COMMAND embed_binaries)
+    embed_binaries(melondsds-access-assets
+        ASSET
+            NAME "melondsds_access_reader"
+            PATH "lua/pokemon_bw_reader.lua"
+            BYTE_TYPE char
+            NULL_TERMINATE
+    )
+endif ()
diff --git a/src/libretro/accessibility/accessibility.cpp b/src/libretro/accessibility/accessibility.cpp
new file mode 100644
index 0000000..df770ee
--- /dev/null
+++ b/src/libretro/accessibility/accessibility.cpp
@@ -0,0 +1,406 @@
+/*
+    melonDS DS Access: the core-side owner of the reader session, its speech backend and its input hooks.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#include "accessibility.hpp"
+
+#include <cstdlib>
+#include <cstring>
+
+#include <libretro.h>
+#include <NDS.h>
+#include <NDSCart.h>
+
+#include "config/config.hpp"
+#include "constants.hpp"
+#include "environment.hpp"
+#include "input/input.hpp"
+#include "accessibility/env_override.hpp"
+#include "accessibility/reader_locator.hpp"
+
+using namespace MelonDsDs;
+using namespace MelonDsDs::access;
+
+namespace {
+    // The pure layer mirrors libretro's joypad ids; make sure they never drift.
+    static_assert(retro_id::B == RETRO_DEVICE_ID_JOYPAD_B);
+    static_assert(retro_id::Y == RETRO_DEVICE_ID_JOYPAD_Y);
+    static_assert(retro_id::SELECT == RETRO_DEVICE_ID_JOYPAD_SELECT);
+    static_assert(retro_id::START == RETRO_DEVICE_ID_JOYPAD_START);
+    static_assert(retro_id::UP == RETRO_DEVICE_ID_JOYPAD_UP);
+    static_assert(retro_id::DOWN == RETRO_DEVICE_ID_JOYPAD_DOWN);
+    static_assert(retro_id::LEFT == RETRO_DEVICE_ID_JOYPAD_LEFT);
+    static_assert(retro_id::RIGHT == RETRO_DEVICE_ID_JOYPAD_RIGHT);
+    static_assert(retro_id::A == RETRO_DEVICE_ID_JOYPAD_A);
+    static_assert(retro_id::X == RETRO_DEVICE_ID_JOYPAD_X);
+    static_assert(retro_id::L == RETRO_DEVICE_ID_JOYPAD_L);
+    static_assert(retro_id::R == RETRO_DEVICE_ID_JOYPAD_R);
+    static_assert(retro_id::L2 == RETRO_DEVICE_ID_JOYPAD_L2);
+    static_assert(retro_id::R2 == RETRO_DEVICE_ID_JOYPAD_R2);
+    static_assert(retro_id::L3 == RETRO_DEVICE_ID_JOYPAD_L3);
+    static_assert(retro_id::R3 == RETRO_DEVICE_ID_JOYPAD_R3);
+
+    constexpr const char* kLogOnlyEnv = "MELONDSDS_ACCESSIBILITY_LOG_ONLY";
+    constexpr size_t kDsMainRamSize = 0x400000;   // 4 MiB; DSi reports MainRAMMaxSize (16 MiB)
+    constexpr const char* kChunkName = "pokemon_bw_reader.lua";
+    /// Consecutive failures tolerated before the primary backend is dropped for good. No line is lost while
+    /// waiting: SpeechDispatcher replays every refused line through the fallback immediately. Declared in
+    /// speech.hpp so the regressions run against the same policy the core ships.
+    constexpr unsigned kSpeechFailureThreshold = SpeechDispatcher::kDefaultFailureThreshold;
+    /// Frames a problem announcement waits to ride along with the reader's next line before going alone.
+    constexpr uint64_t kAnnouncementGraceFrames = 180;
+
+    /// Deliberately NOT std::getenv: MinGW links msvcrt, whose getenv serves a private copy snapshotted
+    /// when msvcrt attached to the process. A host that sets the variable and then LoadLibrary's this core
+    /// updates the process environment block, which msvcrt's copy never sees. Measured with the Python
+    /// validation host: getenv returned null while GetEnvironmentVariableA returned "1".
+    bool LogOnlyRequestedByEnvironment() noexcept {
+        return EnvironmentFlagSet(kLogOnlyEnv);
+    }
+
+    const char* BackendOptionName(AccessSpeechBackend backend) noexcept {
+        switch (backend) {
+            case AccessSpeechBackend::Prism: return "prism";
+            case AccessSpeechBackend::Frontend: return "frontend";
+            default: return "log";
+        }
+    }
+}
+
+void AccessibilityState::Log(LogLevel level, std::string_view message) noexcept {
+    switch (level) {
+        case LogLevel::Debug: retro::debug("[accessibility] {}", message); break;
+        case LogLevel::Info: retro::info("[accessibility] {}", message); break;
+        case LogLevel::Warn: retro::warn("[accessibility] {}", message); break;
+        default: retro::error("[accessibility] {}", message); break;
+    }
+}
+
+AccessibilityState::AccessibilityState() noexcept
+    : _speech(&_logOnlySink, &AccessibilityState::Log),
+      _session(&_speech, &AccessibilityState::Log) {
+    // A backend that works and then dies must degrade audibly instead of leaving a running reader silent.
+    _speech.SetFallbackSink(&_frontendSink, kSpeechFailureThreshold);
+    _logOnlyEnv = LogOnlyRequestedByEnvironment();
+    if (_logOnlyEnv) {
+        Log(LogLevel::Info, std::string(kLogOnlyEnv) + " is set: speech is logged only, never spoken");
+    }
+}
+
+AccessibilityState::~AccessibilityState() noexcept {
+    Shutdown();
+}
+
+void AccessibilityState::SetConfig(const CoreConfig& config) noexcept {
+    SessionConfig next;
+    next.readerEnabled = config.AccessReaderEnabled();
+    next.layer.layerEnabled = config.AccessControllerLayer();
+    next.layer.consumeL3 = config.AccessL3ForAccessibility();
+    bool changed = next.readerEnabled != _sessionConfig.readerEnabled
+        || next.layer.layerEnabled != _sessionConfig.layer.layerEnabled
+        || next.layer.consumeL3 != _sessionConfig.layer.consumeL3
+        || _keyboard != config.AccessKeyboard()
+        || _requestedBackend != config.AccessSpeech();
+
+    _sessionConfig = next;
+    _keyboard = config.AccessKeyboard();
+    _requestedBackend = config.AccessSpeech();
+    _session.SetConfig(_sessionConfig);
+
+    if (changed) {
+        Log(LogLevel::Info, std::string("options: reader=") + (next.readerEnabled ? "enabled" : "disabled")
+            + " controller_layer=" + (next.layer.layerEnabled ? "enabled (L2/R2 consumed)" : "disabled")
+            + " l3_role=" + (next.layer.consumeL3 ? "accessibility (L3 consumed)" : "microphone")
+            + " keyboard=" + (_keyboard ? "enabled" : "disabled")
+            + " speech=" + BackendOptionName(_requestedBackend) + (_logOnlyEnv ? " (overridden to log by environment)" : ""));
+    }
+    if (_attached && changed) {
+        EnsureSpeechBackend();
+    }
+}
+
+void AccessibilityState::AnnounceProblem(const std::string& text) noexcept {
+    Log(LogLevel::Error, text);
+    if (_logOnlyEnv) return;
+    // Deliberately NOT spoken right here. The reader's own startup line interrupts within a frame or two of
+    // this point, which would cut the warning off mid-word. The dispatcher carries it on that next line
+    // instead, and speaks it alone if no line ever follows.
+    _speech.AnnounceProblem(text, kAnnouncementGraceFrames);
+    // Also put it on screen, which the frontend's own narrator reads when it is enabled.
+    retro::set_error_message("{}", text);
+}
+
+void AccessibilityState::EnsureSpeechBackend() noexcept {
+    AccessSpeechBackend mode = _logOnlyEnv ? AccessSpeechBackend::LogOnly : _requestedBackend;
+
+    if (mode == AccessSpeechBackend::LogOnly) {
+        _speech.SetSink(&_logOnlySink);
+        Log(LogLevel::Info, "speech backend: log only (nothing is spoken)");
+        return;
+    }
+
+    if (mode == AccessSpeechBackend::Frontend) {
+        // Ask before selecting, so the very first log line states what this frontend can really do rather
+        // than assuming the worst. prism.dll is not located, hashed or loaded on this path.
+        _frontendSink.Negotiate();
+        _speech.SetSink(&_frontendSink);
+        Log(LogLevel::Info, "speech backend: RetroArch native speech, " + _frontendSink.Caps().Describe());
+        return;
+    }
+
+#ifdef _WIN32
+    if (_speech.Demoted()) {
+        // A backend that stopped answering must not come back just because an option changed. Only
+        // MaybeRecoverSpeech, which re-creates the instance and proves it works, may promote one.
+        _speech.SetSink(&_frontendSink);
+        return;
+    }
+    if (_prismSink && _prismSink->Ready()) {
+        _speech.SetSink(_prismSink.get());
+        return;
+    }
+    if (!_prismFailed) {
+        std::string error;
+        std::optional<std::string> path = LocateDataFile(kPrismFileName);
+        if (!path) {
+            error = std::string("prism.dll was not found in any data directory (");
+            bool first = true;
+            for (const std::string& dir : DataDirectoryCandidates()) {
+                if (!first) error += "; ";
+                error += dir;
+                first = false;
+            }
+            error += ")";
+        }
+        else {
+            try {
+                _prismSink = std::make_unique<PrismSpeech>(&AccessibilityState::Log);
+            }
+            catch (...) {
+                error = "out of memory creating the Prism backend";
+            }
+            if (_prismSink && !_prismSink->Load(*path, error)) {
+                _prismSink.reset();
+            }
+        }
+        if (_prismSink && _prismSink->Ready()) {
+            _speech.SetSink(_prismSink.get());
+            Log(LogLevel::Info, "speech backend: " + std::string(_prismSink->Name()) + " (queue, interrupt and stop preserved)");
+            return;
+        }
+        _prismFailed = true;
+        _speech.SetSink(&_frontendSink);
+        AnnounceProblem("Accessibility speech backend failed: " + error
+                        + ". Speech falls back to the RetroArch narrator, which cannot queue or stop.");
+        return;
+    }
+#else
+    if (!_degradedAnnounced) {
+        AnnounceProblem("Accessibility speech backend Prism is only available on Windows. Speech falls back to the RetroArch narrator.");
+    }
+#endif
+    _speech.SetSink(&_frontendSink);
+    if (!_degradedAnnounced) {
+        _degradedAnnounced = true;
+    }
+}
+
+void AccessibilityState::MaybeRecoverSpeech() noexcept {
+#ifdef _WIN32
+    if (!_speech.Demoted()) return;
+    if (_logOnlyEnv || _requestedBackend != AccessSpeechBackend::Prism) return;
+    if (_prismFailed) return;                       // it never loaded; re-creating it will not help
+    if (_speechRecoveries >= kMaxSpeechRecoveries) return;
+    if (++_framesSinceDemotion < kSpeechRecoveryCooldownFrames) return;
+
+    _framesSinceDemotion = 0;
+    ++_speechRecoveries;
+
+    std::optional<std::string> path = LocateDataFile(kPrismFileName);
+    if (!path) {
+        _speechRecoveries = kMaxSpeechRecoveries;   // nothing to re-create; stop trying
+        return;
+    }
+
+    _prismSink.reset();                             // destroy the dead instance first, as Prism requires
+    std::unique_ptr<PrismSpeech> candidate;
+    std::string error;
+    try {
+        candidate = std::make_unique<PrismSpeech>(&AccessibilityState::Log);
+    }
+    catch (...) {
+        return;
+    }
+    if (!candidate->Load(*path, error) || !candidate->Ready()) {
+        Log(LogLevel::Warn, "speech recovery attempt " + std::to_string(_speechRecoveries) + " of "
+                            + std::to_string(kMaxSpeechRecoveries) + " failed: " + error);
+        return;
+    }
+    // Loading only proves a backend was acquired. Prism can hand back a handle for a screen reader that is
+    // still gone, so prove it answers before routing the player's speech into it. Stop() is silent.
+    if (!candidate->Stop()) {
+        Log(LogLevel::Warn, "speech recovery attempt " + std::to_string(_speechRecoveries) + " of "
+                            + std::to_string(kMaxSpeechRecoveries)
+                            + ": the re-created backend loaded but did not answer; staying on the narrator");
+        return;
+    }
+
+    _prismSink = std::move(candidate);
+    _speech.Promote(_prismSink.get());
+    _speech.AnnounceProblem("Screen reader speech restored.", kAnnouncementGraceFrames);
+#endif
+}
+
+void AccessibilityState::AnnounceFatalError(std::string_view message, std::string_view recovery) noexcept {
+    if (_fatalErrorAnnounced) return;
+    _fatalErrorAnnounced = true;
+
+    std::string text = ComposeFatalError(message, recovery);
+    if (text.empty()) return;
+
+    Log(LogLevel::Error, "fatal configuration error: " + text);
+    // Pick whichever backend the options asked for, exactly as normal play would; in log-only mode this
+    // selects the log sink, so automated hosts still see the full text and hear nothing.
+    EnsureSpeechBackend();
+    // Immediate, NOT deferred: the error screen's branch of Run() returns before Tick() is ever reached.
+    _speech.Say(text, true);
+}
+
+void AccessibilityState::Attach(melonDS::NDS& nds) noexcept {
+    _attached = false;
+    _session.Detach();
+    // Whatever the previous session queued is about a game state that no longer exists.
+    if (_speech.Sink() && _speech.Sink() != &_logOnlySink) _speech.Stop();
+
+    const melonDS::NDSCart::CartCommon* cart = nds.GetNDSCart();
+    if (!cart) {
+        Log(LogLevel::Info, "no cartridge inserted; the reader stays idle");
+        return;
+    }
+
+    ReaderSource source;
+    if (!_sessionConfig.readerEnabled) {
+        // The session is still told about the cartridge so its state is coherent and the log is useful, but
+        // nothing runs, no 2 MB reader is read or hashed, and the controller layer stays inactive, so the
+        // core keeps L2/R2/L3 for itself.
+        Log(LogLevel::Info, "melonds_access_reader is disabled; the reader will not run for this content");
+    }
+    else {
+        EnsureSpeechBackend();
+
+        std::string error;
+        if (!LoadReaderSource(source, error)) {
+            AnnounceProblem("Accessibility reader could not be loaded: " + error);
+            return;
+        }
+        Log(LogLevel::Info, "reader source: " + source.origin + " sha256=" + source.sha256 + " ("
+                            + std::to_string(source.text.size()) + " bytes)");
+    }
+
+    // Main RAM is 4 MiB on a DS and 16 MiB on a DSi (same rule as retro_get_memory_size). The reader was
+    // only ever validated against the DS layout, so the session refuses anything else with a spoken reason.
+    bool dsi = static_cast<ConsoleType>(nds.ConsoleType) == ConsoleType::DSi;
+    if (dsi) {
+        Log(LogLevel::Warn, "console is in DSi mode; the reader's address model has only been validated "
+                            "against the Nintendo DS 4 MiB layout, so it will be refused");
+    }
+    size_t ramSize = dsi ? size_t(nds.MainRAMMaxSize) : kDsMainRamSize;
+    BoundedMemory ram(nds.MainRAM, ramSize);
+    BoundedMemory rom = BoundedMemory::ReadOnly(cart->GetROM(), cart->GetROMLength());
+    const melonDS::NDSHeader& header = cart->GetHeader();
+
+    _session.Attach(reinterpret_cast<const uint8_t*>(&header), sizeof(header), ram, rom, source.text, kChunkName);
+    _attached = true;
+
+    if (_session.Active() && !_sessionConfig.layer.layerEnabled && !_keyboard) {
+        // The reader can still speak, but it can be given no commands: the screens it drives with
+        // synthetic touch (the Musical dress-up, the fly map) would be unreachable, which is a trap worth
+        // naming rather than letting the player discover it in front of a tutorial they cannot pass.
+        Log(LogLevel::Warn, "the reader has no input channel: both the controller layer and the keyboard "
+                            "hotkeys are disabled, so touch-driven screens cannot be operated");
+        _speech.AnnounceProblem("The accessibility reader has no controls: both the controller layer and the "
+                                "keyboard hotkeys are switched off, so touch-only screens cannot be used.",
+                                kAnnouncementGraceFrames);
+    }
+}
+
+void AccessibilityState::OnStateLoaded(melonDS::NDS& nds) noexcept {
+    if (!_attached) return;
+    // The queue describes the state we just threw away; do not let it play over the new one.
+    if (_speech.Sink() && _speech.Sink() != &_logOnlySink) _speech.Stop();
+    _session.Restart("savestate loaded");
+    ApplyTouch(nds, _session.TakeTouchCommand());
+}
+
+void AccessibilityState::Detach(melonDS::NDS* nds) noexcept {
+    _session.Detach();
+    if (nds) ApplyTouch(*nds, _session.TakeTouchCommand());
+    _attached = false;
+    if (_speech.Sink() && _speech.Sink() != &_logOnlySink) {
+        _speech.Stop();
+    }
+}
+
+void AccessibilityState::Shutdown() noexcept {
+    _session.Detach();
+    _attached = false;
+    _speech.SetSink(&_logOnlySink);
+#ifdef _WIN32
+    _prismSink.reset();
+    _prismFailed = false;
+#endif
+}
+
+uint32_t AccessibilityState::PollKeyboardLetters() noexcept {
+    uint32_t letters = 0;
+    for (unsigned i = 0; i < 26; ++i) {
+        if (retro::input_state(0, RETRO_DEVICE_KEYBOARD, 0, RETROK_a + i)) letters |= (1u << i);
+    }
+    return letters;
+}
+
+void AccessibilityState::PreInput(InputPollResult& poll) noexcept {
+    // Unconditional: a problem announced while nothing could be attached still has to be delivered.
+    _speech.Tick();
+    if (_speech.AnnouncementUndeliverable() && !_undeliverableReported) {
+        // Every speech channel refused it. On a frontend without the experimental speak callback this is
+        // the only way left to reach the player, and their own screen reader may read it.
+        _undeliverableReported = true;
+        retro::set_error_message("Accessibility speech is unavailable: no speech backend accepted any output. "
+                                 "Check the melondsds_access folder for prism.dll, or set the Speech Backend option.");
+    }
+    MaybeRecoverSpeech();
+    if (!_attached) return;
+
+    HostInputSnapshot snapshot;
+    snapshot.joypadMask = poll.JoypadButtons;
+    snapshot.pointerPressed = poll.PointerPressed;
+    if (_keyboard && _session.Active()) {
+        snapshot.keyboardLetters = PollKeyboardLetters();
+    }
+
+    FilteredInput filtered = _session.FrameStep(snapshot);
+    // The microphone lives on L3, which ApplyInputLayer has already cleared when the reader blocked it, so
+    // the native microphone cannot fire behind the accessibility layer in either L3 role.
+    poll.JoypadButtons = filtered.joypadMask;
+    poll.SuppressMicrophone = filtered.suppressMicrophone;
+    if (filtered.suppressPointer) {
+        poll.PointerPressed = false;
+    }
+}
+
+void AccessibilityState::ApplyTouch(melonDS::NDS& nds, ReaderSession::TouchCommand command) noexcept {
+    if (!command.apply) return;
+    if (command.down) {
+        nds.TouchScreen(command.x, command.y);
+    }
+    else {
+        nds.ReleaseScreen();
+    }
+}
+
+void AccessibilityState::PostInput(melonDS::NDS& nds) noexcept {
+    if (!_attached) return;
+    ApplyTouch(nds, _session.TakeTouchCommand());
+}
diff --git a/src/libretro/accessibility/accessibility.hpp b/src/libretro/accessibility/accessibility.hpp
new file mode 100644
index 0000000..3aac9fe
--- /dev/null
+++ b/src/libretro/accessibility/accessibility.hpp
@@ -0,0 +1,102 @@
+/*
+    melonDS DS Access: the core-side owner of the reader session, its speech backend and its input hooks.
+
+    Frame order inside CoreState::Run:
+        poll = _inputState.Poll();          raw libretro input
+        _accessibility.PreInput(poll);      step the reader, rewrite the poll (overrides, layer, pointer)
+        _inputState.Update(.., poll);       native lid/mic/layout/touch derive from the filtered poll
+        _inputState.Apply(nds, ..);
+        _accessibility.PostInput(nds);      scripted touch is applied last, so it wins the frame
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "config/types.hpp"
+#include "accessibility/frontend_speech.hpp"
+#include "accessibility/reader_session.hpp"
+#include "accessibility/speech.hpp"
+#ifdef _WIN32
+#include "accessibility/prism_speech.hpp"
+#endif
+
+namespace melonDS {
+    class NDS;
+}
+
+namespace MelonDsDs {
+    struct InputPollResult;
+    class CoreConfig;
+
+    class AccessibilityState {
+    public:
+        AccessibilityState() noexcept;
+        ~AccessibilityState() noexcept;
+        AccessibilityState(const AccessibilityState&) = delete;
+        AccessibilityState& operator=(const AccessibilityState&) = delete;
+
+        /// Mirrors the core options; may switch the speech backend live.
+        void SetConfig(const CoreConfig& config) noexcept;
+
+        /// After the console exists (game load and reset): identify the cartridge and start the reader.
+        void Attach(melonDS::NDS& nds) noexcept;
+
+        /// After a savestate was loaded: the reader restarts from scratch.
+        void OnStateLoaded(melonDS::NDS& nds) noexcept;
+
+        /// On unload: stop the reader and lift any scripted touch while the console still exists.
+        void Detach(melonDS::NDS* nds) noexcept;
+
+        /// On core deinit: release Prism and everything else.
+        void Shutdown() noexcept;
+
+        /// Speaks a fatal configuration error (the text the error screen shows, plus its recovery action)
+        /// immediately and only once. Immediate on purpose: Run() renders that screen and returns before
+        /// PreInput or Tick, so a deferred announcement there could never be delivered.
+        void AnnounceFatalError(std::string_view message, std::string_view recovery) noexcept;
+
+        void PreInput(InputPollResult& poll) noexcept;
+        void PostInput(melonDS::NDS& nds) noexcept;
+
+        [[nodiscard]] bool Attached() const noexcept { return _attached; }
+        [[nodiscard]] const access::ReaderSession& Session() const noexcept { return _session; }
+
+    private:
+        /// Prism's screen-reader backends never reconnect by themselves: the upstream documentation says a
+        /// lost connection needs the instance destroyed and re-created. So after a demotion this tries that,
+        /// at most kMaxSpeechRecoveries times and never more often than kSpeechRecoveryCooldownFrames apart,
+        /// which is a bounded recovery rather than a retry loop.
+        static constexpr unsigned kMaxSpeechRecoveries = 3;
+        static constexpr uint64_t kSpeechRecoveryCooldownFrames = 600;   // ~10 seconds at 60 fps
+
+        void EnsureSpeechBackend() noexcept;
+        void MaybeRecoverSpeech() noexcept;
+        void AnnounceProblem(const std::string& text) noexcept;
+        void ApplyTouch(melonDS::NDS& nds, access::ReaderSession::TouchCommand command) noexcept;
+        uint32_t PollKeyboardLetters() noexcept;
+        static void Log(access::LogLevel level, std::string_view message) noexcept;
+
+        access::LogOnlySpeechSink _logOnlySink;
+        access::FrontendSpeech _frontendSink;
+#ifdef _WIN32
+        std::unique_ptr<access::PrismSpeech> _prismSink;
+        bool _prismFailed = false;
+#endif
+        access::SpeechDispatcher _speech;
+        access::ReaderSession _session;
+        access::SessionConfig _sessionConfig {};
+        AccessSpeechBackend _requestedBackend = AccessSpeechBackend::Frontend;
+        bool _logOnlyEnv = false;
+        bool _keyboard = true;
+        bool _attached = false;
+        bool _degradedAnnounced = false;
+        bool _undeliverableReported = false;
+        bool _fatalErrorAnnounced = false;
+        uint64_t _framesSinceDemotion = 0;
+        unsigned _speechRecoveries = 0;
+    };
+}
diff --git a/src/libretro/accessibility/bounded_memory.hpp b/src/libretro/accessibility/bounded_memory.hpp
new file mode 100644
index 0000000..5d73e30
--- /dev/null
+++ b/src/libretro/accessibility/bounded_memory.hpp
@@ -0,0 +1,89 @@
+/*
+    melonDS DS Access: bounded view over a byte buffer (main RAM, cartridge ROM).
+
+    Every access checks the COMPLETE requested width against the buffer size and either succeeds as a
+    whole or fails without touching anything. The reader's own guard only checks the first byte of an
+    access, so this is the net under it.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace MelonDsDs::access {
+    class BoundedMemory {
+    public:
+        BoundedMemory() noexcept = default;
+
+        BoundedMemory(uint8_t* data, size_t size) noexcept
+            : _data(data), _size(data ? size : 0), _writable(true) {}
+
+        static BoundedMemory ReadOnly(const uint8_t* data, size_t size) noexcept {
+            BoundedMemory m;
+            m._data = const_cast<uint8_t*>(data);
+            m._size = data ? size : 0;
+            m._writable = false;
+            return m;
+        }
+
+        void Rebind(uint8_t* data, size_t size, bool writable) noexcept {
+            _data = data;
+            _size = data ? size : 0;
+            _writable = writable;
+        }
+
+        void Reset() noexcept { Rebind(nullptr, 0, false); }
+
+        [[nodiscard]] size_t Size() const noexcept { return _size; }
+        [[nodiscard]] bool Valid() const noexcept { return _data != nullptr && _size > 0; }
+        [[nodiscard]] bool Writable() const noexcept { return _writable && Valid(); }
+
+        /// True when [offset, offset + width) lies entirely inside the buffer.
+        [[nodiscard]] bool InRange(uint64_t offset, uint64_t width) const noexcept {
+            if (!Valid() || width == 0) return false;
+            if (offset >= _size) return false;
+            return width <= uint64_t(_size) - offset;
+        }
+
+        bool ReadU8(uint64_t offset, uint8_t& out) const noexcept {
+            if (!InRange(offset, 1)) return false;
+            out = _data[offset];
+            return true;
+        }
+
+        bool ReadU16LE(uint64_t offset, uint16_t& out) const noexcept {
+            if (!InRange(offset, 2)) return false;
+            out = uint16_t(_data[offset]) | (uint16_t(_data[offset + 1]) << 8);
+            return true;
+        }
+
+        bool ReadU32LE(uint64_t offset, uint32_t& out) const noexcept {
+            if (!InRange(offset, 4)) return false;
+            out = uint32_t(_data[offset]) | (uint32_t(_data[offset + 1]) << 8)
+                | (uint32_t(_data[offset + 2]) << 16) | (uint32_t(_data[offset + 3]) << 24);
+            return true;
+        }
+
+        /// All-or-nothing copy of `length` bytes.
+        bool ReadBytes(uint64_t offset, size_t length, uint8_t* out) const noexcept {
+            if (length == 0) return Valid();
+            if (!InRange(offset, length)) return false;
+            std::memcpy(out, _data + offset, length);
+            return true;
+        }
+
+        bool WriteU8(uint64_t offset, uint8_t value) noexcept {
+            if (!Writable() || !InRange(offset, 1)) return false;
+            _data[offset] = value;
+            return true;
+        }
+
+    private:
+        uint8_t* _data = nullptr;
+        size_t _size = 0;
+        bool _writable = false;
+    };
+}
diff --git a/src/libretro/accessibility/cart_identity.cpp b/src/libretro/accessibility/cart_identity.cpp
new file mode 100644
index 0000000..125c2a7
--- /dev/null
+++ b/src/libretro/accessibility/cart_identity.cpp
@@ -0,0 +1,45 @@
+/*
+    melonDS DS Access: cartridge identification.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#include "cart_identity.hpp"
+
+#include <cstring>
+
+using namespace MelonDsDs::access;
+
+CartIdentity MelonDsDs::access::ReadCartIdentity(const uint8_t* header, size_t length) noexcept {
+    CartIdentity id;
+    if (!header || length < kHeaderMinLength) return id;
+
+    for (size_t i = 0; i < 4; ++i) {
+        char c = char(header[kGameCodeOffset + i]);
+        // Real game codes are printable ASCII (letters and digits, '#' for homebrew).
+        if (c < 0x20 || c > 0x7E) return id;
+        id.code[i] = c;
+    }
+    id.code[4] = 0;
+    id.revision = header[kRomVersionOffset];
+    id.valid = true;
+    return id;
+}
+
+SupportedGame MelonDsDs::access::ClassifyGame(const CartIdentity& id) noexcept {
+    if (!id.valid) return SupportedGame::None;
+    if (id.revision == 0) {
+        if (std::strncmp(id.code, "IRBO", 4) == 0) return SupportedGame::Black;
+        if (std::strncmp(id.code, "IRAO", 4) == 0) return SupportedGame::White;
+    }
+    if (id.revision == 1 && std::strncmp(id.code, "CPUE", 4) == 0) return SupportedGame::Platinum;
+    return SupportedGame::None;
+}
+
+const char* MelonDsDs::access::GameName(SupportedGame game) noexcept {
+    switch (game) {
+        case SupportedGame::Black: return "black";
+        case SupportedGame::White: return "white";
+        case SupportedGame::Platinum: return "platinum";
+        default: return "none";
+    }
+}
diff --git a/src/libretro/accessibility/cart_identity.hpp b/src/libretro/accessibility/cart_identity.hpp
new file mode 100644
index 0000000..103495c
--- /dev/null
+++ b/src/libretro/accessibility/cart_identity.hpp
@@ -0,0 +1,36 @@
+/*
+    melonDS DS Access: cartridge identification from the real NDS header.
+
+    Pokemon Black/White (IRBO/IRAO) revision 0 and Platinum (CPUE) revision 1 may activate the reader.
+    Other regions/revisions and unimplemented games are refused before any RAM access.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace MelonDsDs::access {
+    enum class SupportedGame {
+        None,
+        Black,
+        White,
+        Platinum,
+    };
+
+    struct CartIdentity {
+        char code[5] = {0, 0, 0, 0, 0};   // 4-character game code, NUL-terminated
+        uint8_t revision = 0;              // NDS header ROMVersion
+        bool valid = false;                // header long enough and code printable
+    };
+
+    /// The NDS header must be at least this long to be identified (game code at 0x0C, ROMVersion at 0x1E).
+    inline constexpr size_t kHeaderMinLength = 0x20;
+    inline constexpr size_t kGameCodeOffset = 0x0C;
+    inline constexpr size_t kRomVersionOffset = 0x1E;
+
+    CartIdentity ReadCartIdentity(const uint8_t* header, size_t length) noexcept;
+    SupportedGame ClassifyGame(const CartIdentity& identity) noexcept;
+    const char* GameName(SupportedGame game) noexcept;
+}
diff --git a/src/libretro/accessibility/env_override.cpp b/src/libretro/accessibility/env_override.cpp
new file mode 100644
index 0000000..e242e44
--- /dev/null
+++ b/src/libretro/accessibility/env_override.cpp
@@ -0,0 +1,44 @@
+/*
+    melonDS DS Access: reading development environment overrides on the host.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#include "env_override.hpp"
+
+#include <cstdlib>
+#include <cstring>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+std::string MelonDsDs::access::EnvironmentValue(const char* name) noexcept {
+    if (!name || !*name) return std::string();
+    try {
+#ifdef _WIN32
+        // The live process environment block, not the CRT's private copy. See the header for why.
+        DWORD needed = GetEnvironmentVariableA(name, nullptr, 0);
+        if (needed == 0) return std::string();   // unset (or empty, which we treat the same way)
+        std::string value(size_t(needed), '\0');
+        DWORD written = GetEnvironmentVariableA(name, value.data(), needed);
+        if (written == 0 || written >= needed) return std::string();
+        value.resize(size_t(written));
+        return value;
+#else
+        const char* value = std::getenv(name);
+        return value ? std::string(value) : std::string();
+#endif
+    }
+    catch (...) {
+        return std::string();
+    }
+}
+
+bool MelonDsDs::access::EnvironmentFlagSet(const char* name) noexcept {
+    std::string value = EnvironmentValue(name);
+    if (value.empty()) return false;
+    return value != "0";
+}
diff --git a/src/libretro/accessibility/env_override.hpp b/src/libretro/accessibility/env_override.hpp
new file mode 100644
index 0000000..6320848
--- /dev/null
+++ b/src/libretro/accessibility/env_override.hpp
@@ -0,0 +1,23 @@
+/*
+    melonDS DS Access: reading development environment overrides on the host.
+
+    This exists because std::getenv is the WRONG API here on Windows. MinGW links msvcrt.dll, whose getenv
+    serves a private copy of the environment that msvcrt snapshots when it first attaches to the process.
+    A host that sets a variable and then LoadLibrary's this core -- which is exactly what the Python
+    validation host does -- updates the process environment block, but msvcrt was already resident with a
+    stale copy, so getenv returns null. Measured: with the variable set from Python before ctypes.CDLL,
+    std::getenv inside the loaded DLL returned null while GetEnvironmentVariableA returned "1".
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#include <string>
+
+namespace MelonDsDs::access {
+    /// Reads `name` from the live process environment. Returns false when unset, empty, or "0".
+    bool EnvironmentFlagSet(const char* name) noexcept;
+
+    /// Raw value of `name` from the live process environment; empty when unset.
+    std::string EnvironmentValue(const char* name) noexcept;
+}
diff --git a/src/libretro/accessibility/frontend_speech.cpp b/src/libretro/accessibility/frontend_speech.cpp
new file mode 100644
index 0000000..defa583
--- /dev/null
+++ b/src/libretro/accessibility/frontend_speech.cpp
@@ -0,0 +1,168 @@
+/*
+    melonDS DS Access: speech through RetroArch's own accessibility backend.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#include "frontend_speech.hpp"
+
+#include <libretro.h>
+
+#include "environment.hpp"
+
+/* The contract this core targets. The fetched libretro-common header may predate either half of it, so
+   both halves are defined here when absent. See native-speech-contract.md. */
+#ifndef RETRO_ENVIRONMENT_ACCESSIBILITY_SPEAK
+#define RETRO_ENVIRONMENT_ACCESSIBILITY_SPEAK (82 | RETRO_ENVIRONMENT_EXPERIMENTAL)
+struct retro_accessibility_speech {
+    const char* text;
+    int priority;
+    const char* channel;
+    unsigned flags;
+};
+#endif
+
+#ifndef RETRO_ENVIRONMENT_GET_ACCESSIBILITY_SPEECH_INTERFACE
+#define RETRO_ENVIRONMENT_GET_ACCESSIBILITY_SPEECH_INTERFACE (83 | RETRO_ENVIRONMENT_EXPERIMENTAL)
+struct retro_accessibility_speech_interface {
+    unsigned size;
+    uint64_t capabilities;
+    const char* backend;
+};
+#endif
+
+#ifndef RETRO_ACCESSIBILITY_SPEECH_FLAG_INTERRUPT
+#define RETRO_ACCESSIBILITY_SPEECH_FLAG_INTERRUPT (1U << 0)
+#define RETRO_ACCESSIBILITY_SPEECH_FLAG_QUEUE     (1U << 1)
+#define RETRO_ACCESSIBILITY_SPEECH_FLAG_STOP      (1U << 2)
+#define RETRO_ACCESSIBILITY_SPEECH_CAP_SPEAK      (1ULL << 0)
+#define RETRO_ACCESSIBILITY_SPEECH_CAP_INTERRUPT  (1ULL << 1)
+#define RETRO_ACCESSIBILITY_SPEECH_CAP_QUEUE      (1ULL << 2)
+#define RETRO_ACCESSIBILITY_SPEECH_CAP_STOP       (1ULL << 3)
+#endif
+
+using namespace MelonDsDs::access;
+
+namespace {
+    /* The pure policy half mirrors these values so it can be tested without libretro. If either side ever
+       moves, this stops the build rather than silently asking for the wrong behaviour. */
+    static_assert(native_speech::kFlagInterrupt == RETRO_ACCESSIBILITY_SPEECH_FLAG_INTERRUPT);
+    static_assert(native_speech::kFlagQueue == RETRO_ACCESSIBILITY_SPEECH_FLAG_QUEUE);
+    static_assert(native_speech::kFlagStop == RETRO_ACCESSIBILITY_SPEECH_FLAG_STOP);
+    static_assert(native_speech::kCapSpeak == RETRO_ACCESSIBILITY_SPEECH_CAP_SPEAK);
+    static_assert(native_speech::kCapInterrupt == RETRO_ACCESSIBILITY_SPEECH_CAP_INTERRUPT);
+    static_assert(native_speech::kCapQueue == RETRO_ACCESSIBILITY_SPEECH_CAP_QUEUE);
+    static_assert(native_speech::kCapStop == RETRO_ACCESSIBILITY_SPEECH_CAP_STOP);
+
+    /* Above the frontend's own "something is already speaking" gate, so legacy requests are not dropped.
+       Flagged requests skip that gate entirely. */
+    constexpr int kGamePriority = 10;
+}
+
+bool FrontendSpeech::ShouldWarn(WarnOnce& state) noexcept {
+    if (state.generation == _capabilityGeneration) return false;   // already said, for these capabilities
+    if (state.emitted >= kMaxWarningsPerKind) return false;        // a flapping backend must not flood
+    state.generation = _capabilityGeneration;
+    ++state.emitted;
+    return true;
+}
+
+void FrontendSpeech::Negotiate() noexcept {
+    NativeSpeechCaps caps;
+    retro_accessibility_speech_interface iface {};
+    iface.size = sizeof(iface);
+
+    if (retro::environment(RETRO_ENVIRONMENT_GET_ACCESSIBILITY_SPEECH_INTERFACE, &iface)) {
+        caps.present = true;
+        caps.bits = iface.capabilities;
+        try {
+            caps.backend = iface.backend ? iface.backend : "";
+        }
+        catch (...) {
+        }
+    }
+
+    // The backend NAME counts as a change even when the bits are identical: nvda giving way to sapi is a
+    // transition the player and the log should both see.
+    bool changed = !_negotiated
+        || caps.present != _caps.present
+        || caps.bits != _caps.bits
+        || caps.backend != _caps.backend;
+    _caps = std::move(caps);
+    _negotiated = true;
+    if (!changed) return;
+
+    ++_capabilityGeneration;
+    if (_capabilityChangeLogs >= kMaxCapabilityChangeLogs) return;
+    ++_capabilityChangeLogs;
+
+    retro::info("[accessibility] native speech: {}", _caps.Describe());
+    if (!_caps.present && ShouldWarn(_legacyWarn)) {
+        retro::warn("[accessibility] this frontend has no speech capability query, so queued lines will "
+                    "interrupt and speech.stop() cannot work. A RetroArch with the accessibility speech "
+                    "extension restores both.");
+    }
+    if (_capabilityChangeLogs == kMaxCapabilityChangeLogs) {
+        retro::info("[accessibility] native speech: the backend has changed {} times; further changes are "
+                    "tracked but no longer logged one by one", kMaxCapabilityChangeLogs);
+    }
+}
+
+bool FrontendSpeech::Dispatch(std::string_view utf8, unsigned flags) noexcept {
+    std::string text;
+    try {
+        text.assign(utf8.data(), utf8.size());
+    }
+    catch (...) {
+        return false;
+    }
+    retro_accessibility_speech request {};
+    request.text = text.c_str();
+    request.priority = kGamePriority;
+    request.channel = "game";
+    request.flags = flags;
+    return retro::environment(RETRO_ENVIRONMENT_ACCESSIBILITY_SPEAK, &request);
+}
+
+bool FrontendSpeech::Say(std::string_view utf8, bool interrupt) noexcept {
+    /* SpeechDispatcher::Deliver has already refreshed by the time it calls this, which is how a narrator
+       switched off mid-session, or an NVDA that has exited, is noticed on the very next line. This only
+       covers a first, direct use of the sink outside the dispatcher. */
+    if (!_negotiated) Negotiate();
+
+    NativeSpeechPlan plan = PlanNativeSay(_caps, interrupt);
+
+    if (!plan.send) {
+        _rejected = true;
+        if (ShouldWarn(_refusalWarn)) {
+            retro::warn("[accessibility] the frontend refused speech: {}", plan.refusal ? plan.refusal : "unknown");
+        }
+        return false;
+    }
+
+    if (plan.degraded && ShouldWarn(_degradedWarn)) {
+        retro::warn("[accessibility] this speech backend ({}) cannot queue, so a queued line interrupts the "
+                    "one before it", _caps.backend.empty() ? "legacy" : _caps.backend);
+    }
+
+    bool ok = Dispatch(utf8, plan.flags);
+    if (ok) _accepted = true; else _rejected = true;
+    return ok;
+}
+
+bool FrontendSpeech::Stop() noexcept {
+    if (!_negotiated) Negotiate();
+
+    NativeSpeechPlan plan = PlanNativeStop(_caps);
+    if (!plan.send) {
+        if (ShouldWarn(_stopWarn)) {
+            retro::warn("[accessibility] speech.stop() cannot be honoured: {}",
+                        plan.refusal ? plan.refusal : "unknown");
+        }
+        return false;
+    }
+
+    /* A stop carries no text by contract; an empty string keeps every frontend's NULL checks happy. */
+    bool ok = Dispatch(std::string_view(), plan.flags);
+    if (!ok) _rejected = true;
+    return ok;
+}
diff --git a/src/libretro/accessibility/frontend_speech.hpp b/src/libretro/accessibility/frontend_speech.hpp
new file mode 100644
index 0000000..8683ed0
--- /dev/null
+++ b/src/libretro/accessibility/frontend_speech.hpp
@@ -0,0 +1,84 @@
+/*
+    melonDS DS Access: speech through RetroArch's own accessibility backend.
+
+    This is now the DEFAULT and only speech path the core ships with. It asks
+    RETRO_ENVIRONMENT_GET_ACCESSIBILITY_SPEECH_INTERFACE at every request boundary and then requests exactly
+    the behaviours the frontend said it can honour RIGHT NOW: interrupt, queue, and stop. Capabilities are
+    not cached for the session, because they genuinely change mid-session -- the user switches the narrator
+    off, NVDA exits and RetroArch falls back to SAPI or PowerShell -- and a queue that was real an hour ago
+    must not still be claimed. A frontend without the extension answers false to the query, and the core
+    then behaves exactly as it always did -- flags 0, interrupt only, no stop -- so an old RetroArch can
+    never be mistaken for one that queues.
+
+    Contract: C:\RetroArch-Win64\dev\pokemon-ds-accessibility\native-speech-contract.md
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "native_speech.hpp"
+#include "speech.hpp"
+
+namespace MelonDsDs::access {
+    class FrontendSpeech final : public SpeechSink {
+    public:
+        FrontendSpeech() noexcept = default;
+
+        /// Asks the frontend what it can do. Cheap, has no side effect other than letting the frontend
+        /// initialise its backend, and is meant to be called again: capabilities change when the user
+        /// toggles the narrator or the frontend falls back from one backend to another.
+        void Negotiate() noexcept;
+        [[nodiscard]] const NativeSpeechCaps& Caps() const noexcept { return _caps; }
+        [[nodiscard]] bool Negotiated() const noexcept { return _negotiated; }
+
+        bool Say(std::string_view utf8, bool interrupt) noexcept override;
+        bool Stop() noexcept override;
+        /// Deliberately the bare word: the log format and the validation host both key on it.
+        [[nodiscard]] const char* Name() const noexcept override { return "frontend"; }
+        /// The dispatcher calls this at the start of every request, before it reads SupportsQueue() and
+        /// before Say()/Stop(). That single call is what keeps the flags asked for and the line written to
+        /// the log describing the same, current backend.
+        void RefreshCapabilities() noexcept override { Negotiate(); }
+        /// Truthful, and current, so the dispatcher's "degraded" logging means something.
+        [[nodiscard]] bool SupportsQueue() const noexcept override { return _caps.CanQueue(); }
+
+        /// True once the frontend has accepted at least one request (it may reject all of them).
+        [[nodiscard]] bool Accepted() const noexcept { return _accepted; }
+        [[nodiscard]] bool Rejected() const noexcept { return _rejected; }
+
+    private:
+        /// Asking every request means the log has to be bounded explicitly. A warning of each kind is
+        /// emitted at most once per capability change, and at most this many times in a session, so a
+        /// screen reader that restarts in a loop cannot bury the rest of the log.
+        static constexpr unsigned kMaxWarningsPerKind = 4;
+        /// Capability transitions themselves are logged at most this many times, for the same reason. The
+        /// state is always tracked; only the log is capped.
+        static constexpr unsigned kMaxCapabilityChangeLogs = 8;
+
+        struct WarnOnce {
+            unsigned emitted = 0;
+            uint32_t generation = UINT32_MAX;   // never equal to a real generation, so the first one speaks
+        };
+
+        bool Dispatch(std::string_view utf8, unsigned flags) noexcept;
+        /// True when this kind of warning has not been given for the capabilities now in force and the
+        /// session budget for it is not spent.
+        bool ShouldWarn(WarnOnce& state) noexcept;
+
+        NativeSpeechCaps _caps;
+        bool _negotiated = false;
+        bool _accepted = false;
+        bool _rejected = false;
+        /// Bumped whenever the frontend reports something different; the warnings key off it.
+        uint32_t _capabilityGeneration = 0;
+        unsigned _capabilityChangeLogs = 0;
+        WarnOnce _legacyWarn;
+        WarnOnce _stopWarn;
+        WarnOnce _refusalWarn;
+        WarnOnce _degradedWarn;
+    };
+}
diff --git a/src/libretro/accessibility/host_input.cpp b/src/libretro/accessibility/host_input.cpp
new file mode 100644
index 0000000..baefe6d
--- /dev/null
+++ b/src/libretro/accessibility/host_input.cpp
@@ -0,0 +1,202 @@
+/*
+    melonDS DS Access: input naming, overrides and the controller layer.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#include "host_input.hpp"
+
+#include <cstring>
+
+using namespace MelonDsDs::access;
+
+namespace {
+    constexpr const char* kDsButtonNames[kDsButtonCount] = {
+        "Up", "Down", "Left", "Right", "Start", "Select", "B", "A", "Y", "X", "L", "R",
+        "LidOpen", "LidClose", "Touch", "Microphone", "Power",
+    };
+
+    // SDL normalises every pad to the Xbox 360 layout; BizHawk names them with an "X1 " prefix.
+    // libretro: B = bottom, A = right, Y = left, X = top. SDL: A = bottom, B = right, X = left, Y = top.
+    constexpr const char* kHostPadNames[retro_id::COUNT] = {
+        "X1 A",             // retro B (bottom)
+        "X1 X",             // retro Y (left)
+        "X1 Back",          // Select
+        "X1 Start",         // Start
+        "X1 DpadUp",
+        "X1 DpadDown",
+        "X1 DpadLeft",
+        "X1 DpadRight",
+        "X1 B",             // retro A (right)
+        "X1 Y",             // retro X (top)
+        "X1 LeftShoulder",  // L
+        "X1 RightShoulder", // R
+        "X1 LeftTrigger",   // L2
+        "X1 RightTrigger",  // R2
+        "X1 LeftThumb",     // L3
+        "X1 RightThumb",    // R3
+    };
+
+    constexpr uint16_t kMaxTouchX = 255;
+    constexpr uint16_t kMaxTouchY = 191;
+}
+
+const char* MelonDsDs::access::DsButtonName(DsButton button) noexcept {
+    size_t i = size_t(button);
+    return i < kDsButtonCount ? kDsButtonNames[i] : nullptr;
+}
+
+std::optional<DsButton> MelonDsDs::access::DsButtonFromName(std::string_view name) noexcept {
+    for (size_t i = 0; i < kDsButtonCount; ++i) {
+        if (name == kDsButtonNames[i]) return DsButton(i);
+    }
+    return std::nullopt;
+}
+
+std::optional<unsigned> MelonDsDs::access::RetroIdForDsButton(DsButton button) noexcept {
+    switch (button) {
+        case DsButton::Up: return retro_id::UP;
+        case DsButton::Down: return retro_id::DOWN;
+        case DsButton::Left: return retro_id::LEFT;
+        case DsButton::Right: return retro_id::RIGHT;
+        case DsButton::Start: return retro_id::START;
+        case DsButton::Select: return retro_id::SELECT;
+        case DsButton::B: return retro_id::B;
+        case DsButton::A: return retro_id::A;
+        case DsButton::Y: return retro_id::Y;
+        case DsButton::X: return retro_id::X;
+        case DsButton::L: return retro_id::L;
+        case DsButton::R: return retro_id::R;
+        default: return std::nullopt;
+    }
+}
+
+const char* MelonDsDs::access::HostPadName(unsigned retroId) noexcept {
+    return retroId < retro_id::COUNT ? kHostPadNames[retroId] : nullptr;
+}
+
+bool InputOverrides::Any() const noexcept {
+    if (mnemonic.active) return true;
+    for (int8_t b : buttons) {
+        if (b >= 0) return true;
+    }
+    return false;
+}
+
+namespace {
+    bool ParseUnsignedField(std::string_view field, uint32_t& out) noexcept {
+        // Empty means neutral (0). Digits only; a leading '-' yields 0 (touch axes are never negative).
+        out = 0;
+        if (field.empty()) return true;
+        size_t i = 0;
+        bool negative = false;
+        if (field[0] == '-' || field[0] == '+') {
+            negative = field[0] == '-';
+            i = 1;
+        }
+        if (i >= field.size()) return false;
+        uint32_t value = 0;
+        for (; i < field.size(); ++i) {
+            char c = field[i];
+            if (c < '0' || c > '9') return false;
+            value = value * 10 + uint32_t(c - '0');
+            if (value > 100000) return false;
+        }
+        out = negative ? 0 : value;
+        return true;
+    }
+}
+
+std::optional<MnemonicState> MelonDsDs::access::ParseMnemonic(std::string_view mnemonic) noexcept {
+    if (mnemonic.size() < 2 || mnemonic.front() != '|' || mnemonic.back() != '|') return std::nullopt;
+    std::string_view body = mnemonic.substr(1, mnemonic.size() - 2);
+
+    // Four axis fields terminated by commas, then the button characters.
+    uint32_t axes[4] = {0, 0, 0, 0};
+    for (uint32_t& axis : axes) {
+        size_t comma = body.find(',');
+        if (comma == std::string_view::npos) return std::nullopt;
+        if (!ParseUnsignedField(body.substr(0, comma), axis)) return std::nullopt;
+        body.remove_prefix(comma + 1);
+    }
+    if (body.size() != kDsButtonCount) return std::nullopt;
+
+    MnemonicState state;
+    state.active = true;
+    for (size_t i = 0; i < kDsButtonCount; ++i) {
+        if (body[i] != '.') state.pressed |= (1u << i);
+    }
+    state.touchDown = (state.pressed >> unsigned(DsButton::Touch)) & 1u;
+    state.x = uint16_t(axes[0] > kMaxTouchX ? kMaxTouchX : axes[0]);
+    state.y = uint16_t(axes[1] > kMaxTouchY ? kMaxTouchY : axes[1]);
+    return state;
+}
+
+FilteredInput MelonDsDs::access::ApplyInputLayer(const HostInputSnapshot& raw, const InputOverrides& overrides,
+                                                  const LayerConfig& config) noexcept {
+    FilteredInput out;
+    uint32_t mask = raw.joypadMask;
+
+    for (size_t i = 0; i < kDsButtonCount; ++i) {
+        DsButton button = DsButton(i);
+        std::optional<unsigned> id = RetroIdForDsButton(button);
+        if (!id) continue;
+        uint32_t bit = 1u << *id;
+        if (overrides.mnemonic.active) {
+            // A mnemonic sets EVERY button; the player's own presses are suppressed for that frame.
+            if ((overrides.mnemonic.pressed >> i) & 1u) mask |= bit; else mask &= ~bit;
+        }
+        else if (overrides.buttons[i] == 0) {
+            mask &= ~bit;
+        }
+        else if (overrides.buttons[i] == 1) {
+            mask |= bit;
+        }
+    }
+
+    if (overrides.mnemonic.active) {
+        out.suppressPointer = true;
+        out.touchOverride = true;
+        out.touchDown = overrides.mnemonic.touchDown;
+        out.touchX = overrides.mnemonic.x;
+        out.touchY = overrides.mnemonic.y;
+    }
+    else if (overrides.buttons[size_t(DsButton::Touch)] == 0) {
+        out.suppressPointer = true;
+    }
+
+    // The reader asks the core for its whole button list and holds EVERY one of them shut while its layer
+    // is active, which includes "Microphone". That button is not a DS key, so the loop above cannot honour
+    // it; the core derives its microphone from L3, so releasing the microphone means clearing that bit.
+    // Without this the native microphone fires from L3 throughout the accessibility layer whenever the L3
+    // role is "microphone" (in the accessibility role the layer consumes L3 anyway).
+    // Only an EXPLICIT block counts. A mnemonic sets every character, so its released '.' for Microphone
+    // would otherwise mute the microphone during any scripted touch gesture -- including gestures a player
+    // drives from the keyboard with the controller layer switched off, where the reader owns nothing.
+    bool microphoneReleased = overrides.buttons[size_t(DsButton::Microphone)] == 0;
+    if (microphoneReleased) {
+        out.suppressMicrophone = true;
+        mask &= ~(1u << retro_id::L3);
+    }
+    // LidOpen/LidClose and Power have no libretro button of their own: the core's lid toggle is the L2+Y
+    // chord, and L2 is already consumed whenever the layer is active, so a lid block needs nothing here.
+
+    if (config.layerEnabled) {
+        mask &= ~((1u << retro_id::L2) | (1u << retro_id::R2));
+        if (config.consumeL3) mask &= ~(1u << retro_id::L3);
+    }
+
+    out.joypadMask = mask;
+    return out;
+}
+
+uint32_t MelonDsDs::access::HostVisibleMask(uint32_t joypadMask, const LayerConfig& config) noexcept {
+    uint32_t mask = joypadMask;
+    if (!config.layerEnabled) {
+        // The whole accessibility controller layer is off: its three buttons belong to the core.
+        mask &= ~((1u << retro_id::L2) | (1u << retro_id::R2) | (1u << retro_id::L3));
+    }
+    else if (!config.consumeL3) {
+        mask &= ~(1u << retro_id::L3);
+    }
+    return mask;
+}
diff --git a/src/libretro/accessibility/host_input.hpp b/src/libretro/accessibility/host_input.hpp
new file mode 100644
index 0000000..5d67044
--- /dev/null
+++ b/src/libretro/accessibility/host_input.hpp
@@ -0,0 +1,116 @@
+/*
+    melonDS DS Access: input naming, overrides and the controller layer.
+
+    The reader was written against BizHawk: it reads raw host inputs by name ("X1 LeftTrigger", "R"),
+    blocks DS buttons by name ("Up", "A", "Touch") and drives the touch screen with movie mnemonics.
+    This module is the pure translation between those names and libretro's joypad bitmask.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+namespace MelonDsDs::access {
+    /// libretro joypad ids (numerically identical to RETRO_DEVICE_ID_JOYPAD_*; checked in the core glue).
+    namespace retro_id {
+        inline constexpr unsigned B = 0;
+        inline constexpr unsigned Y = 1;
+        inline constexpr unsigned SELECT = 2;
+        inline constexpr unsigned START = 3;
+        inline constexpr unsigned UP = 4;
+        inline constexpr unsigned DOWN = 5;
+        inline constexpr unsigned LEFT = 6;
+        inline constexpr unsigned RIGHT = 7;
+        inline constexpr unsigned A = 8;
+        inline constexpr unsigned X = 9;
+        inline constexpr unsigned L = 10;
+        inline constexpr unsigned R = 11;
+        inline constexpr unsigned L2 = 12;
+        inline constexpr unsigned R2 = 13;
+        inline constexpr unsigned L3 = 14;
+        inline constexpr unsigned R3 = 15;
+        inline constexpr unsigned COUNT = 16;
+    }
+
+    /// DS buttons in the order BizHawk's melonDS core defines them (this is also the mnemonic order).
+    enum class DsButton : uint8_t {
+        Up, Down, Left, Right, Start, Select, B, A, Y, X, L, R, LidOpen, LidClose, Touch, Microphone, Power,
+        Count
+    };
+    inline constexpr size_t kDsButtonCount = size_t(DsButton::Count);
+
+    const char* DsButtonName(DsButton button) noexcept;
+    std::optional<DsButton> DsButtonFromName(std::string_view name) noexcept;
+    /// libretro id for the twelve real DS buttons; nullopt for lid/touch/mic/power.
+    std::optional<unsigned> RetroIdForDsButton(DsButton button) noexcept;
+
+    /// BizHawk/SDL host name for a libretro joypad id ("X1 " prefix, Xbox layout: SDL Y is the top face
+    /// button, which libretro calls X). nullptr for ids >= 16.
+    const char* HostPadName(unsigned retroId) noexcept;
+
+    /// Physical state gathered by the core for one frame, before any override.
+    struct HostInputSnapshot {
+        uint32_t joypadMask = 0;        // bit i = libretro joypad id i held
+        uint32_t keyboardLetters = 0;   // bit i = letter 'A' + i held
+        bool pointerPressed = false;    // native touch (mouse/pointer) held
+    };
+
+    struct LayerConfig {
+        bool layerEnabled = true;   // consume L2/R2 for the accessibility layer
+        bool consumeL3 = true;      // consume L3 too (accessibility role) instead of leaving it to the microphone
+    };
+
+    /// A parsed movie mnemonic: |TouchX,TouchY,MicVolume,GBALightSensor,<17 button characters>|
+    struct MnemonicState {
+        bool active = false;
+        bool touchDown = false;
+        uint16_t x = 0;
+        uint16_t y = 0;
+        uint32_t pressed = 0;   // bit i = DsButton i pressed by the mnemonic ('.' = released)
+    };
+
+    std::optional<MnemonicState> ParseMnemonic(std::string_view mnemonic) noexcept;
+
+    /// What the reader asked for during the current frame. Wiped every frame, like BizHawk's overrides.
+    struct InputOverrides {
+        std::array<int8_t, kDsButtonCount> buttons {};   // -1 untouched, 0 force released, 1 force pressed
+        MnemonicState mnemonic {};
+
+        InputOverrides() noexcept { Clear(); }
+        void Clear() noexcept {
+            buttons.fill(-1);
+            mnemonic = MnemonicState {};
+        }
+        [[nodiscard]] bool Any() const noexcept;
+    };
+
+    /// The poll the core should continue with.
+    struct FilteredInput {
+        uint32_t joypadMask = 0;
+        bool suppressPointer = false;      // hide the native touch this frame
+        bool suppressMicrophone = false;   // the reader is holding the microphone button shut
+        bool touchOverride = false;        // the reader drives the touch screen this frame
+        bool touchDown = false;
+        uint16_t touchX = 0;
+        uint16_t touchY = 0;
+    };
+
+    FilteredInput ApplyInputLayer(const HostInputSnapshot& raw, const InputOverrides& overrides,
+                                  const LayerConfig& config) noexcept;
+
+    /// The pad state the Lua reader is allowed to SEE through input.get().
+    ///
+    /// Hiding a button here is what actually turns the reader's own controller layer off: the reader keys
+    /// its layer on the host trigger NAMES, so if it can still see them it keeps blocking DS buttons no
+    /// matter what the core does with the bits afterwards. Physical state for the reader's release latch
+    /// comes from joypad.getimmediate(), which reads the unfiltered mask, so latching still works.
+    ///   * layer disabled  -> L2, R2 and L3 are hidden; the core keeps all of its own shortcuts.
+    ///   * microphone role -> L3 is hidden, as the option help promises.
+    ///   * R3 is never hidden: it is the frontend's screen-layout key, which the reader never uses.
+    uint32_t HostVisibleMask(uint32_t joypadMask, const LayerConfig& config) noexcept;
+}
diff --git a/src/libretro/accessibility/lua_reader.cpp b/src/libretro/accessibility/lua_reader.cpp
new file mode 100644
index 0000000..8ee6c64
--- /dev/null
+++ b/src/libretro/accessibility/lua_reader.cpp
@@ -0,0 +1,647 @@
+/*
+    melonDS DS Access: Lua 5.4 host for the Pokemon Black/White reader.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#include "lua_reader.hpp"
+
+#include <cmath>
+#include <cstring>
+#include <ctime>
+
+#include <lua.hpp>
+
+using namespace MelonDsDs::access;
+
+namespace {
+    constexpr const char* kAxisNames[] = {"Touch X", "Touch Y", "Mic Volume", "GBA Light Sensor"};
+
+    std::string FirstLine(std::string_view text, size_t limit = 240) {
+        size_t end = text.find('\n');
+        std::string_view line = text.substr(0, end == std::string_view::npos ? text.size() : end);
+        if (line.size() > limit) line = line.substr(0, limit);
+        return std::string(line);
+    }
+
+    bool EqualsIgnoreCase(std::string_view a, const char* b) noexcept {
+        size_t n = std::strlen(b);
+        if (a.size() != n) return false;
+        for (size_t i = 0; i < n; ++i) {
+            char x = a[i], y = b[i];
+            if (x >= 'a' && x <= 'z') x = char(x - 'a' + 'A');
+            if (y >= 'a' && y <= 'z') y = char(y - 'a' + 'A');
+            if (x != y) return false;
+        }
+        return true;
+    }
+}
+
+LuaReader::LuaReader(ReaderHost host) noexcept : _host(std::move(host)) {}
+
+LuaReader::~LuaReader() noexcept {
+    Close();
+}
+
+void LuaReader::Close() noexcept {
+    static_assert(kNoRef == LUA_NOREF, "kNoRef must match Lua's LUA_NOREF");
+    if (_L) {
+        lua_close(_L);
+        _L = nullptr;
+        _co = nullptr;
+        _coRef = kNoRef;
+        _chunkRef = kNoRef;
+    }
+    _overrides.Clear();
+    if (_status == Status::Running) _status = Status::NotLoaded;
+}
+
+void LuaReader::Log(LogLevel level, std::string_view message) const noexcept {
+    if (!_host.log) return;
+    try {
+        _host.log(level, message);
+    }
+    catch (...) {
+    }
+}
+
+LuaReader& LuaReader::Self(lua_State* L) noexcept {
+    return *static_cast<LuaReader*>(lua_touserdata(L, lua_upvalueindex(1)));
+}
+
+int LuaReader::L_panic(lua_State* L) {
+    const char* msg = lua_tostring(L, -1);
+    // Only reached for errors raised outside any protected call; Lua aborts after this returns.
+    std::fprintf(stderr, "melonDS DS Access: Lua panic: %s\n", msg ? msg : "(no message)");
+    return 0;
+}
+
+bool LuaReader::ArgToU64(lua_State* L, int index, uint64_t& out) noexcept {
+    int isnum = 0;
+    lua_Integer v = lua_tointegerx(L, index, &isnum);
+    if (!isnum) {
+        if (lua_type(L, index) != LUA_TNUMBER) return false;
+        lua_Number d = lua_tonumber(L, index);
+        if (std::isnan(d) || d < 0 || d > 9.0e15) return false;
+        v = lua_Integer(std::floor(d));
+    }
+    if (v < 0) return false;
+    out = uint64_t(v);
+    return true;
+}
+
+BoundedMemory* LuaReader::DomainFor(lua_State* L, int index) const noexcept {
+    if (lua_type(L, index) == LUA_TSTRING) {
+        size_t len = 0;
+        const char* s = lua_tolstring(L, index, &len);
+        if (s && EqualsIgnoreCase(std::string_view(s, len), "ROM")) return _host.rom;
+    }
+    return _host.mainRam;
+}
+
+void LuaReader::NoteViolation(const char* op, uint64_t offset, uint64_t width, const BoundedMemory* domain) noexcept {
+    ++_violations;
+    if (_violations <= kBoundsLogLimit || _violations % 1000 == 0) {
+        char buf[200];
+        std::snprintf(buf, sizeof(buf),
+                      "ram bounds: %s offset=0x%llx width=%llu size=0x%zx (violation #%llu)",
+                      op, (unsigned long long) offset, (unsigned long long) width,
+                      domain ? domain->Size() : size_t(0), (unsigned long long) _violations);
+        Log(LogLevel::Warn, buf);
+    }
+}
+
+void LuaReader::RegisterTable(const char* name, const void* funcs) noexcept {
+    lua_newtable(_L);
+    lua_pushlightuserdata(_L, this);
+    luaL_setfuncs(_L, static_cast<const luaL_Reg*>(funcs), 1);
+    lua_setglobal(_L, name);
+}
+
+void LuaReader::RegisterApi() noexcept {
+    static const luaL_Reg mainmemory[] = {
+        {"read_u8", L_mm_read_u8},
+        {"read_u16_le", L_mm_read_u16},
+        {"read_u32_le", L_mm_read_u32},
+        {"write_u8", L_mm_write_u8},
+        {"read_bytes_as_array", L_mm_read_bytes},
+        {nullptr, nullptr},
+    };
+    static const luaL_Reg memory[] = {
+        {"read_u8", L_mem_read_u8},
+        {"read_u16_le", L_mem_read_u16},
+        {"read_u32_le", L_mem_read_u32},
+        {"getmemorydomainlist", L_mem_getmemorydomainlist},
+        {"getmemorydomainsize", L_mem_getmemorydomainsize},
+        {nullptr, nullptr},
+    };
+    static const luaL_Reg emu[] = {
+        {"framecount", L_emu_framecount},
+        {"frameadvance", L_emu_frameadvance},
+        {nullptr, nullptr},
+    };
+    static const luaL_Reg joypad[] = {
+        {"getimmediate", L_joypad_getimmediate},
+        {"set", L_joypad_set},
+        {"setfrommnemonicstr", L_joypad_setfrommnemonicstr},
+        {"setanalog", L_joypad_setanalog},
+        {nullptr, nullptr},
+    };
+    static const luaL_Reg input[] = {
+        {"get", L_input_get},
+        {nullptr, nullptr},
+    };
+    static const luaL_Reg console[] = {
+        {"writeline", L_console_write},
+        {"log", L_console_write},
+        {"write", L_console_write},
+        {nullptr, nullptr},
+    };
+    static const luaL_Reg gameinfo[] = {
+        {"getromname", L_gameinfo_getromname},
+        {nullptr, nullptr},
+    };
+    static const luaL_Reg speech[] = {
+        {"say", L_speech_say},
+        {"output", L_speech_say},
+        {"stop", L_speech_stop},
+        {"braille", L_speech_braille},
+        {nullptr, nullptr},
+    };
+    static const luaL_Reg os[] = {
+        {"clock", L_os_clock},
+        {nullptr, nullptr},
+    };
+
+    RegisterTable("mainmemory", mainmemory);
+    RegisterTable("memory", memory);
+    RegisterTable("emu", emu);
+    RegisterTable("joypad", joypad);
+    RegisterTable("input", input);
+    RegisterTable("console", console);
+    RegisterTable("gameinfo", gameinfo);
+    RegisterTable("speech", speech);
+    RegisterTable("os", os);
+
+    lua_pushlightuserdata(_L, this);
+    lua_pushcclosure(_L, L_console_write, 1);
+    lua_setglobal(_L, "print");
+}
+
+bool LuaReader::Load(std::string_view source, std::string_view chunkName) noexcept {
+    Close();
+    _status = Status::NotLoaded;
+    _error.clear();
+    _frame = 0;
+    _violations = 0;
+    _writes = 0;
+
+    _L = luaL_newstate();
+    if (!_L) {
+        Fail("could not create the Lua state (out of memory)");
+        return false;
+    }
+    lua_atpanic(_L, L_panic);
+
+    static const luaL_Reg safeLibs[] = {
+        {LUA_GNAME, luaopen_base},
+        {LUA_COLIBNAME, luaopen_coroutine},
+        {LUA_TABLIBNAME, luaopen_table},
+        {LUA_STRLIBNAME, luaopen_string},
+        {LUA_MATHLIBNAME, luaopen_math},
+        {LUA_UTF8LIBNAME, luaopen_utf8},
+        {nullptr, nullptr},
+    };
+    for (const luaL_Reg* lib = safeLibs; lib->func; ++lib) {
+        luaL_requiref(_L, lib->name, lib->func, 1);
+        lua_pop(_L, 1);
+    }
+    // Base-library entry points that reach the file system are removed.
+    lua_pushnil(_L);
+    lua_setglobal(_L, "dofile");
+    lua_pushnil(_L);
+    lua_setglobal(_L, "loadfile");
+
+    RegisterApi();
+
+    // Compiled ONCE and kept in the registry; Restart() re-calls it on a fresh coroutine.
+    std::string name = "=";
+    name.append(chunkName);
+    int rc = luaL_loadbufferx(_L, source.data(), source.size(), name.c_str(), "t");
+    if (rc != LUA_OK) {
+        const char* msg = lua_tostring(_L, -1);
+        std::string text = "reader failed to compile: ";
+        text += msg ? msg : "(no message)";
+        lua_settop(_L, 0);
+        Fail(std::move(text));
+        return false;
+    }
+    _chunkRef = luaL_ref(_L, LUA_REGISTRYINDEX);   // pops the compiled chunk
+
+    return Restart();
+}
+
+bool LuaReader::Restart() noexcept {
+    if (!CanRestart()) return false;
+
+    if (_coRef != kNoRef) {
+        luaL_unref(_L, LUA_REGISTRYINDEX, _coRef);   // the old coroutine becomes collectable
+        _coRef = kNoRef;
+        _co = nullptr;
+    }
+
+    _co = lua_newthread(_L);
+    _coRef = luaL_ref(_L, LUA_REGISTRYINDEX);        // pops the thread, keeps it alive
+    lua_rawgeti(_L, LUA_REGISTRYINDEX, _chunkRef);   // the compiled chunk...
+    lua_xmove(_L, _co, 1);                           // ...becomes the new coroutine's body
+
+    _status = Status::Running;
+    _error.clear();
+    _frame = 0;
+    _violations = 0;
+    _writes = 0;
+    _overrides.Clear();
+    _snapshot = HostInputSnapshot {};
+    lua_gc(_L, LUA_GCCOLLECT, 0);                    // drop the previous run's tables now, not later
+    return true;
+}
+
+LuaReader::Status LuaReader::StepFrame(const HostInputSnapshot& snapshot, const LayerConfig& layer) noexcept {
+    if (_status != Status::Running || !_co) return _status;
+
+    _overrides.Clear();
+    _snapshot = snapshot;
+    _layer = layer;
+
+    int nresults = 0;
+    int rc = lua_resume(_co, _L, 0, &nresults);
+    if (rc == LUA_YIELD) {
+        lua_pop(_co, nresults);
+        ++_frame;
+        return _status;
+    }
+    if (rc == LUA_OK) {
+        lua_settop(_co, 0);
+        ++_frame;
+        Finish();
+        return _status;
+    }
+
+    const char* msg = lua_tostring(_co, -1);
+    std::string text = msg ? msg : "(non-string error object)";
+    luaL_traceback(_L, _co, text.c_str(), 0);
+    const char* tb = lua_tostring(_L, -1);
+    std::string full = tb ? tb : text;
+    lua_pop(_L, 1);
+    lua_settop(_co, 0);
+    Fail(std::move(full));
+    return _status;
+}
+
+void LuaReader::Fail(std::string message) noexcept {
+    _status = Status::Failed;
+    _error = std::move(message);
+    _overrides.Clear();
+    Log(LogLevel::Error, "reader stopped: " + _error);
+    if (_host.speech) {
+        _host.speech->Say("Accessibility reader stopped. " + FirstLine(_error), true);
+    }
+}
+
+void LuaReader::Finish() noexcept {
+    _status = Status::Finished;
+    _error = "reader chunk returned instead of looping";
+    _overrides.Clear();
+    Log(LogLevel::Warn, "reader finished: " + _error);
+    if (_host.speech) {
+        _host.speech->Say("Accessibility reader finished unexpectedly.", true);
+    }
+}
