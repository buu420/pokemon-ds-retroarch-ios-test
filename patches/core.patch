+        nullptr,
+        config::accessibility::CATEGORY,
+        {
+            {MelonDsDs::config::values::ENABLED, "Enabled"},
+            {MelonDsDs::config::values::DISABLED, "Disabled"},
+            {nullptr, nullptr},
+        },
+        MelonDsDs::config::values::ENABLED
+    };
