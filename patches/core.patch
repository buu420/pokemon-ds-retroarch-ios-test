diff --git a/test/accessibility/test_main.cpp b/test/accessibility/test_main.cpp
new file mode 100644
index 0000000..02ad718
--- /dev/null
+++ b/test/accessibility/test_main.cpp
@@ -0,0 +1,43 @@
+#include "harness.hpp"
+
+#include <cstring>
+
+int main(int argc, char** argv) {
+    const char* filter = nullptr;
+    for (int i = 1; i < argc; ++i) {
+        if (std::strcmp(argv[i], "--filter") == 0 && i + 1 < argc) filter = argv[++i];
+    }
+
+    int passed = 0, failed = 0, skipped = 0, filtered = 0;
+    for (const testing::Case& test : testing::Registry()) {
+        if (filter && std::strstr(test.name, filter) == nullptr) {
+            ++filtered;
+            continue;
+        }
+        try {
+            test.fn();
+            std::printf("PASS  %s\n", test.name);
+            ++passed;
+        }
+        catch (const testing::Skipped& s) {
+            // Never counted as a pass: an absent optional dependency must not look like coverage.
+            std::printf("SKIP  %s\n      %s\n", test.name, s.what());
+            ++skipped;
+        }
+        catch (const testing::Failure& f) {
+            std::printf("FAIL  %s\n      %s\n", test.name, f.what());
+            ++failed;
+        }
+        catch (const std::exception& e) {
+            std::printf("FAIL  %s\n      unexpected exception: %s\n", test.name, e.what());
+            ++failed;
+        }
+        catch (...) {
+            std::printf("FAIL  %s\n      unexpected non-standard exception\n", test.name);
+            ++failed;
+        }
+        std::fflush(stdout);
+    }
+    std::printf("\n%d passed, %d failed, %d skipped, %d filtered out\n", passed, failed, skipped, filtered);
+    return failed == 0 ? 0 : 1;
+}
diff --git a/test/accessibility/test_native_speech.cpp b/test/accessibility/test_native_speech.cpp
new file mode 100644
index 0000000..ee5bb65
--- /dev/null
+++ b/test/accessibility/test_native_speech.cpp
@@ -0,0 +1,346 @@
+// RetroArch's native speech extension: capability negotiation, and the queue / interrupt / stop dispatch
+// that the Pokemon reader has always expressed in Lua but that the frontend could not previously honour.
+//
+// The policy half lives in native_speech.hpp precisely so it can be regression-tested without a frontend.
+// frontend_speech.cpp is the thin part that makes the environment calls; it static_asserts the constants
+// below against the real libretro.h values, so the two halves cannot drift apart.
+//
+// Contract: C:\RetroArch-Win64\dev\pokemon-ds-accessibility\native-speech-contract.md
+#include "harness.hpp"
+
+#include <string>
+#include <vector>
+
+#include "accessibility/native_speech.hpp"
+#include "accessibility/speech.hpp"
+
+using namespace MelonDsDs::access;
+
+TEST_CASE(native_speech_flag_and_capability_values_match_the_published_contract) {
+    // Pinned numerically: these cross a process boundary into RetroArch, so a silent renumbering on either
+    // side would ask a frontend for the wrong behaviour without any build error.
+    REQUIRE_EQ(native_speech::kFlagInterrupt, 1u);
+    REQUIRE_EQ(native_speech::kFlagQueue, 2u);
+    REQUIRE_EQ(native_speech::kFlagStop, 4u);
+    REQUIRE_EQ(native_speech::kCapSpeak, uint64_t(1));
+    REQUIRE_EQ(native_speech::kCapInterrupt, uint64_t(2));
+    REQUIRE_EQ(native_speech::kCapQueue, uint64_t(4));
+    REQUIRE_EQ(native_speech::kCapStop, uint64_t(8));
+}
+
+TEST_CASE(native_speech_an_old_frontend_is_never_treated_as_capable) {
+    // A frontend without the extension answers false to the capability query. The core must then behave
+    // exactly as it always has: flags 0, and stop refused rather than claimed.
+    NativeSpeechCaps caps;                       // present == false
+    REQUIRE(!caps.CanSpeak());
+    REQUIRE(!caps.CanInterrupt());
+    REQUIRE(!caps.CanQueue());
+    REQUIRE(!caps.CanStop());
+
+    NativeSpeechPlan say = PlanNativeSay(caps, true);
+    REQUIRE(say.send);
+    REQUIRE_EQ(say.flags, 0u);                   // a legacy request, byte for byte
+    REQUIRE(!say.resultIsHonest);                // and its return value means little
+
+    NativeSpeechPlan queued = PlanNativeSay(caps, false);
+    REQUIRE(queued.send);
+    REQUIRE_EQ(queued.flags, 0u);
+    REQUIRE(queued.degraded);                    // it will interrupt, and the core says so
+
+    NativeSpeechPlan stop = PlanNativeStop(caps);
+    REQUIRE(!stop.send);                         // never pretend
+    REQUIRE(stop.refusal != nullptr);
+    REQUIRE_CONTAINS(caps.Describe(), "legacy frontend");
+}
+
+TEST_CASE(native_speech_a_full_backend_gets_interrupt_queue_and_stop) {
+    NativeSpeechCaps caps;
+    caps.present = true;
+    caps.backend = "nvda";
+    caps.bits = native_speech::kCapSpeak | native_speech::kCapInterrupt
+              | native_speech::kCapQueue | native_speech::kCapStop;
+
+    NativeSpeechPlan say = PlanNativeSay(caps, true);
+    REQUIRE(say.send);
+    REQUIRE_EQ(say.flags, native_speech::kFlagInterrupt);
+    REQUIRE(say.resultIsHonest);
+    REQUIRE(!say.degraded);
+
+    NativeSpeechPlan queued = PlanNativeSay(caps, false);
+    REQUIRE(queued.send);
+    REQUIRE_EQ(queued.flags, native_speech::kFlagQueue);   // the reader's speech.say(text, false)
+    REQUIRE(queued.resultIsHonest);
+    REQUIRE(!queued.degraded);                             // it must not cut the line before it
+
+    NativeSpeechPlan stop = PlanNativeStop(caps);
+    REQUIRE(stop.send);
+    REQUIRE_EQ(stop.flags, native_speech::kFlagStop);      // speech.stop() finally does something
+    REQUIRE(stop.resultIsHonest);
+
+    REQUIRE_CONTAINS(caps.Describe(), "nvda");
+    REQUIRE_CONTAINS(caps.Describe(), "queue");
+    REQUIRE_CONTAINS(caps.Describe(), "stop");
+}
+
+TEST_CASE(native_speech_a_backend_that_cannot_queue_is_not_claimed_to) {
+    // RetroArch's PowerShell fallback spawns one process per utterance and kills the previous one, so a
+    // second line cannot follow the first. The frontend reports no QUEUE bit; the core must degrade
+    // honestly rather than ask for something that would be silently wrong.
+    NativeSpeechCaps caps;
+    caps.present = true;
+    caps.backend = "powershell";
+    caps.bits = native_speech::kCapSpeak | native_speech::kCapInterrupt | native_speech::kCapStop;
+
+    REQUIRE(!caps.CanQueue());
+    NativeSpeechPlan queued = PlanNativeSay(caps, false);
+    REQUIRE(queued.send);
+    REQUIRE_EQ(queued.flags, native_speech::kFlagInterrupt);   // never kFlagQueue
+    REQUIRE(queued.degraded);
+    REQUIRE(queued.resultIsHonest);
+
+    // Stop does work there, so refusing it would be just as dishonest.
+    NativeSpeechPlan stop = PlanNativeStop(caps);
+    REQUIRE(stop.send);
+    REQUIRE_EQ(stop.flags, native_speech::kFlagStop);
+
+    REQUIRE_CONTAINS(caps.Describe(), "powershell");
+    REQUIRE(caps.Describe().find("queue") == std::string::npos);
+}
+
+TEST_CASE(native_speech_a_backend_that_can_only_speak_asks_for_nothing_more) {
+    NativeSpeechCaps caps;
+    caps.present = true;
+    caps.backend = "legacy";
+    caps.bits = native_speech::kCapSpeak;
+
+    NativeSpeechPlan say = PlanNativeSay(caps, true);
+    REQUIRE(say.send);
+    REQUIRE_EQ(say.flags, 0u);        // asking for a capability it never reported would be a lie
+    REQUIRE(!say.degraded);           // legacy speech already interrupts, so nothing was lost
+
+    NativeSpeechPlan queued = PlanNativeSay(caps, false);
+    REQUIRE(queued.send);
+    REQUIRE_EQ(queued.flags, 0u);
+    REQUIRE(queued.degraded);
+
+    REQUIRE(!PlanNativeStop(caps).send);
+}
+
+TEST_CASE(native_speech_no_backend_at_all_is_reported_as_a_failure_not_a_success) {
+    // This is what the user switching the narrator off looks like. Reporting success would leave the reader
+    // running in silence, which is the worst outcome this tool has.
+    NativeSpeechCaps caps;
+    caps.present = true;
+    caps.backend = "disabled";
+    caps.bits = 0;
+
+    NativeSpeechPlan say = PlanNativeSay(caps, true);
+    REQUIRE(!say.send);
+    REQUIRE(say.refusal != nullptr);
+    REQUIRE_CONTAINS(std::string(say.refusal), "no speech backend");
+
+    REQUIRE(!PlanNativeSay(caps, false).send);
+
+    NativeSpeechPlan stop = PlanNativeStop(caps);
+    REQUIRE(!stop.send);
+    REQUIRE_CONTAINS(std::string(stop.refusal), "no speech backend");
+    REQUIRE_CONTAINS(caps.Describe(), "nothing available");
+}
+
+TEST_CASE(native_speech_reaches_the_dispatcher_as_queue_interrupt_and_stop) {
+    // End to end through the dispatcher with a sink that reports real queue support: the reader's three Lua
+    // forms must arrive as three distinct requests, and a queued line must no longer be logged as degraded.
+    struct NativeLikeSink final : SpeechSink {
+        std::vector<SpeechEvent> events;
+        bool queue = true;
+        bool Say(std::string_view t, bool interrupt) noexcept override {
+            events.push_back({SpeechEvent::Kind::Say, std::string(t), interrupt});
+            return true;
+        }
+        bool Stop() noexcept override {
+            events.push_back({SpeechEvent::Kind::Stop, std::string(), true});
+            return true;
+        }
+        [[nodiscard]] const char* Name() const noexcept override { return "frontend"; }
+        [[nodiscard]] bool SupportsQueue() const noexcept override { return queue; }
+    };
+
+    NativeLikeSink sink;
+    std::vector<std::string> logs;
+    SpeechDispatcher speech(&sink, [&](LogLevel, std::string_view m) { logs.emplace_back(m); });
+
+    REQUIRE(speech.Say("Chargestone Cave", true));
+    REQUIRE(speech.Say("Launch C-Gear communications?", false));
+    REQUIRE(speech.Stop());
+
+    REQUIRE_EQ(sink.events.size(), size_t(3));
+    REQUIRE(sink.events[0].interrupt);
+    REQUIRE(!sink.events[1].interrupt);
+    REQUIRE(sink.events[2].kind == SpeechEvent::Kind::Stop);
+
+    // With genuine queue support the dispatcher must stop calling queued lines degraded.
+    for (const std::string& line : logs) {
+        REQUIRE(line.find("degraded=queue-spoken-as-interrupt") == std::string::npos);
+    }
+
+    // Control: a sink without queue support is still reported honestly.
+    sink.queue = false;
+    REQUIRE(speech.Say("Continue, 1 of 7", false));
+    bool degradedLogged = false;
+    for (const std::string& line : logs) {
+        if (line.find("degraded=queue-spoken-as-interrupt") != std::string::npos) degradedLogged = true;
+    }
+    REQUIRE(degradedLogged);
+}
+
+TEST_CASE(native_speech_a_refused_request_is_not_reported_as_spoken) {
+    // The frontend returns false for a flagged request it could not dispatch. That must reach the
+    // dispatcher as a failure so the replay and the diagnostics still work.
+    struct RefusingSink final : SpeechSink {
+        int calls = 0;
+        bool Say(std::string_view, bool) noexcept override { ++calls; return false; }
+        bool Stop() noexcept override { return false; }
+        [[nodiscard]] const char* Name() const noexcept override { return "frontend"; }
+        [[nodiscard]] bool SupportsQueue() const noexcept override { return true; }
+    };
+
+    RefusingSink refusing;
+    SpeechDispatcher speech(&refusing, nullptr);
+
+    REQUIRE(!speech.Say("Chargestone Cave", true));
+    REQUIRE_EQ(speech.ConsecutiveFailures(), uint64_t(1));
+    REQUIRE_EQ(refusing.calls, 1);
+    REQUIRE(!speech.Stop());
+}
+
+TEST_CASE(native_speech_capabilities_are_re_read_at_every_request_boundary) {
+    // The defect this pins down: capabilities were negotiated once and then cached for the session, so a
+    // backend that stopped being able to queue or stop was still asked to, and the dispatcher still logged
+    // the result as preserved queue behaviour. NVDA exiting mid-session, or the user switching the narrator
+    // off, is an ordinary event -- not a reason to keep speaking to a backend that is no longer there.
+    //
+    // The sink below is shaped exactly like FrontendSpeech: it re-asks a "frontend" in RefreshCapabilities,
+    // plans each request with the same PlanNativeSay/PlanNativeStop the core ships, and answers
+    // SupportsQueue() from whatever it last heard. FrontendSpeech itself needs libretro and so is not in
+    // this binary; what is tested here is the boundary that makes it correct.
+    struct FakeFrontend {
+        NativeSpeechCaps caps;
+    };
+
+    struct NegotiatingSink final : SpeechSink {
+        FakeFrontend* frontend;
+        NativeSpeechCaps cached;
+        bool negotiated = false;
+        unsigned flagsAsked = 0;
+        unsigned negotiations = 0;
+
+        explicit NegotiatingSink(FakeFrontend* f) noexcept : frontend(f) {}
+
+        void Negotiate() noexcept { cached = frontend->caps; negotiated = true; ++negotiations; }
+        void RefreshCapabilities() noexcept override { Negotiate(); }
+
+        bool Say(std::string_view, bool interrupt) noexcept override {
+            if (!negotiated) Negotiate();
+            NativeSpeechPlan plan = PlanNativeSay(cached, interrupt);
+            flagsAsked = plan.flags;
+            return plan.send;
+        }
+        bool Stop() noexcept override {
+            if (!negotiated) Negotiate();
+            return PlanNativeStop(cached).send;
+        }
+        [[nodiscard]] const char* Name() const noexcept override { return "frontend"; }
+        [[nodiscard]] bool SupportsQueue() const noexcept override { return cached.CanQueue(); }
+    };
+
+    FakeFrontend fe;
+    fe.caps.present = true;
+    fe.caps.backend = "nvda";
+    fe.caps.bits = native_speech::kCapSpeak | native_speech::kCapInterrupt
+                 | native_speech::kCapQueue | native_speech::kCapStop;
+
+    NegotiatingSink sink(&fe);
+    std::vector<std::string> logs;
+    SpeechDispatcher speech(&sink, [&](LogLevel, std::string_view m) { logs.emplace_back(m); });
+
+    REQUIRE(speech.Say("Chargestone Cave", false));
+    REQUIRE_EQ(sink.flagsAsked, native_speech::kFlagQueue);
+    REQUIRE(speech.Stop());
+
+    // NVDA exits. RetroArch keeps speaking, through a backend that cannot queue.
+    fe.caps.backend = "powershell";
+    fe.caps.bits = native_speech::kCapSpeak | native_speech::kCapInterrupt | native_speech::kCapStop;
+
+    size_t before = logs.size();
+    REQUIRE(speech.Say("Continue, 1 of 7", false));
+    // The request itself must change: asking for QUEUE here would be asking for something that will not
+    // happen, and the reader would go on believing its line was appended.
+    REQUIRE_EQ(sink.flagsAsked, native_speech::kFlagInterrupt);
+
+    bool degraded = false;
+    for (size_t i = before; i < logs.size(); ++i) {
+        if (logs[i].find("degraded=queue-spoken-as-interrupt") != std::string::npos) degraded = true;
+    }
+    REQUIRE(degraded);   // and the log must say so, rather than passing it off as preserved queue
+
+    // Stop goes the same way: a backend that can no longer stop must have the request refused, not
+    // swallowed. (The dispatcher counts that as a failure, which is what the fallback machinery needs.)
+    fe.caps.bits = native_speech::kCapSpeak;
+    REQUIRE(!speech.Stop());
+
+    // And it recovers: NVDA comes back and the very next line queues again, with no reload.
+    fe.caps.backend = "nvda";
+    fe.caps.bits = native_speech::kCapSpeak | native_speech::kCapInterrupt
+                 | native_speech::kCapQueue | native_speech::kCapStop;
+    REQUIRE(speech.Say("Victory Road", false));
+    REQUIRE_EQ(sink.flagsAsked, native_speech::kFlagQueue);
+    REQUIRE(speech.Stop());
+
+    // Every one of those requests re-asked; none of them ran on a remembered answer.
+    REQUIRE_EQ(sink.negotiations, 6u);
+}
+
+TEST_CASE(native_speech_a_lower_capability_fallback_reports_its_own_limits) {
+    // A refused line is replayed through the fallback. The fallback is a different backend with different
+    // abilities, so it must be asked about itself -- passing the replay off with the primary's queue
+    // support would be the same lie one level down.
+    struct QueueingButFailing final : SpeechSink {
+        bool refreshed = false;
+        bool Say(std::string_view, bool) noexcept override { return false; }
+        bool Stop() noexcept override { return false; }
+        [[nodiscard]] const char* Name() const noexcept override { return "primary"; }
+        [[nodiscard]] bool SupportsQueue() const noexcept override { return true; }
+        void RefreshCapabilities() noexcept override { refreshed = true; }
+    };
+    struct InterruptOnly final : SpeechSink {
+        unsigned refreshes = 0;
+        std::vector<SpeechEvent> events;
+        bool Say(std::string_view t, bool interrupt) noexcept override {
+            events.push_back({SpeechEvent::Kind::Say, std::string(t), interrupt});
+            return true;
+        }
+        bool Stop() noexcept override { return true; }
+        [[nodiscard]] const char* Name() const noexcept override { return "fallback"; }
+        [[nodiscard]] bool SupportsQueue() const noexcept override { return false; }
+        void RefreshCapabilities() noexcept override { ++refreshes; }
+    };
+
+    QueueingButFailing primary;
+    InterruptOnly fallback;
+    std::vector<std::string> logs;
+    SpeechDispatcher speech(&primary, [&](LogLevel, std::string_view m) { logs.emplace_back(m); });
+    speech.SetFallbackSink(&fallback, SpeechDispatcher::kDefaultFailureThreshold);
+
+    REQUIRE(speech.Say("Route 4, Desert Resort entrance", false));   // refused, then replayed
+    REQUIRE_EQ(fallback.events.size(), size_t(1));
+    REQUIRE(primary.refreshed);
+    REQUIRE_EQ(fallback.refreshes, 1u);   // the replay asked the fallback about itself
+
+    unsigned degradedLines = 0;
+    for (const std::string& line : logs) {
+        if (line.find("degraded=queue-spoken-as-interrupt") == std::string::npos) continue;
+        ++degradedLines;
+        REQUIRE_CONTAINS(line, "backend=fallback");   // never attributed to the primary
+    }
+    REQUIRE_EQ(degradedLines, 1u);
+}
diff --git a/test/accessibility/test_prism_abi.cpp b/test/accessibility/test_prism_abi.cpp
new file mode 100644
index 0000000..ce45a16
--- /dev/null
+++ b/test/accessibility/test_prism_abi.cpp
@@ -0,0 +1,98 @@
+// The pinned prism.dll: hash, exports and the version-2 configuration ABI. Never speaks.
+#include "harness.hpp"
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+#include "accessibility/prism_speech.hpp"
+#include "accessibility/speech.hpp"
+
+using namespace MelonDsDs::access;
+
+namespace {
+    bool FileExists(const char* path) {
+        DWORD attrs = GetFileAttributesA(path);
+        return attrs != INVALID_FILE_ATTRIBUTES && !(attrs & FILE_ATTRIBUTE_DIRECTORY);
+    }
+}
+
+TEST_CASE(pinned_prism_dll_hash_and_config_v2_init) {
+    const char* path = MELONDSDS_ACCESS_PRISM_DLL;
+    if (!FileExists(path)) {
+        std::printf("      (skipped: %s not present)\n", path);
+        return;
+    }
+    std::vector<std::string> logs;
+    std::string error;
+    std::string hash = PrismSpeech::HashFile(path, error);
+    REQUIRE_EQ(hash, std::string(PrismSpeech::kPinnedSha256));
+
+    PrismSpeech prism([&](LogLevel, std::string_view m) { logs.emplace_back(m); });
+    bool ok = prism.Load(path, error);
+    if (!ok) {
+        // Acceptable only when no speech backend can be acquired on this machine; every other failure
+        // (hash, exports, prism_init) means the ABI assumptions are wrong.
+        REQUIRE_CONTAINS(error, "no screen reader or speech engine");
+        SKIP_TEST("no speech backend is available on this machine: " + error);
+    }
+    REQUIRE(prism.Ready());
+    REQUIRE(!prism.BackendName().empty());
+    REQUIRE_CONTAINS(prism.Name(), "prism:");
+    std::printf("      (prism backend: %s)\n", prism.BackendName().c_str());
+    prism.Unload();
+    REQUIRE(!prism.Ready());
+    REQUIRE(!prism.Say("must not speak", true));
+    REQUIRE(!prism.Stop());
+}
+
+TEST_CASE(prism_can_be_destroyed_and_re_created_in_the_same_process) {
+    // This is the premise of the speech recovery path: Prism's screen-reader backends never reconnect, so a
+    // lost connection is handled by destroying the instance and creating a new one. That unloads and
+    // reloads prism.dll inside one process, which has to be safe.
+    const char* path = MELONDSDS_ACCESS_PRISM_DLL;
+    if (!FileExists(path)) {
+        SKIP_TEST(std::string("the pinned prism.dll is not present at ") + path);
+    }
+    std::string error;
+    for (int round = 0; round < 3; ++round) {
+        PrismSpeech prism(nullptr);
+        if (!prism.Load(path, error)) {
+            REQUIRE_CONTAINS(error, "no screen reader or speech engine");
+            SKIP_TEST("no speech backend is available on this machine: " + error);
+        }
+        REQUIRE(prism.Ready());
+        REQUIRE(!prism.BackendName().empty());
+        REQUIRE(prism.Stop());          // the silent liveness probe the recovery path uses before promoting
+        prism.Unload();                 // destructor would do this too; explicit here so the next Load races it
+        REQUIRE(!prism.Ready());
+    }
+}
+
+TEST_CASE(prism_rejects_a_dll_with_the_wrong_hash) {
+    char tmpPath[MAX_PATH];
+    char tmpFile[MAX_PATH];
+    REQUIRE(GetTempPathA(MAX_PATH, tmpPath) > 0);
+    REQUIRE(GetTempFileNameA(tmpPath, "prs", 0, tmpFile) != 0);
+    FILE* f = std::fopen(tmpFile, "wb");
+    REQUIRE(f != nullptr);
+    std::fputs("not a dll", f);
+    std::fclose(f);
+
+    std::string error;
+    PrismSpeech prism(nullptr);
+    REQUIRE(!prism.Load(tmpFile, error));
+    REQUIRE_CONTAINS(error, "hash mismatch");
+    REQUIRE(!prism.Ready());
+    DeleteFileA(tmpFile);
+
+    REQUIRE(!prism.Load("C:/definitely/missing/prism.dll", error));
+    REQUIRE_CONTAINS(error, "cannot open");
+}
+#else
+TEST_CASE(prism_abi_test_is_windows_only) {}
+#endif
diff --git a/test/accessibility/test_reader_script.cpp b/test/accessibility/test_reader_script.cpp
new file mode 100644
index 0000000..bb81022
--- /dev/null
+++ b/test/accessibility/test_reader_script.cpp
@@ -0,0 +1,107 @@
+// The real copied reader, running frame by frame against the host with a synthetic cartridge header.
+#include "harness.hpp"
+
+#include <chrono>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <vector>
+
+#include "accessibility/bounded_memory.hpp"
+#include "accessibility/reader_session.hpp"
+#include "accessibility/speech.hpp"
+
+using namespace MelonDsDs::access;
+
+namespace {
+    std::string ReadFile(const char* path) {
+        std::ifstream in(path, std::ios::binary);
+        std::ostringstream buf;
+        buf << in.rdbuf();
+        return buf.str();
+    }
+
+    struct Fixture {
+        std::vector<uint8_t> ram = std::vector<uint8_t>(0x400000, 0);   // 4 MiB DS main RAM
+        std::vector<uint8_t> rom = std::vector<uint8_t>(0x8000, 0);
+        RecordingSpeechSink sink;
+        std::vector<std::string> logs;
+        SpeechDispatcher speech {&sink, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }};
+        ReaderSession session {&speech, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }};
+        std::string source = ReadFile(MELONDSDS_ACCESS_READER_PATH);
+
+        void SetGame(const char* code) {
+            std::memcpy(rom.data(), "POKEMON B", 9);
+            std::memcpy(rom.data() + 0x0C, code, 4);
+            rom[0x1E] = 0;
+        }
+
+        SupportedGame Attach() {
+            return session.Attach(rom.data(), rom.size(), BoundedMemory(ram.data(), ram.size()),
+                                  BoundedMemory::ReadOnly(rom.data(), rom.size()), source, "pokemon_bw_reader.lua");
+        }
+    };
+}
+
+TEST_CASE(real_reader_source_is_present_and_compiles_on_lua_54) {
+    Fixture f;
+    REQUIRE(f.source.size() > 1000000);
+    REQUIRE(f.source.find("melonDS DS Access copy") != std::string::npos);
+    f.SetGame("IRBO");
+    REQUIRE(f.Attach() == SupportedGame::Black);
+    REQUIRE(f.session.Active());   // Attach compiled the whole chunk
+    REQUIRE_EQ(f.sink.events.size(), size_t(0));
+}
+
+TEST_CASE(real_reader_speaks_the_startup_line_for_black_and_white) {
+    Fixture f;
+    f.SetGame("IRBO");
+    REQUIRE(f.Attach() == SupportedGame::Black);
+    f.session.FrameStep(HostInputSnapshot {});
+    REQUIRE(f.session.Active());
+    REQUIRE(f.sink.events.size() >= 1);
+    REQUIRE_EQ(f.sink.events[0].text, std::string("Pokemon black accessibility loader running."));
+    REQUIRE(f.sink.events[0].interrupt);
+
+    Fixture w;
+    w.SetGame("IRAO");
+    REQUIRE(w.Attach() == SupportedGame::White);
+    w.session.FrameStep(HostInputSnapshot {});
+    REQUIRE(w.session.Active());
+    REQUIRE(w.sink.events.size() >= 1);
+    REQUIRE_EQ(w.sink.events[0].text, std::string("Pokemon white accessibility loader running."));
+}
+
+TEST_CASE(real_reader_runs_frames_against_zeroed_ram_without_errors_or_bounds_violations) {
+    Fixture f;
+    f.SetGame("IRBO");
+    REQUIRE(f.Attach() == SupportedGame::Black);
+    auto start = std::chrono::steady_clock::now();
+    const int frames = 120;
+    for (int i = 0; i < frames; ++i) {
+        HostInputSnapshot raw;
+        if (i % 7 == 3) raw.keyboardLetters = 1u << ('U' - 'A');   // repeat-last hotkey exercises say()
+        if (i % 11 == 5) raw.joypadMask = 1u << 12;                 // left trigger: the pad layer path
+        f.session.FrameStep(raw);
+        REQUIRE(f.session.Active());
+    }
+    auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+    REQUIRE_EQ(f.session.FrameCount(), uint64_t(frames));
+    REQUIRE_EQ(f.session.BoundsViolations(), uint64_t(0));
+    // Only the startup line and the U repeats of it may have been spoken over empty RAM.
+    for (const SpeechEvent& e : f.sink.events) {
+        REQUIRE_EQ(e.text, std::string("Pokemon black accessibility loader running."));
+    }
+    std::printf("      (%d frames of the real reader in %lld ms)\n", frames, (long long) elapsed);
+}
+
+TEST_CASE(real_reader_sees_no_file_or_process_access) {
+    Fixture f;
+    f.SetGame("IRBO");
+    // Prepend a probe that runs in the same sandbox as the reader.
+    std::string probe = "assert(io == nil and os.execute == nil and os.remove == nil and package == nil and dofile == nil)\n";
+    f.source = probe + f.source;
+    REQUIRE(f.Attach() == SupportedGame::Black);
+    f.session.FrameStep(HostInputSnapshot {});
+    REQUIRE(f.session.Active());
+}
diff --git a/test/accessibility/test_review_fixes.cpp b/test/accessibility/test_review_fixes.cpp
new file mode 100644
index 0000000..92b0d64
--- /dev/null
+++ b/test/accessibility/test_review_fixes.cpp
@@ -0,0 +1,824 @@
+// Behavioural tests for the independent review findings. Each test here was written to FAIL against the
+// first implementation and to pass only once the corresponding defect is fixed.
+//
+//  1. Controller layer disabled must stop exposing the trigger names to the reader, so ordinary DS input
+//     passes through even while the trigger is physically held (driven by the REAL reader).
+//  2. L3 role "microphone" must hide L3 from the reader, must let the reader's Microphone block suppress
+//     the native microphone, and must report the physical microphone state to the release latch.
+//  3. Speech that starts working and later fails must fall back with one accessible diagnostic, not silence.
+//  4. An adapter diagnostic must not be erased by the reader's next line.
+//  5. The log-only environment override must be seen in a real Windows host (process environment block,
+//     not the CRT's stale private copy).
+//  6. A main RAM window that is not the DS's 4 MiB layout (i.e. DSi mode) must be refused with a reason.
+//  7. A reader disabled at content load must start after a reset once the option is enabled.
+#include "harness.hpp"
+
+#include <cstring>
+#include <string>
+#include <vector>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#endif
+
+#include "accessibility/bounded_memory.hpp"
+#include "accessibility/env_override.hpp"
+#include "accessibility/host_input.hpp"
+#include "accessibility/lua_reader.hpp"
+#include "accessibility/reader_session.hpp"
+#include "accessibility/speech.hpp"
+
+#include <fstream>
+#include <sstream>
+
+using namespace MelonDsDs::access;
+
+namespace {
+    constexpr uint32_t Bit(unsigned id) { return 1u << id; }
+
+    std::string ReadReaderSource() {
+        std::ifstream in(MELONDSDS_ACCESS_READER_PATH, std::ios::binary);
+        std::ostringstream buf;
+        buf << in.rdbuf();
+        return buf.str();
+    }
+
+    /// A session fixture carrying a real 4 MiB DS main RAM window and a Black cartridge header.
+    struct SessionFixture {
+        std::vector<uint8_t> ram = std::vector<uint8_t>(0x400000, 0);
+        std::vector<uint8_t> rom = std::vector<uint8_t>(0x8000, 0);
+        RecordingSpeechSink sink;
+        std::vector<std::string> logs;
+        SpeechDispatcher speech {&sink, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }};
+        ReaderSession session {&speech, [this](LogLevel, std::string_view m) { logs.emplace_back(m); }};
+
+        SessionFixture(const char* code = "IRBO") {
+            std::memcpy(rom.data(), "POKEMON B", 9);
+            std::memcpy(rom.data() + 0x0C, code, 4);
+            rom[0x1E] = 0;
+        }
+
+        SupportedGame Attach(std::string_view script, size_t ramWindow = 0) {
+            size_t window = ramWindow ? ramWindow : ram.size();
+            return session.Attach(rom.data(), rom.size(), BoundedMemory(ram.data(), window),
+                                  BoundedMemory::ReadOnly(rom.data(), rom.size()), script, "reader.lua");
+        }
+
+        bool Spoke(const char* needle) const {
+            for (const SpeechEvent& e : sink.events) {
+                if (e.text.find(needle) != std::string::npos) return true;
+            }
+            return false;
+        }
+    };
+}
+
+// ---------------------------------------------------------------- 1. controller layer disabled
+
+TEST_CASE(review_layer_disabled_lets_ordinary_ds_input_through_with_the_real_reader) {
+    // The reader's pad_step blocks every DS button while its trigger is held. With the controller layer
+    // option DISABLED the reader must never learn that the trigger is down, so Up must reach the DS.
+    SessionFixture f;
+    SessionConfig cfg;
+    cfg.layer.layerEnabled = false;
+    cfg.layer.consumeL3 = false;
+    f.session.SetConfig(cfg);
+    REQUIRE(f.Attach(ReadReaderSource()) == SupportedGame::Black);
+    REQUIRE(f.session.Active());
+
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::L2) | Bit(retro_id::UP) | Bit(retro_id::A);
+
+    // Several frames: the reader latches across frames, so one frame would not prove much.
+    for (int i = 0; i < 5; ++i) {
+        FilteredInput out = f.session.FrameStep(raw);
+        REQUIRE(f.session.Active());
+        REQUIRE_EQ(out.joypadMask, raw.joypadMask);   // nothing blocked, nothing consumed
+        REQUIRE(!out.touchOverride);
+    }
+
+    // And releasing the trigger must not leave a latch behind either.
+    HostInputSnapshot released;
+    released.joypadMask = Bit(retro_id::UP);
+    FilteredInput out = f.session.FrameStep(released);
+    REQUIRE_EQ(out.joypadMask, released.joypadMask);
+}
+
+TEST_CASE(review_layer_enabled_still_blocks_ds_input_with_the_real_reader) {
+    // Control for the test above: with the layer ENABLED the same input must be blocked, which proves the
+    // test drives the reader's real pad_step rather than an inert path.
+    SessionFixture f;
+    REQUIRE(f.Attach(ReadReaderSource()) == SupportedGame::Black);
+
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::L2) | Bit(retro_id::UP) | Bit(retro_id::A);
+    FilteredInput out {};
+    for (int i = 0; i < 3; ++i) out = f.session.FrameStep(raw);
+    REQUIRE(f.session.Active());
+    REQUIRE_EQ(out.joypadMask, 0u);   // every DS button blocked, L2 consumed
+
+    // Release latch: Up is still physically down, so it must stay blocked.
+    HostInputSnapshot released;
+    released.joypadMask = Bit(retro_id::UP);
+    out = f.session.FrameStep(released);
+    REQUIRE_EQ(out.joypadMask, 0u);
+
+    // Once it is let go, a fresh press reaches the game again.
+    f.session.FrameStep(HostInputSnapshot {});
+    out = f.session.FrameStep(released);
+    REQUIRE_EQ(out.joypadMask, Bit(retro_id::UP));
+}
+
+TEST_CASE(review_layer_disabled_still_delivers_keyboard_letters) {
+    // Disabling the controller layer must not disable the keyboard hotkeys, which are a separate option.
+    std::vector<uint8_t> ram(0x100, 0);
+    BoundedMemory ramView(ram.data(), ram.size());
+    BoundedMemory romView;
+    RecordingSpeechSink sink;
+    SpeechDispatcher speech(&sink, nullptr);
+    LuaReader reader(ReaderHost {&ramView, &romView, &speech, nullptr});
+    REQUIRE(reader.Load(
+        "local n = input.get() "
+        "speech.say(tostring(n['R'] == true) .. ' ' .. tostring(n['X1 LeftTrigger']) .. ' '"
+        " .. tostring(n['X1 RightTrigger']) .. ' ' .. tostring(n['X1 LeftThumb']) .. ' '"
+        " .. tostring(n['X1 RightThumb']) .. ' ' .. tostring(n['X1 DpadUp'])) "
+        "emu.frameadvance()", "kb.lua"));
+
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::L2) | Bit(retro_id::R2) | Bit(retro_id::L3) | Bit(retro_id::R3) | Bit(retro_id::UP);
+    raw.keyboardLetters = 1u << ('R' - 'A');
+    reader.StepFrame(raw, LayerConfig {false, false});
+    REQUIRE_EQ(sink.events.size(), size_t(1));
+    // Letters and ordinary pad buttons stay visible. All three of the layer's own buttons are hidden -- R2
+    // included, because the reader keys its fly-map and Musical touch layer on the right trigger. R3 stays
+    // visible: it is the frontend's screen-layout key and the reader never uses it.
+    REQUIRE_EQ(sink.events[0].text, std::string("true nil nil nil true true"));
+}
+
+// ---------------------------------------------------------------- 2. L3 / microphone role
+
+TEST_CASE(review_microphone_role_hides_l3_from_the_reader) {
+    std::vector<uint8_t> ram(0x100, 0);
+    BoundedMemory ramView(ram.data(), ram.size());
+    BoundedMemory romView;
+    RecordingSpeechSink sink;
+    SpeechDispatcher speech(&sink, nullptr);
+    LuaReader reader(ReaderHost {&ramView, &romView, &speech, nullptr});
+    REQUIRE(reader.Load(
+        "local n = input.get() "
+        "speech.say(tostring(n['X1 LeftThumb']) .. ' ' .. tostring(n['X1 LeftTrigger'])) "
+        "emu.frameadvance()", "l3.lua"));
+
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::L3) | Bit(retro_id::L2);
+
+    // Microphone role: the option help promises the reader never sees L3.
+    reader.StepFrame(raw, LayerConfig {true, false});
+    REQUIRE_EQ(sink.events.size(), size_t(1));
+    REQUIRE_EQ(sink.events[0].text, std::string("nil true"));
+}
+
+TEST_CASE(review_accessibility_role_still_shows_l3_to_the_reader) {
+    // Control: in the accessibility role L3 is the reader's own key (shop money, pathfinding).
+    std::vector<uint8_t> ram(0x100, 0);
+    BoundedMemory ramView(ram.data(), ram.size());
+    BoundedMemory romView;
+    RecordingSpeechSink sink;
+    SpeechDispatcher speech(&sink, nullptr);
+    LuaReader reader(ReaderHost {&ramView, &romView, &speech, nullptr});
+    REQUIRE(reader.Load("speech.say(tostring(input.get()['X1 LeftThumb'])) emu.frameadvance()", "l3b.lua"));
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::L3);
+    reader.StepFrame(raw, LayerConfig {true, true});
+    REQUIRE_EQ(sink.events[0].text, std::string("true"));
+}
+
+TEST_CASE(review_microphone_block_suppresses_the_native_microphone) {
+    // The reader blocks every button the core reports, including "Microphone". In the microphone role L3
+    // is not consumed by the layer, so the block itself has to keep the native microphone shut.
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::L3) | Bit(retro_id::A);
+    InputOverrides ov;
+    ov.buttons[size_t(DsButton::Microphone)] = 0;
+    ov.buttons[size_t(DsButton::A)] = 0;
+
+    FilteredInput out = ApplyInputLayer(raw, ov, LayerConfig {true, false});
+    REQUIRE(out.suppressMicrophone);
+    REQUIRE_EQ(out.joypadMask & Bit(retro_id::L3), 0u);   // the core derives its mic button from L3
+    REQUIRE_EQ(out.joypadMask & Bit(retro_id::A), 0u);
+
+    // A mnemonic is NOT an intent to mute. It sets every character, so its released '.' for Microphone is
+    // an artifact of the movie format; inferring suppression from it silenced the microphone during any
+    // scripted gesture, including keyboard-driven ones with the controller layer switched off, where the
+    // reader owns no buttons at all.
+    InputOverrides gesture;
+    gesture.mnemonic = *ParseMnemonic("|10,20,100,0,..............T..|");
+    out = ApplyInputLayer(raw, gesture, LayerConfig {true, false});
+    REQUIRE(!out.suppressMicrophone);
+    REQUIRE_EQ(out.joypadMask & Bit(retro_id::L3), Bit(retro_id::L3));
+
+    // While the layer IS held the reader issues the explicit block in the same frame as the gesture, so the
+    // microphone stays shut for the whole gesture after all.
+    gesture.buttons[size_t(DsButton::Microphone)] = 0;
+    out = ApplyInputLayer(raw, gesture, LayerConfig {true, false});
+    REQUIRE(out.suppressMicrophone);
+    REQUIRE_EQ(out.joypadMask & Bit(retro_id::L3), 0u);
+
+    // With nothing blocked, the microphone keeps working in its own role.
+    InputOverrides none;
+    out = ApplyInputLayer(raw, none, LayerConfig {true, false});
+    REQUIRE(!out.suppressMicrophone);
+    REQUIRE_EQ(out.joypadMask & Bit(retro_id::L3), Bit(retro_id::L3));
+}
+
+TEST_CASE(review_getimmediate_reports_the_physical_microphone_for_the_release_latch) {
+    // The reader latches "what is still physically down" past the trigger's release. If Microphone always
+    // reads false the latch can never hold it, so the native microphone fires the moment the layer drops.
+    std::vector<uint8_t> ram(0x100, 0);
+    BoundedMemory ramView(ram.data(), ram.size());
+    BoundedMemory romView;
+    RecordingSpeechSink sink;
+    SpeechDispatcher speech(&sink, nullptr);
+    LuaReader reader(ReaderHost {&ramView, &romView, &speech, nullptr});
+    REQUIRE(reader.Load(
+        "while true do "
+        "  local p = joypad.getimmediate() "
+        "  speech.say(tostring(p.Microphone) .. ' ' .. tostring(p.A) .. ' ' .. tostring(p.LidOpen)) "
+        "  emu.frameadvance() "
+        "end", "mic.lua"));
+
+    HostInputSnapshot raw;
+    raw.joypadMask = Bit(retro_id::L3) | Bit(retro_id::A);
+
+    // Physical state is reported in EVERY configuration, including the two where input.get() hides L3.
+    // Routing getimmediate through the visibility filter would silently kill the microphone's release
+    // latch, so each case is asserted separately rather than only where the filter happens to be a no-op.
+    const LayerConfig configs[] = {
+        LayerConfig {true, true},     // accessibility role: L3 visible to input.get() too
+        LayerConfig {true, false},    // microphone role: L3 hidden from input.get()
+        LayerConfig {false, false},   // layer off: L2/R2/L3 all hidden from input.get()
+    };
+    for (const LayerConfig& cfg : configs) {
+        sink.events.clear();
+        reader.StepFrame(raw, cfg);
+        REQUIRE_EQ(sink.events.size(), size_t(1));
+        REQUIRE_EQ(sink.events[0].text, std::string("true true false"));
+    }
+}
+
+// ---------------------------------------------------------------- 3. speech failure after success
+
+namespace {
+    /// Works for `successes` calls, then fails every time, like a screen reader that exits mid-session.
+    struct FlakySink final : SpeechSink {
+        int successes = 2;
+        int calls = 0;
+        std::vector<std::string> spoken;
+        bool Say(std::string_view text, bool) noexcept override {
+            ++calls;
+            if (calls <= successes) {
+                spoken.emplace_back(text);
+                return true;
+            }
+            return false;
+        }
+        bool Stop() noexcept override { return calls <= successes; }
+        [[nodiscard]] const char* Name() const noexcept override { return "flaky"; }
+    };
+}
+
+TEST_CASE(review_speech_that_fails_after_working_falls_back_once_with_a_diagnostic) {
+    FlakySink flaky;
+    RecordingSpeechSink fallback;
+    fallback.name = "frontend";
+    std::vector<std::string> logs;
+    SpeechDispatcher speech(&flaky, [&](LogLevel, std::string_view m) { logs.emplace_back(m); });
+    speech.SetFallbackSink(&fallback, SpeechDispatcher::kDefaultFailureThreshold);
+
+    REQUIRE(speech.Say("first line", true));
+    REQUIRE(speech.Say("second line", false));
+    REQUIRE_EQ(speech.ConsecutiveFailures(), uint64_t(0));
+    REQUIRE(!speech.Demoted());
+    REQUIRE_EQ(speech.Replays(), uint64_t(0));
+
+    // The backend dies. The threshold governs when the PRIMARY is dropped, never whether the player hears
+    // the line: each refused line is replayed through the fallback straight away.
+    REQUIRE(speech.Say("third line", true));
+    REQUIRE_EQ(speech.ConsecutiveFailures(), uint64_t(1));
+    REQUIRE(!speech.Demoted());
+    REQUIRE_EQ(fallback.events.size(), size_t(1));
+    REQUIRE_EQ(fallback.events[0].text, std::string("third line"));
+
+    REQUIRE(speech.Say("fourth line", true));
+    REQUIRE_EQ(speech.ConsecutiveFailures(), uint64_t(2));
+    REQUIRE(!speech.Demoted());
+    REQUIRE_EQ(fallback.events.size(), size_t(2));
+    REQUIRE_EQ(fallback.events[1].text, std::string("fourth line"));
+    REQUIRE_EQ(speech.Replays(), uint64_t(2));
+
+    // Third consecutive failure: now the primary is dropped for good, and this line carries the one
+    // diagnostic that explains it.
+    bool ok = speech.Say("fifth line", true);
+    REQUIRE(ok);
+    REQUIRE(speech.Demoted());
+    REQUIRE(speech.Sink() == &fallback);
+    REQUIRE_EQ(fallback.events.size(), size_t(3));
+    REQUIRE_CONTAINS(fallback.events[2].text, "fifth line");       // the line that failed is not lost
+    REQUIRE_CONTAINS(fallback.events[2].text, "screen reader");    // and the player is told why
+    REQUIRE_EQ(speech.Replays(), uint64_t(2));                     // demotion is not counted as a replay
+
+    // The player must be told, and told exactly once, even over many further lines.
+    for (int i = 0; i < 25; ++i) REQUIRE(speech.Say("more game text", false));
+    size_t diagnostics = 0;
+    for (const SpeechEvent& e : fallback.events) {
+        if (e.text.find("screen reader") != std::string::npos || e.text.find("Speech") != std::string::npos) ++diagnostics;
+    }
+    REQUIRE_EQ(diagnostics, size_t(1));
+    REQUIRE(speech.Demoted());
+    REQUIRE_EQ(speech.ConsecutiveFailures(), uint64_t(0));   // the fallback is working
+}
+
+TEST_CASE(review_speech_recovers_its_counter_when_the_backend_comes_back) {
+    FlakySink flaky;
+    flaky.successes = 1;
+    RecordingSpeechSink fallback;
+    std::vector<std::string> logs;
+    SpeechDispatcher speech(&flaky, [&](LogLevel, std::string_view m) { logs.emplace_back(m); });
+    speech.SetFallbackSink(&fallback, 3);
+
+    REQUIRE(speech.Say("a", true));
+    REQUIRE(speech.Say("b", true));             // refused by the primary, replayed through the fallback
+    REQUIRE_EQ(fallback.events.size(), size_t(1));
+    REQUIRE_EQ(fallback.events[0].text, std::string("b"));
+    REQUIRE_EQ(speech.ConsecutiveFailures(), uint64_t(1));
+    flaky.successes = 99;                       // the backend recovers on its own
+    REQUIRE(speech.Say("c", true));
+    REQUIRE_EQ(speech.ConsecutiveFailures(), uint64_t(0));
+    REQUIRE(!speech.Demoted());                 // a transient hiccup must not cost the good backend
+    REQUIRE(speech.Sink() == &flaky);
+    REQUIRE_EQ(fallback.events.size(), size_t(1));   // and nothing else was diverted
+}
