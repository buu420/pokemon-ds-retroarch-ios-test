+/*
+    melonDS DS Access: Lua 5.4 host for the Pokemon Black/White reader.
+
+    The reader is a single chunk whose main loop ends every iteration with emu.frameadvance(). It runs
+    inside a coroutine; the core resumes it once per emulated frame and it yields in frameadvance. The
+    BizHawk surface it uses is provided as globals so the chunk's exhausted 200-local budget is untouched:
+
+        mainmemory.read_u8 / read_u16_le / read_u32_le / write_u8 / read_bytes_as_array
+        memory.read_u8 / read_u16_le / read_u32_le   (domain "ROM" reads the cartridge, else main RAM)
+        memory.getmemorydomainlist / getmemorydomainsize (available "Main RAM" and "ROM" views)
+        emu.framecount / emu.frameadvance
+        joypad.getimmediate / set / setfrommnemonicstr / setanalog
+        input.get
+        console.writeline / log / write, print
+        gameinfo.getromname (always nil: no filename-based detection in this host)
+        speech.say / stop / output / braille
+        os.clock (the only os function; io, package and debug are not opened)
+
+    Every RAM access is width-checked; an out-of-range access returns 0 (or an empty table) and is counted
+    and logged instead of raising, mirroring the reader's own fail-closed convention. A Lua error or a
+    returned chunk stops the reader, clears every override it held, logs the traceback and speaks a
+    diagnostic, so a dead reader never masquerades as normal silence.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "bounded_memory.hpp"
+#include "host_input.hpp"
+#include "speech.hpp"
+
+struct lua_State;
+
+namespace MelonDsDs::access {
+    struct ReaderHost {
+        BoundedMemory* mainRam = nullptr;   // writable main RAM view
+        BoundedMemory* rom = nullptr;       // read-only cartridge view (header at offset 0)
+        SpeechDispatcher* speech = nullptr;
+        LogFn log;
+    };
+
+    class LuaReader {
+    public:
+        enum class Status { NotLoaded, Running, Finished, Failed };
+
+        /// read_bytes_as_array requests larger than this are refused (the reader never asks for more than 256 KiB + 64).
+        static constexpr size_t kMaxBytesArray = size_t(1) << 20;
+        /// Bounds violations are logged individually up to this count, then every 1000th.
+        static constexpr uint64_t kBoundsLogLimit = 20;
+
+        explicit LuaReader(ReaderHost host) noexcept;
+        ~LuaReader() noexcept;
+        LuaReader(const LuaReader&) = delete;
+        LuaReader& operator=(const LuaReader&) = delete;
+
+        /// Compiles the chunk and prepares the coroutine. Nothing runs until the first StepFrame.
+        bool Load(std::string_view source, std::string_view chunkName) noexcept;
+
+        /// True when Restart() can reuse the already-compiled chunk.
+        [[nodiscard]] bool CanRestart() const noexcept { return _L != nullptr && _chunkRef != kNoRef; }
+
+        /// Starts the reader over on a fresh coroutine WITHOUT recompiling. Parsing the 2 MB reader costs
+        /// 28-46 ms, which a savestate load (and every rewind frame) would otherwise pay; re-calling the
+        /// compiled chunk gives the same clean state because all of the reader's state lives in the chunk's
+        /// own locals, not in globals.
+        bool Restart() noexcept;
+
+        /// Resumes the reader until it yields in emu.frameadvance(). Overrides from the previous frame are
+        /// wiped first. `layer` decides which host buttons input.get() may report; joypad.getimmediate()
+        /// always reports the unfiltered physical state so the reader's release latch keeps working.
+        Status StepFrame(const HostInputSnapshot& snapshot, const LayerConfig& layer) noexcept;
+        Status StepFrame(const HostInputSnapshot& snapshot) noexcept {
+            return StepFrame(snapshot, LayerConfig {});
+        }
+
+        [[nodiscard]] Status GetStatus() const noexcept { return _status; }
+        [[nodiscard]] const std::string& LastError() const noexcept { return _error; }
+        [[nodiscard]] uint64_t FrameCount() const noexcept { return _frame; }
+        [[nodiscard]] const InputOverrides& Overrides() const noexcept { return _overrides; }
+        [[nodiscard]] const HostInputSnapshot& Snapshot() const noexcept { return _snapshot; }
+        [[nodiscard]] uint64_t BoundsViolations() const noexcept { return _violations; }
+        [[nodiscard]] uint64_t RamWrites() const noexcept { return _writes; }
+
+    private:
+        static constexpr int kNoRef = -2;   // LUA_NOREF; asserted against the real value in the .cpp
+
+        static LuaReader& Self(lua_State* L) noexcept;
+        static bool ArgToU64(lua_State* L, int index, uint64_t& out) noexcept;
+        BoundedMemory* DomainFor(lua_State* L, int index) const noexcept;
+        void RegisterApi() noexcept;
+        void RegisterTable(const char* name, const void* funcs) noexcept;
+        void Close() noexcept;
+        void Fail(std::string message) noexcept;
+        void Finish() noexcept;
+        void NoteViolation(const char* op, uint64_t offset, uint64_t width, const BoundedMemory* domain) noexcept;
+        void Log(LogLevel level, std::string_view message) const noexcept;
+
+        static int L_mm_read_u8(lua_State* L);
+        static int L_mm_read_u16(lua_State* L);
+        static int L_mm_read_u32(lua_State* L);
+        static int L_mm_write_u8(lua_State* L);
+        static int L_mm_read_bytes(lua_State* L);
+        static int L_mem_read_u8(lua_State* L);
+        static int L_mem_read_u16(lua_State* L);
+        static int L_mem_read_u32(lua_State* L);
+        static int L_mem_getmemorydomainlist(lua_State* L);
+        static int L_mem_getmemorydomainsize(lua_State* L);
+        static int L_emu_framecount(lua_State* L);
+        static int L_emu_frameadvance(lua_State* L);
+        static int L_joypad_getimmediate(lua_State* L);
+        static int L_joypad_set(lua_State* L);
+        static int L_joypad_setfrommnemonicstr(lua_State* L);
+        static int L_joypad_setanalog(lua_State* L);
+        static int L_input_get(lua_State* L);
+        static int L_console_write(lua_State* L);
+        static int L_gameinfo_getromname(lua_State* L);
+        static int L_speech_say(lua_State* L);
+        static int L_speech_stop(lua_State* L);
+        static int L_speech_braille(lua_State* L);
+        static int L_os_clock(lua_State* L);
+        static int L_panic(lua_State* L);
+
+        ReaderHost _host;
+        lua_State* _L = nullptr;
+        lua_State* _co = nullptr;
+        int _coRef = kNoRef;
+        int _chunkRef = kNoRef;
+        Status _status = Status::NotLoaded;
+        std::string _error;
+        uint64_t _frame = 0;
+        InputOverrides _overrides;
+        HostInputSnapshot _snapshot;
+        LayerConfig _layer {};
+        uint64_t _violations = 0;
+        uint64_t _writes = 0;
+        std::vector<uint8_t> _scratch;
+    };
+}
