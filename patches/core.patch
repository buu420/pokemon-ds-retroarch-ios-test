+// ------------------------------------------------------------------------------------------------- emu
+
+int LuaReader::L_emu_framecount(lua_State* L) {
+    lua_pushinteger(L, lua_Integer(Self(L)._frame));
+    return 1;
+}
+
+int LuaReader::L_emu_frameadvance(lua_State* L) {
+    return lua_yield(L, 0);
+}
+
+// ---------------------------------------------------------------------------------------------- joypad
+
+int LuaReader::L_joypad_getimmediate(lua_State* L) {
+    LuaReader& self = Self(L);
+    const HostInputSnapshot& snap = self._snapshot;
+    lua_createtable(L, 0, int(kDsButtonCount) + 4);
+    for (size_t i = 0; i < kDsButtonCount; ++i) {
+        DsButton button = DsButton(i);
+        bool held = false;
+        if (std::optional<unsigned> id = RetroIdForDsButton(button)) {
+            held = (snap.joypadMask >> *id) & 1u;
+        }
+        else if (button == DsButton::Touch) {
+            held = snap.pointerPressed;
+        }
+        else if (button == DsButton::Microphone) {
+            // The core's microphone button IS L3. Reporting its physical state is what lets the reader's
+            // release latch hold the microphone shut past the trigger's release, exactly like a DS button.
+            // Always unfiltered: the latch is about what is physically down, not about what the layer shows.
+            held = (snap.joypadMask >> retro_id::L3) & 1u;
+        }
+        lua_pushboolean(L, held);
+        lua_setfield(L, -2, DsButtonName(button));
+    }
+    for (const char* axis : kAxisNames) {
+        lua_pushinteger(L, 0);
+        lua_setfield(L, -2, axis);
+    }
+    return 1;
+}
+
+int LuaReader::L_joypad_set(lua_State* L) {
+    LuaReader& self = Self(L);
+    luaL_checktype(L, 1, LUA_TTABLE);
+    bool any = false;
+    lua_pushnil(L);
+    while (lua_next(L, 1) != 0) {
+        any = true;
+        if (lua_type(L, -2) == LUA_TSTRING && lua_type(L, -1) == LUA_TBOOLEAN) {
+            size_t len = 0;
+            const char* key = lua_tolstring(L, -2, &len);
+            if (std::optional<DsButton> button = DsButtonFromName(std::string_view(key, len))) {
+                self._overrides.buttons[size_t(*button)] = lua_toboolean(L, -1) ? 1 : 0;
+            }
+        }
+        lua_pop(L, 1);
+    }
+    if (!any) {
+        // joypad.set({}) un-sets every override, like BizHawk.
+        self._overrides.Clear();
+    }
+    return 0;
+}
+
+int LuaReader::L_joypad_setfrommnemonicstr(lua_State* L) {
+    LuaReader& self = Self(L);
+    size_t len = 0;
+    const char* s = luaL_checklstring(L, 1, &len);
+    std::optional<MnemonicState> state = ParseMnemonic(std::string_view(s, len));
+    if (!state) {
+        self.Log(LogLevel::Warn, "joypad.setfrommnemonicstr: unparseable mnemonic \""
+                                 + SpeechDispatcher::EscapeForLog(std::string_view(s, len)) + "\"");
+        return 0;
+    }
+    self._overrides.mnemonic = *state;
+    return 0;
+}
+
+int LuaReader::L_joypad_setanalog(lua_State*) {
+    // BizHawk sticky axis holds have no equivalent here; the reader only uses this to clear them.
+    return 0;
+}
+
+// ----------------------------------------------------------------------------------------------- input
+
+int LuaReader::L_input_get(lua_State* L) {
+    LuaReader& self = Self(L);
+    const HostInputSnapshot& snap = self._snapshot;
+    lua_createtable(L, 0, 32);
+    for (unsigned i = 0; i < 26; ++i) {
+        if ((snap.keyboardLetters >> i) & 1u) {
+            char name[2] = {char('A' + i), 0};
+            lua_pushboolean(L, 1);
+            lua_setfield(L, -2, name);
+        }
+    }
+    // Only the buttons the current layer configuration allows the reader to see. Hiding the trigger names
+    // is what genuinely turns the reader's own controller layer off.
+    uint32_t visible = HostVisibleMask(snap.joypadMask, self._layer);
+    for (unsigned id = 0; id < retro_id::COUNT; ++id) {
+        if ((visible >> id) & 1u) {
+            lua_pushboolean(L, 1);
+            lua_setfield(L, -2, HostPadName(id));
+        }
+    }
+    return 1;
+}
+
+// --------------------------------------------------------------------------------------------- console
+
+int LuaReader::L_console_write(lua_State* L) {
+    LuaReader& self = Self(L);
+    int n = lua_gettop(L);
+    std::string text = "[lua] ";
+    for (int i = 1; i <= n; ++i) {
+        size_t len = 0;
+        const char* s = luaL_tolstring(L, i, &len);
+        if (i > 1) text += '\t';
+        if (s) text.append(s, len);
+        lua_pop(L, 1);
+    }
+    self.Log(LogLevel::Info, text);
+    return 0;
+}
+
+// -------------------------------------------------------------------------------------------- gameinfo
+
+int LuaReader::L_gameinfo_getromname(lua_State* L) {
+    lua_pushnil(L);
+    return 1;
+}
+
+// ---------------------------------------------------------------------------------------------- speech
+
+int LuaReader::L_speech_say(lua_State* L) {
+    LuaReader& self = Self(L);
+    size_t len = 0;
+    const char* text = luaL_tolstring(L, 1, &len);
+    bool interrupt = lua_isnoneornil(L, 2) ? true : (lua_toboolean(L, 2) != 0);
+    if (self._host.speech && text) {
+        self._host.speech->Say(std::string_view(text, len), interrupt);
+    }
+    lua_pop(L, 1);
+    return 0;
+}
+
+int LuaReader::L_speech_stop(lua_State* L) {
+    LuaReader& self = Self(L);
+    if (self._host.speech) self._host.speech->Stop();
+    return 0;
+}
+
+int LuaReader::L_speech_braille(lua_State*) {
+    return 0;
+}
+
+// -------------------------------------------------------------------------------------------------- os
+
+int LuaReader::L_os_clock(lua_State* L) {
+    lua_pushnumber(L, lua_Number(std::clock()) / lua_Number(CLOCKS_PER_SEC));
+    return 1;
+}
