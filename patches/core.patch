+    ZoneScopedN(TracyFunction);
+    using namespace MelonDsDs::config::accessibility;
+    using retro::get_variable;
+    namespace values = MelonDsDs::config::values;
+
+    if (optional<bool> value = ParseBoolean(get_variable(READER))) {
+        config.SetAccessReaderEnabled(*value);
+    } else {
+        retro::warn("Failed to get value for {}; defaulting to {}", READER, values::ENABLED);
+        config.SetAccessReaderEnabled(true);
+    }
+
+    if (optional<bool> value = ParseBoolean(get_variable(CONTROLLER_LAYER))) {
+        config.SetAccessControllerLayer(*value);
+    } else {
+        retro::warn("Failed to get value for {}; defaulting to {}", CONTROLLER_LAYER, values::ENABLED);
+        config.SetAccessControllerLayer(true);
+    }
+
+    string_view role = get_variable(L3_ROLE);
+    if (role == values::accessibility::ROLE_MICROPHONE) {
+        config.SetAccessL3ForAccessibility(false);
+    } else if (role == values::accessibility::ROLE_ACCESSIBILITY) {
+        config.SetAccessL3ForAccessibility(true);
+    } else {
+        retro::warn("Failed to get value for {}; defaulting to {}", L3_ROLE, values::accessibility::ROLE_ACCESSIBILITY);
+        config.SetAccessL3ForAccessibility(true);
+    }
+
+    string_view speech = get_variable(SPEECH);
+    if (speech == values::accessibility::SPEECH_PRISM) {
+        config.SetAccessSpeech(AccessSpeechBackend::Prism);
+    } else if (speech == values::accessibility::SPEECH_FRONTEND) {
+        config.SetAccessSpeech(AccessSpeechBackend::Frontend);
+    } else if (speech == values::accessibility::SPEECH_LOG) {
+        config.SetAccessSpeech(AccessSpeechBackend::LogOnly);
+    } else {
+        // RetroArch's own narrator is the shipped default: it needs no extra file, and a missing or
+        // unrecognised value must never silently select the optional Prism backend.
+        retro::warn("Failed to get value for {}; defaulting to {}", SPEECH, values::accessibility::SPEECH_FRONTEND);
+        config.SetAccessSpeech(AccessSpeechBackend::Frontend);
+    }
+
+    if (optional<bool> value = ParseBoolean(get_variable(KEYBOARD))) {
+        config.SetAccessKeyboard(*value);
+    } else {
+        retro::warn("Failed to get value for {}; defaulting to {}", KEYBOARD, values::ENABLED);
+        config.SetAccessKeyboard(true);
+    }
