+    uint16_t v = 0;
+    BoundedMemory* mem = self.DomainFor(L, 2);
+    if (!ArgToU64(L, 1, off) || !mem || !mem->ReadU16LE(off, v)) {
+        self.NoteViolation("memory.read_u16_le", off, 2, mem);
+        v = 0;
+    }
+    lua_pushinteger(L, v);
+    return 1;
+}
+
+int LuaReader::L_mem_read_u32(lua_State* L) {
+    LuaReader& self = Self(L);
+    uint64_t off = 0;
+    uint32_t v = 0;
+    BoundedMemory* mem = self.DomainFor(L, 2);
+    if (!ArgToU64(L, 1, off) || !mem || !mem->ReadU32LE(off, v)) {
+        self.NoteViolation("memory.read_u32_le", off, 4, mem);
+        v = 0;
+    }
