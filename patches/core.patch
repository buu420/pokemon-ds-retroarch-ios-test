+TEST_CASE(review_log_only_environment_override_is_read_from_the_process_environment) {
+    // A real Windows host (the Python validation host) sets this variable with SetEnvironmentVariable
+    // semantics BEFORE loading the core. MinGW links msvcrt, whose getenv serves a private copy snapshotted
+    // when msvcrt first attached to the process -- already loaded, and therefore stale. The core must read
+    // the live process environment block instead.
+    const char* name = "MELONDSDS_ACCESSIBILITY_TEST_FLAG";
+#ifdef _WIN32
+    REQUIRE(!EnvironmentFlagSet(name));
+    REQUIRE(SetEnvironmentVariableA(name, "1") != 0);
+    REQUIRE(EnvironmentFlagSet(name));            // RED with std::getenv on MinGW/msvcrt
+
+    REQUIRE(SetEnvironmentVariableA(name, "0") != 0);
+    REQUIRE(!EnvironmentFlagSet(name));           // "0" means off
+    REQUIRE(SetEnvironmentVariableA(name, "") != 0);
+    REQUIRE(!EnvironmentFlagSet(name));           // empty means off
+    REQUIRE(SetEnvironmentVariableA(name, "yes") != 0);
+    REQUIRE(EnvironmentFlagSet(name));
+    REQUIRE(SetEnvironmentVariableA(name, nullptr) != 0);
+    REQUIRE(!EnvironmentFlagSet(name));
+#else
+    REQUIRE(!EnvironmentFlagSet(name));
+#endif
+}
