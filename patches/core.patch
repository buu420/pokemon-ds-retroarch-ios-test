+/*
+    melonDS DS Access: where the reader script and prism.dll live.
+
+    Search order for both files:
+        1. <directory containing this core's library>/melondsds_access/
+        2. <frontend system directory>/melondsds_access/
+    The reader falls back to the copy embedded at build time (same content); Prism never has a fallback.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace MelonDsDs::access {
+    inline constexpr const char* kDataSubdirectory = "melondsds_access";
+    inline constexpr const char* kReaderFileName = "pokemon_bw_reader.lua";
+    inline constexpr const char* kPrismFileName = "prism.dll";
+
+    struct ReaderSource {
+        std::string text;
+        std::string origin;   // full path, or "embedded"
+        std::string sha256;
+    };
+
+    /// Candidate data directories in search order (existing or not).
+    std::vector<std::string> DataDirectoryCandidates() noexcept;
+
+    /// First candidate directory that contains `fileName`, joined with it.
+    std::optional<std::string> LocateDataFile(std::string_view fileName) noexcept;
+
+    /// Reads a whole file (UTF-8 path). False with `error` set on failure.
+    bool ReadWholeFile(const std::string& pathUtf8, std::string& out, std::string& error) noexcept;
+
+    /// Loads the reader from the data directory, else from the embedded copy.
+    bool LoadReaderSource(ReaderSource& out, std::string& error) noexcept;
+}
diff --git a/src/libretro/accessibility/reader_session.cpp b/src/libretro/accessibility/reader_session.cpp
new file mode 100644
index 0000000..feb2257
--- /dev/null
+++ b/src/libretro/accessibility/reader_session.cpp
@@ -0,0 +1,233 @@
+/*
+    melonDS DS Access: reader lifecycle.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#include "reader_session.hpp"
+
+#include <cstdio>
+
+using namespace MelonDsDs::access;
+
+ReaderSession::ReaderSession(SpeechDispatcher* speech, LogFn log) noexcept
+    : _speech(speech), _log(std::move(log)) {}
+
+ReaderSession::~ReaderSession() noexcept {
+    _reader.reset();
+}
+
+void ReaderSession::Log(LogLevel level, std::string_view message) const noexcept {
+    if (!_log) return;
+    try {
+        _log(level, message);
+    }
+    catch (...) {
+    }
+}
+
+void ReaderSession::SetConfig(const SessionConfig& config) noexcept {
+    bool wasEnabled = _config.readerEnabled;
+    _config = config;
+    if (_game == SupportedGame::None) return;
+
+    if (wasEnabled && !config.readerEnabled && _reader) {
+        Log(LogLevel::Info, "reader disabled by configuration; stopping it");
+        ReleaseSyntheticInput();
+        _reader.reset();
+    }
+    else if (!wasEnabled && config.readerEnabled && !_reader) {
+        // Deliberately deferred, and the option help says so: starting a reader in the middle of a session
+        // would drop it into whatever screen happens to be up, with none of the state its readers expect.
+        Log(LogLevel::Info, "reader enabled by configuration; it starts at the next content load or reset");
+    }
+}
+
+SupportedGame ReaderSession::Attach(const uint8_t* header, size_t headerLength, BoundedMemory mainRam,
+                                    BoundedMemory rom, std::string_view readerSource,
+                                    std::string_view chunkName) noexcept {
+    Detach();
+
+    _identity = ReadCartIdentity(header, headerLength);
+    _game = ClassifyGame(_identity);
+    if (_game == SupportedGame::None) {
+        std::string what = _identity.valid
+            ? std::string("code ") + _identity.code + ", revision " + std::to_string(_identity.revision)
+            : std::string("unreadable header");
+        Log(LogLevel::Info, "reader not available for this cartridge (" + what + "); supported: IRBO/IRAO revision 0, CPUE revision 1");
+        if (_speech && _config.readerEnabled) {
+            _speech->Say("Accessibility reader is not available for this game (" + what + ").", true);
+        }
+        return _game;
+    }
+
+    if (mainRam.Size() != kDsMainRamWindow) {
+        // Sixteen megabytes is what DSi mode reports; anything else is simply not the layout the reader
+        // was written and validated against.
+        std::string what = mainRam.Size() == 0x1000000
+            ? std::string("this console is running in DSi mode")
+            : std::string("this console reports an unexpected memory size");
+        Log(LogLevel::Warn, "reader refused: main RAM window is 0x"
+                            + [&] { char b[32]; std::snprintf(b, sizeof(b), "%zx", mainRam.Size()); return std::string(b); }()
+                            + " bytes, not the Nintendo DS 0x400000 layout the reader was validated against ("
+                            + what + ")");
+        if (_speech && _config.readerEnabled) {
+            _speech->Say("The accessibility reader needs the Nintendo DS memory layout, but " + what
+                         + ". The reader will stay silent. Set the core's Console Mode option to DS and reload the game.",
+                         true);
+        }
+        _game = SupportedGame::None;
+        return _game;
+    }
+
+    _ram = mainRam;
+    _rom = rom;
+    try {
+        _source.assign(readerSource.data(), readerSource.size());
+        _chunkName.assign(chunkName.data(), chunkName.size());
+    }
+    catch (...) {
+        Log(LogLevel::Error, "out of memory storing the reader source");
+        _game = SupportedGame::None;
+        return _game;
+    }
+
+    Log(LogLevel::Info, std::string("cartridge accepted: game=") + GameName(_game) + " code=" + _identity.code
+                        + " revision=" + std::to_string(_identity.revision) + " ram=0x"
+                        + [&] { char b[32]; std::snprintf(b, sizeof(b), "%zx", _ram.Size()); return std::string(b); }()
+                        + " reader=" + _chunkName + " (" + std::to_string(_source.size()) + " bytes)");
+
+    if (!_config.readerEnabled) {
+        Log(LogLevel::Info, "reader is disabled by configuration (melonds_access_reader); not starting it");
+        return _game;
+    }
+
+    CreateReader();
+    return _game;
+}
+
+void ReaderSession::CreateReader() noexcept {
+    if (_game == SupportedGame::None || !_config.readerEnabled) {
+        _reader.reset();
+        return;
+    }
+
+    // Reuse the compiled chunk when we already have one: parsing the 2 MB reader costs tens of milliseconds,
+    // which a reset or a savestate load would otherwise turn into a visible stall every single time.
+    if (_reader && _reader->CanRestart() && _reader->Restart()) {
+        Log(LogLevel::Info, "reader restarted on a fresh coroutine (compiled chunk reused)");
+        return;
+    }
+
+    _reader.reset();
+
+    ReaderHost host;
+    host.mainRam = &_ram;
+    host.rom = &_rom;
+    host.speech = _speech;
+    host.log = _log;
+    try {
+        _reader = std::make_unique<LuaReader>(host);
+    }
+    catch (...) {
+        Log(LogLevel::Error, "out of memory creating the reader");
+        return;
+    }
+    if (_reader->Load(_source, _chunkName)) {
+        Log(LogLevel::Info, "reader compiled; it starts on the next frame");
+    }
+    // A compile failure has already been logged and spoken by the reader itself; keep the object so the
+    // failure status and message stay visible.
+}
+
+void ReaderSession::ReleaseSyntheticInput() noexcept {
+    if (_touchHeld) {
+        _pending = TouchCommand {true, false, 0, 0};
+        _touchHeld = false;
+        Log(LogLevel::Info, "releasing the synthetic touch the reader left down");
+    }
+}
+
+void ReaderSession::Restart(const char* reason) noexcept {
+    ReleaseSyntheticInput();
+    if (_game == SupportedGame::None || !_config.readerEnabled) return;
+    Log(LogLevel::Info, std::string("restarting the reader (") + (reason ? reason : "restart") + ")");
+    CreateReader();
+}
+
+void ReaderSession::Detach() noexcept {
+    ReleaseSyntheticInput();
+    if (_reader) {
+        Log(LogLevel::Info, "reader detached");
+    }
+    _reader.reset();
+    _game = SupportedGame::None;
+    _identity = CartIdentity {};
+    _ram.Reset();
+    _rom.Reset();
+    _source.clear();
+    _chunkName.clear();
+}
+
+bool ReaderSession::LayerActive() const noexcept {
+    // Deliberately keyed on a RUNNING reader, not merely on the option. A reader that is disabled, deferred
+    // to the next reset, or dead must not keep eating the player's L2/R2/L3: there is nothing left to spend
+    // them on, and the core's own shortcuts are better than nothing.
+    return Active() && _config.layer.layerEnabled;
+}
+
+FilteredInput ReaderSession::FrameStep(const HostInputSnapshot& raw) noexcept {
+    InputOverrides none;
+    const InputOverrides* overrides = &none;
+
+    // The same configuration decides BOTH what the reader may see and what the core keeps. Handing the
+    // reader the trigger names while telling the core the layer is off is what made a disabled layer still
+    // block the game's own buttons.
+    LayerConfig layer = LayerActive() ? _config.layer : LayerConfig {false, false};
+
+    if (_reader && _reader->GetStatus() == LuaReader::Status::Running) {
+        _reader->StepFrame(raw, layer);
+        overrides = &_reader->Overrides();   // cleared by the reader itself if it just died
+    }
+
+    FilteredInput out = ApplyInputLayer(raw, *overrides, layer);
+
+    if (out.touchOverride) {
+        _pending = TouchCommand {true, out.touchDown, out.touchX, out.touchY};
+        _touchHeld = out.touchDown;
+    }
+    else if (_touchHeld && !Active()) {
+        // The reader held a finger down and then died: lift it.
+        ReleaseSyntheticInput();
+    }
+    return out;
+}
+
+ReaderSession::TouchCommand ReaderSession::TakeTouchCommand() noexcept {
+    TouchCommand command = _pending;
+    _pending = TouchCommand {};
+    return command;
+}
+
+bool ReaderSession::Active() const noexcept {
+    return _reader && _reader->GetStatus() == LuaReader::Status::Running;
+}
+
+LuaReader::Status ReaderSession::Status() const noexcept {
+    return _reader ? _reader->GetStatus() : LuaReader::Status::NotLoaded;
+}
+
+const std::string& ReaderSession::LastError() const noexcept {
+    return _reader ? _reader->LastError() : _noError;
+}
+
+uint64_t ReaderSession::FrameCount() const noexcept {
+    return _reader ? _reader->FrameCount() : 0;
+}
+
+uint64_t ReaderSession::BoundsViolations() const noexcept {
+    return _reader ? _reader->BoundsViolations() : 0;
+}
+
+uint64_t ReaderSession::RamWrites() const noexcept {
+    return _reader ? _reader->RamWrites() : 0;
+}
diff --git a/src/libretro/accessibility/reader_session.hpp b/src/libretro/accessibility/reader_session.hpp
new file mode 100644
index 0000000..ea792d2
--- /dev/null
+++ b/src/libretro/accessibility/reader_session.hpp
@@ -0,0 +1,99 @@
+/*
+    melonDS DS Access: reader lifecycle, independent of melonDS and libretro.
+
+    A session owns one LuaReader for one attached cartridge. It enforces the game guard (only IRBO/IRAO
+    revision 0 ever get a reader), applies the controller layer to each frame's input, tracks the synthetic
+    touch so a finger is never left down across restarts, failures or unload, and exposes the core-facing
+    commands (filtered input, touch command) the glue forwards to the console.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "bounded_memory.hpp"
+#include "cart_identity.hpp"
+#include "host_input.hpp"
+#include "lua_reader.hpp"
+#include "speech.hpp"
+
+namespace MelonDsDs::access {
+    struct SessionConfig {
+        bool readerEnabled = true;   // melonds_access_reader
+        LayerConfig layer {};        // melonds_access_controller_layer / melonds_access_l3_role
+    };
+
+    class ReaderSession {
+    public:
+        /// The reader's whole address model is the DS's 4 MiB window (MM 0x02000000, DOMAIN 0x400000 in the
+        /// script). A DSi console reports 16 MiB and has never been validated for this reader, so a window
+        /// of any other size is refused rather than run against an address space we cannot vouch for.
+        static constexpr size_t kDsMainRamWindow = 0x400000;
+
+        struct TouchCommand {
+            bool apply = false;   // send something to the console after the native cursor
+            bool down = false;    // TouchScreen(x, y) when true, ReleaseScreen() when false
+            uint16_t x = 0;
+            uint16_t y = 0;
+        };
+
+        ReaderSession(SpeechDispatcher* speech, LogFn log) noexcept;
+        ~ReaderSession() noexcept;
+        ReaderSession(const ReaderSession&) = delete;
+        ReaderSession& operator=(const ReaderSession&) = delete;
+
+        void SetConfig(const SessionConfig& config) noexcept;
+        [[nodiscard]] const SessionConfig& Config() const noexcept { return _config; }
+
+        /// Identifies the cartridge and, for a supported game with the reader enabled, compiles the reader.
+        /// Any previous attachment is detached first. Unsupported games are refused before any RAM access.
+        SupportedGame Attach(const uint8_t* header, size_t headerLength, BoundedMemory mainRam, BoundedMemory rom,
+                             std::string_view readerSource, std::string_view chunkName) noexcept;
+
+        /// After a console reset or a loaded savestate: lift any synthetic touch and start the reader over.
+        void Restart(const char* reason) noexcept;
+
+        /// On unload: lift any synthetic touch, destroy the reader, forget the cartridge.
+        void Detach() noexcept;
+
+        /// Steps the reader (if running) and returns the input the core should continue with.
+        FilteredInput FrameStep(const HostInputSnapshot& raw) noexcept;
+
+        /// The touch command to send after the native cursor was applied; cleared once taken.
+        TouchCommand TakeTouchCommand() noexcept;
+
+        [[nodiscard]] bool Active() const noexcept;
+        [[nodiscard]] SupportedGame Game() const noexcept { return _game; }
+        [[nodiscard]] const CartIdentity& Identity() const noexcept { return _identity; }
+        [[nodiscard]] LuaReader::Status Status() const noexcept;
+        [[nodiscard]] const std::string& LastError() const noexcept;
+        [[nodiscard]] uint64_t FrameCount() const noexcept;
+        [[nodiscard]] uint64_t BoundsViolations() const noexcept;
+        [[nodiscard]] uint64_t RamWrites() const noexcept;
+        [[nodiscard]] bool LayerActive() const noexcept;
+
+    private:
+        void CreateReader() noexcept;
+        void ReleaseSyntheticInput() noexcept;
+        void Log(LogLevel level, std::string_view message) const noexcept;
+
+        SpeechDispatcher* _speech;
+        LogFn _log;
+        SessionConfig _config {};
+        SupportedGame _game = SupportedGame::None;
+        CartIdentity _identity {};
+        BoundedMemory _ram;
+        BoundedMemory _rom;
+        std::string _source;
+        std::string _chunkName;
+        std::unique_ptr<LuaReader> _reader;
+        bool _touchHeld = false;
+        TouchCommand _pending {};
+        std::string _noError;
+    };
+}
