+            {MelonDsDs::config::values::DISABLED, "Disabled"},
+            {nullptr, nullptr},
+        },
+        MelonDsDs::config::values::ENABLED
+    };
+
+    constexpr retro_core_option_v2_definition AccessL3Role {
+        config::accessibility::L3_ROLE,
+        "L3 Button Role",
+        nullptr,
+        "The reader uses L3 (left stick click) for the shop money readout and, with L2 held, for pathfinding. "
+        "The core normally uses L3 as the microphone button.\n"
+        "\n"
+        "\"Accessibility\" gives L3 to the reader. \"Microphone\" keeps it for the core and the reader never "
+        "sees it, but the microphone still stays shut while the accessibility layer is held, because the "
+        "reader blocks every button during its layer and that block is honoured. Keyboard B still reads the "
+        "shop money and keyboard P still starts pathfinding in either role.\n"
+        "\n"
+        "This setting only applies while the Accessibility Controller Layer is enabled. With that layer off "
+        "the core keeps L3 whatever this is set to.",
+        nullptr,
+        config::accessibility::CATEGORY,
+        {
+            {MelonDsDs::config::values::accessibility::ROLE_ACCESSIBILITY, "Accessibility (money, pathfinding)"},
+            {MelonDsDs::config::values::accessibility::ROLE_MICROPHONE, "Microphone (core default)"},
+            {nullptr, nullptr},
