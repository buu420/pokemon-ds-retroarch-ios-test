diff --git a/src/libretro/accessibility/speech.cpp b/src/libretro/accessibility/speech.cpp
new file mode 100644
index 0000000..a77b662
--- /dev/null
+++ b/src/libretro/accessibility/speech.cpp
@@ -0,0 +1,310 @@
+/*
+    melonDS DS Access: speech sinks and the logging dispatcher.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#include "speech.hpp"
+
+using namespace MelonDsDs::access;
+
+bool RecordingSpeechSink::Say(std::string_view utf8, bool interrupt) noexcept {
+    try {
+        events.push_back(SpeechEvent {SpeechEvent::Kind::Say, std::string(utf8), interrupt});
+    }
+    catch (...) {
+        return false;
+    }
+    return !failSay;
+}
+
+bool RecordingSpeechSink::Stop() noexcept {
+    try {
+        events.push_back(SpeechEvent {SpeechEvent::Kind::Stop, std::string(), true});
+    }
+    catch (...) {
+        return false;
+    }
+    return !failStop;
+}
+
+std::string MelonDsDs::access::ComposeFatalError(std::string_view message, std::string_view recovery) noexcept {
+    try {
+        std::string text(message);
+        if (!recovery.empty() && recovery != message) {
+            if (!text.empty()) {
+                char last = text.back();
+                if (last != '.' && last != '!' && last != '?' && last != ':') text += '.';
+                text += ' ';
+            }
+            text.append(recovery.data(), recovery.size());
+        }
+        return text;
+    }
+    catch (...) {
+        return std::string();
+    }
+}
+
+SpeechDispatcher::SpeechDispatcher(SpeechSink* sink, LogFn log) noexcept
+    : _sink(sink), _log(std::move(log)) {}
+
+void SpeechDispatcher::Promote(SpeechSink* sink) noexcept {
+    if (!sink) return;
+    _sink = sink;
+    _demoted = false;
+    _consecutiveFailures = 0;
+    try {
+        Log(LogLevel::Info, std::string("speech backend restored to '") + sink->Name() + "'");
+    }
+    catch (...) {
+    }
+}
+
+void SpeechDispatcher::SetFallbackSink(SpeechSink* fallback, unsigned threshold) noexcept {
+    _fallback = fallback;
+    _failureThreshold = threshold;
+}
+
+std::string SpeechDispatcher::EscapeForLog(std::string_view text) {
+    std::string out;
+    out.reserve(text.size() + 8);
+    for (unsigned char c : text) {
+        switch (c) {
+            case '\n': out += "\\n"; break;
+            case '\r': out += "\\r"; break;
+            case '\t': out += "\\t"; break;
+            case '"': out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            default:
+                if (c < 0x20) {
+                    static constexpr char digits[] = "0123456789abcdef";
+                    out += "\\x";
+                    out += digits[c >> 4];
+                    out += digits[c & 0xF];
+                }
+                else {
+                    out += char(c);
+                }
+        }
+    }
+    return out;
+}
+
+void SpeechDispatcher::Log(LogLevel level, std::string_view message) noexcept {
+    if (!_log) return;
+    try {
+        _log(level, message);
+    }
+    catch (...) {
+        // Logging must never take the reader down.
+    }
+}
+
+void SpeechDispatcher::AnnounceProblem(std::string text, uint64_t graceFrames) noexcept {
+    if (text.empty()) return;
+    try {
+        if (_pending.armed && !_pending.text.empty()) {
+            // Two problems before either was delivered: keep both, oldest first.
+            _pending.text += " ";
+            _pending.text += text;
+        }
+        else {
+            _pending.text = std::move(text);
+        }
+        _pending.armed = true;
+        _pending.framesLeft = graceFrames;
+        _pendingGraceFrames = graceFrames;
+    }
+    catch (...) {
+        _pending.armed = false;
+    }
+}
+
+std::string SpeechDispatcher::TakePending() noexcept {
+    if (!_pending.armed) return std::string();
+    std::string text;
+    try {
+        text = std::move(_pending.text);
+    }
+    catch (...) {
+    }
+    _pending = Pending {};
+    return text;
+}
+
+void SpeechDispatcher::Tick() noexcept {
+    if (!_pending.armed) return;
+    if (_pending.framesLeft > 0) --_pending.framesLeft;
+    // Flushes ON the graceFrames'th tick, so AnnounceProblem(text, 3) waits exactly three frames.
+    if (_pending.framesLeft > 0) return;
+    // Nothing followed the problem, so nothing can carry it: say it on its own. Deliberately through Say
+    // rather than Deliver, so that a diagnostic which ALSO fails counts as a failure and can trigger the
+    // fallback -- the backend being broken is exactly when a diagnostic matters most.
+    std::string text = TakePending();
+    if (text.empty()) return;
+    Log(LogLevel::Warn, "speech announcing a pending diagnostic on its own (nothing followed it)");
+    if (!Say(text, true) && !_pending.armed) {
+        // Every backend refused it. Stop re-arming (that would retry forever) and let the owner put it on
+        // screen instead, which is the only channel left.
+        _announcementUndeliverable = true;
+        Log(LogLevel::Error, "speech: no backend could deliver the diagnostic; falling back to an on-screen message");
+    }
+}
+
+bool SpeechDispatcher::Deliver(SpeechSink* sink, std::string_view text, bool interrupt) noexcept {
+    // Before anything is decided or written down: a backend's abilities can change between two lines, and
+    // both the flags this request asks for and the "degraded" note below must describe the backend as it
+    // is now. This is also why the fallback is refreshed on its own replay -- it is a different backend.
+    if (sink) sink->RefreshCapabilities();
+    try {
+        const char* backend = sink ? sink->Name() : "none";
+        bool degraded = sink && !interrupt && !sink->SupportsQueue();
+        std::string line = "speech say interrupt=";
+        line += interrupt ? "true" : "false";
+        line += " backend=";
+        line += backend;
+        if (degraded) line += " degraded=queue-spoken-as-interrupt";
+        line += " text=\"";
+        line += EscapeForLog(text);
+        line += "\"";
+        Log(LogLevel::Info, line);
+    }
+    catch (...) {
+    }
+    if (!sink) return false;
+    return sink->Say(text, interrupt);
+}
+
+bool SpeechDispatcher::Say(std::string_view utf8, bool interrupt) noexcept {
+    ++_calls;
+
+    // A pending diagnostic rides on this line, so the reader's own next line cannot erase it. It is only
+    // CONSUMED once something actually spoke it: if delivery fails, it is re-armed below, because the case
+    // where delivery fails is exactly the case a diagnostic is about.
+    std::string composed;
+    std::string carried;
+    std::string_view text = utf8;
+    if (_pending.armed) {
+        try {
+            carried = TakePending();
+            if (!carried.empty()) {
+                composed = carried;
+                composed += " ";
+                composed.append(utf8.data(), utf8.size());
+                text = composed;
+            }
+        }
+        catch (...) {
+            carried.clear();
+            text = utf8;
+        }
+    }
+
+    if (!_sink) {
+        ++_failures;
+        ++_consecutiveFailures;
+        _lastError = "no speech backend";
+        Log(LogLevel::Error, "speech FAILED: no speech backend is available");
+        return false;
+    }
+
+    if (Deliver(text, interrupt)) {
+        _consecutiveFailures = 0;
+        return true;
+    }
+
+    ++_failures;
+    // Nothing spoke the diagnostic, so it must not be lost; put it back for the next attempt.
+    if (!carried.empty()) AnnounceProblem(carried, _pendingGraceFrames);
+    ++_consecutiveFailures;
+    try {
+        _lastError = std::string("backend '") + _sink->Name() + "' rejected the request";
+        Log(LogLevel::Error, "speech FAILED (" + std::to_string(_consecutiveFailures) + " in a row): " + _lastError);
+    }
+    catch (...) {
+    }
+
+    // A backend that worked and then stopped answering must not leave the reader silently running. After a
+    // bounded number of consecutive failures, move to the fallback for the rest of the session, carry the
+    // line that was lost, and tell the player -- once, because we never switch back.
+    bool shouldDemote = !_demoted && _fallback && _failureThreshold > 0
+        && _sink != _fallback && _consecutiveFailures >= _failureThreshold;
+
+    if (!shouldDemote) {
+        // The THRESHOLD decides when to give up on the primary backend. It must never decide whether the
+        // player hears this line: missing game information is the worst outcome this tool has. So replay
+        // the refused line -- exactly once, through the fallback, with its own interrupt flag -- while the
+        // primary keeps the rest of its chances.
+        if (_fallback && _sink != _fallback) {
+            ++_replays;
+            try {
+                Log(LogLevel::Warn, std::string("speech: replaying the refused line through '")
+                    + _fallback->Name() + "' so nothing is lost (failure "
+                    + std::to_string(_consecutiveFailures) + " of " + std::to_string(_failureThreshold)
+                    + " before the primary is dropped)");
+            }
+            catch (...) {
+            }
+            if (Deliver(_fallback, text, interrupt)) {
+                // It was heard, so a diagnostic riding on it has been heard too.
+                if (!carried.empty() && _pending.armed && _pending.text == carried) _pending = Pending {};
+                return true;
+            }
+        }
+        return false;
+    }
+
+    _demoted = true;
+    try {
+        Log(LogLevel::Warn, std::string("speech backend '") + _sink->Name() + "' failed "
+            + std::to_string(_consecutiveFailures) + " times in a row; falling back to '"
+            + _fallback->Name() + "' for the rest of this session");
+    }
+    catch (...) {
+    }
+    _sink = _fallback;
+
+    std::string retry;
+    try {
+        retry = kDemotionDiagnostic;
+        retry += " ";
+        retry.append(text.data(), text.size());
+    }
+    catch (...) {
+        retry.assign(text.data(), text.size());
+    }
+    if (Deliver(retry, interrupt)) {
+        _consecutiveFailures = 0;
+        // The fallback spoke it, so whatever was carried has now been heard.
+        if (!carried.empty() && _pending.armed && _pending.text == carried) _pending = Pending {};
+        return true;
+    }
+    Log(LogLevel::Error, "speech FAILED: the fallback backend refused the request too");
+    return false;
+}
+
+bool SpeechDispatcher::Stop() noexcept {
+    ++_calls;
+    if (_sink) _sink->RefreshCapabilities();
+    try {
+        Log(LogLevel::Info, std::string("speech stop backend=") + (_sink ? _sink->Name() : "none"));
+    }
+    catch (...) {
+    }
+    if (!_sink) {
+        ++_failures;
+        _lastError = "no speech backend";
+        return false;
+    }
+    bool ok = _sink->Stop();
+    if (!ok) {
+        ++_failures;
+        try {
+            _lastError = std::string("backend '") + _sink->Name() + "' failed to stop";
+            Log(LogLevel::Error, "speech FAILED: " + _lastError);
+        }
+        catch (...) {
+        }
+    }
+    return ok;
+}
diff --git a/src/libretro/accessibility/speech.hpp b/src/libretro/accessibility/speech.hpp
new file mode 100644
index 0000000..be2edaa
--- /dev/null
+++ b/src/libretro/accessibility/speech.hpp
@@ -0,0 +1,157 @@
+/*
+    melonDS DS Access: speech sinks and the logging dispatcher.
+
+    The reader's contract is BizHawk's speech.say(text[, interrupt]) / speech.stop():
+      * interrupt (default true) cuts whatever is speaking and speaks now;
+      * interrupt == false queues the text after the current speech;
+      * stop() silences current speech.
+    Every action is logged with its full UTF-8 text, whatever the backend.
+
+    The dispatcher also owns two things the reader cannot do for itself:
+      * a bounded fallback, so a backend that dies mid-session degrades instead of going silent, and
+      * deferred problem announcements, so a diagnostic is never erased by the reader's next line.
+
+    This file is part of melonDS DS and is licensed under the GPLv3 or later.
+*/
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace MelonDsDs::access {
+    enum class LogLevel { Debug, Info, Warn, Error };
+    using LogFn = std::function<void(LogLevel, std::string_view)>;
+
+    class SpeechSink {
+    public:
+        virtual ~SpeechSink() = default;
+        virtual bool Say(std::string_view utf8, bool interrupt) noexcept = 0;
+        virtual bool Stop() noexcept = 0;
+        [[nodiscard]] virtual const char* Name() const noexcept = 0;
+        /// False for backends that can only interrupt (the frontend callback); queued requests are then
+        /// spoken immediately and logged as degraded.
+        [[nodiscard]] virtual bool SupportsQueue() const noexcept { return true; }
+        /// Called by the dispatcher at the start of EVERY request, before it reads SupportsQueue() and
+        /// before the request is issued. A backend whose abilities can change underneath it -- the
+        /// frontend narrator being switched off, NVDA exiting, RetroArch moving from one speech backend
+        /// to another -- re-asks here, so both the request and the log describe what is true right now
+        /// instead of what was true when the session attached. Most sinks have nothing to refresh.
+        virtual void RefreshCapabilities() noexcept {}
+    };
+
+    struct SpeechEvent {
+        enum class Kind { Say, Stop };
+        Kind kind;
+        std::string text;
+        bool interrupt;
+    };
+
+    /// Records events; used by the tests and by MELONDSDS_ACCESSIBILITY_LOG_ONLY=1.
+    class RecordingSpeechSink final : public SpeechSink {
+    public:
+        std::vector<SpeechEvent> events;
+        bool failSay = false;
+        bool failStop = false;
+        const char* name = "log";
+
+        bool Say(std::string_view utf8, bool interrupt) noexcept override;
+        bool Stop() noexcept override;
+        [[nodiscard]] const char* Name() const noexcept override { return name; }
+    };
+
+    /// Accepts everything and speaks nothing; the dispatcher's log line is the only trace.
+    class LogOnlySpeechSink final : public SpeechSink {
+    public:
+        bool Say(std::string_view, bool) noexcept override { return true; }
+        bool Stop() noexcept override { return true; }
+        [[nodiscard]] const char* Name() const noexcept override { return "log-only"; }
+    };
+
+    /// Composes the spoken form of a fatal configuration error: what went wrong, then what to do about it.
+    /// The two strings are often identical (emulator_exception's single-argument constructor copies what()
+    /// into the user message), in which case it is said once.
+    std::string ComposeFatalError(std::string_view message, std::string_view recovery) noexcept;
+
+    /// Logs every action and forwards it to the current sink. Never throws.
+    class SpeechDispatcher {
+    public:
+        /// The production failure policy, declared here so the regressions cannot pass against a different
+        /// configuration than the core actually ships. A line is NEVER lost while waiting for this: every
+        /// refused line is replayed through the fallback immediately. The threshold only decides when the
+        /// primary backend is given up on for good, so one transient hiccup does not cost a good backend.
+        static constexpr unsigned kDefaultFailureThreshold = 3;
+
+        /// Spoken once when a working backend stops responding and speech moves to the fallback.
+        static constexpr const char* kDemotionDiagnostic =
+            "Speech backend stopped responding; the screen reader connection was lost. "
+            "Speech continues through RetroArch's own narrator.";
+
+        SpeechDispatcher(SpeechSink* sink, LogFn log) noexcept;
+
+        void SetSink(SpeechSink* sink) noexcept { _sink = sink; }
+        [[nodiscard]] SpeechSink* Sink() const noexcept { return _sink; }
+
+        /// Installs a backend the caller has just re-created and verified, clearing the demoted state so it
+        /// can be trusted again. Only the owner can do this: the dispatcher never promotes on its own,
+        /// because the sink it demoted is by definition one that stopped answering.
+        void Promote(SpeechSink* sink) noexcept;
+
+        /// After `threshold` CONSECUTIVE failures the dispatcher switches to `fallback` for the rest of the
+        /// session, retries the line that failed, and tells the player once. Passing nullptr disables it.
+        /// It never switches back on its own, so there is no flapping and no retry loop.
+        void SetFallbackSink(SpeechSink* fallback, unsigned threshold) noexcept;
+
+        bool Say(std::string_view utf8, bool interrupt) noexcept;
+        bool Stop() noexcept;
+
+        /// Announce an adapter problem so the reader's next line cannot erase it: the text is prepended to
+        /// that line, and if no line follows within `graceFrames` Tick()s it is spoken on its own.
+        void AnnounceProblem(std::string text, uint64_t graceFrames) noexcept;
+        /// True once a problem announcement has been through every backend and still could not be spoken.
+        /// The owner uses this to fall back to an on-screen message.
+        [[nodiscard]] bool AnnouncementUndeliverable() const noexcept { return _announcementUndeliverable; }
+        /// One call per emulated frame; flushes an announcement whose grace period has run out.
+        void Tick() noexcept;
+        [[nodiscard]] bool HasPendingAnnouncement() const noexcept { return _pending.armed; }
+
+        [[nodiscard]] uint64_t Calls() const noexcept { return _calls; }
+        [[nodiscard]] uint64_t Failures() const noexcept { return _failures; }
+        [[nodiscard]] uint64_t ConsecutiveFailures() const noexcept { return _consecutiveFailures; }
+        /// How many refused lines were re-delivered through the fallback without demoting the primary.
+        [[nodiscard]] uint64_t Replays() const noexcept { return _replays; }
+        [[nodiscard]] bool Demoted() const noexcept { return _demoted; }
+        [[nodiscard]] const std::string& LastError() const noexcept { return _lastError; }
+
+        /// Escapes control characters and quotes so a log line stays one line.
+        static std::string EscapeForLog(std::string_view text);
+
+    private:
+        struct Pending {
+            bool armed = false;
+            std::string text;
+            uint64_t framesLeft = 0;
+        };
+
+        void Log(LogLevel level, std::string_view message) noexcept;
+        bool Deliver(SpeechSink* sink, std::string_view text, bool interrupt) noexcept;
+        bool Deliver(std::string_view text, bool interrupt) noexcept { return Deliver(_sink, text, interrupt); }
+        std::string TakePending() noexcept;
+
+        SpeechSink* _sink;
+        SpeechSink* _fallback = nullptr;
+        unsigned _failureThreshold = 0;
+        LogFn _log;
+        uint64_t _calls = 0;
+        uint64_t _failures = 0;
+        uint64_t _consecutiveFailures = 0;
+        uint64_t _replays = 0;
+        bool _demoted = false;
+        Pending _pending;
+        uint64_t _pendingGraceFrames = 0;
+        bool _announcementUndeliverable = false;
+        std::string _lastError;
+    };
+}
