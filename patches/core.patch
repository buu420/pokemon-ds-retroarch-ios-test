+TEST_CASE(review_a_restored_backend_can_be_trusted_again_after_verification) {
+    // Prism's screen-reader backends never reconnect on their own, so the owner re-creates the instance and
+    // only then promotes it. The dispatcher must accept that and forget the demotion, but must never
+    // promote a sink by itself -- the one it demoted is by definition the one that stopped answering.
+    FlakySink flaky;
+    flaky.successes = 0;
+    RecordingSpeechSink fallback;
+    fallback.name = "frontend";
+    RecordingSpeechSink restored;
+    restored.name = "prism:NVDA";
+    SpeechDispatcher speech(&flaky, nullptr);
+    speech.SetFallbackSink(&fallback, 2);
+
+    REQUIRE(speech.Say("a", true));            // refused, replayed through the fallback, not yet demoted
+    REQUIRE(!speech.Demoted());
+    REQUIRE(speech.Say("b", true));            // second failure demotes and re-speaks through the fallback
+    REQUIRE(speech.Demoted());
+    REQUIRE(speech.Sink() == &fallback);
+
+    speech.Promote(&restored);
+    REQUIRE(!speech.Demoted());
+    REQUIRE_EQ(speech.ConsecutiveFailures(), uint64_t(0));
+    REQUIRE(speech.Say("c", false));
+    REQUIRE_EQ(restored.events.size(), size_t(1));
+    REQUIRE_EQ(restored.events[0].text, std::string("c"));
+    REQUIRE(!restored.events[0].interrupt);    // and queueing works again
+
+    // A second death still demotes, and the lines in between still reach the player.
+    restored.failSay = true;
+    REQUIRE(speech.Say("d", true));
+    REQUIRE(!speech.Demoted());
+    REQUIRE(speech.Say("e", true));
+    REQUIRE(speech.Demoted());
+    REQUIRE(speech.Sink() == &fallback);
+}
