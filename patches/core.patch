+TEST_CASE(memory_domains_follow_rebound_views_without_stale_metadata) {
+    Fixture f;
+    REQUIRE(f.reader.Load(R"(
+        assert(memory.getmemorydomainsize("ROM") == 512)
+        emu.frameadvance()
+        local domains = memory.getmemorydomainlist()
+        assert(domains[0] == "ROM" and domains[1] == nil)
+        assert(memory.getmemorydomainsize("ROM") == 17)
+        assert(memory.getmemorydomainsize("Main RAM") == 0)
+        emu.frameadvance()
+        domains = memory.getmemorydomainlist()
+        assert(domains[0] == "Main RAM" and domains[1] == nil)
