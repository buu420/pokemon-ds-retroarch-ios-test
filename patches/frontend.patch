diff --git a/ui/drivers/cocoa/cocoa_accessibility.m b/ui/drivers/cocoa/cocoa_accessibility.m
new file mode 100644
index 0000000000000000000000000000000000000000..679d7841e83273c3b0b6a9d297f53ca2b5e24790
--- /dev/null
+++ b/ui/drivers/cocoa/cocoa_accessibility.m
@@ -0,0 +1,330 @@
+/* RetroArch - A frontend for libretro. SPDX-License-Identifier: GPL-3.0-or-later */
+#import "cocoa_common.h"
+#import "cocoa_accessibility.h"
+
+#if defined(HAVE_COCOATOUCH) && TARGET_OS_IOS && defined(HAVE_MENU) && defined(HAVE_OZONE)
+#include "../../../menu/menu_accessibility.h"
+#include "../../../menu/menu_driver.h"
+#include "../../../accessibility.h"
+#include "../../../input/drivers/cocoa_input.h"
+
+static NSString *RAMenuString(const char *text)
+{
+   return text ? ([NSString stringWithUTF8String:text] ?: @"") : @"";
+}
+
+static NSString *RAMenuGestureHelp(void)
+{
+   return @"Swipe up or down to browse categories or items. Swipe right to enter. "
+          @"Swipe left to go back. Double-tap to activate. "
+          @"Swipe left or right with two fingers to change a setting's value. "
+          @"Tap once to read the selection. Long-press for help.";
+}
+
+@interface RAMenuAccessibilityView : UIView <UIGestureRecognizerDelegate>
+@property(nonatomic, assign) UIViewController *menuController;
+@property(nonatomic, assign) BOOL keyboardVisible;
+@property(nonatomic, assign) BOOL menuSession;
+- (BOOL)available;
+- (void)refresh;
+- (BOOL)perform:(enum menu_accessibility_gesture)gesture;
+- (void)disable;
+@end
+
+static RAMenuAccessibilityView *ra_menu_accessibility_view;
+
+@implementation RAMenuAccessibilityView
+- (instancetype)initWithFrame:(CGRect)frame
+{
+   if (!(self = [super initWithFrame:frame]))
+      return nil;
+   self.backgroundColor = UIColor.clearColor;
+   self.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+   self.isAccessibilityElement = YES;
+   self.accessibilityTraits = UIAccessibilityTraitAllowsDirectInteraction;
+   self.accessibilityViewIsModal = YES;
+   self.accessibilityIdentifier = @"retroarch.voiceover.menu";
+   self.accessibilityHint = RAMenuGestureHelp();
+   self.hidden = YES;
+#if __IPHONE_OS_VERSION_MAX_ALLOWED >= 170000
+   if (@available(iOS 17.0, *))
+      self.accessibilityDirectTouchOptions = UIAccessibilityDirectTouchOptionSilentOnTouch;
+#endif
+
+   const UISwipeGestureRecognizerDirection directions[] = {
+      UISwipeGestureRecognizerDirectionUp, UISwipeGestureRecognizerDirectionDown,
+      UISwipeGestureRecognizerDirectionLeft, UISwipeGestureRecognizerDirectionRight
+   };
+   for (unsigned i = 0; i < 4; ++i)
+   {
+      UISwipeGestureRecognizer *swipe = [[UISwipeGestureRecognizer alloc]
+            initWithTarget:self action:@selector(swiped:)];
+      swipe.direction = directions[i];
+      swipe.numberOfTouchesRequired = 1;
+      swipe.delegate = self;
+      [self addGestureRecognizer:swipe];
+   }
+   for (unsigned i = 2; i < 4; ++i)
+   {
+      UISwipeGestureRecognizer *swipe = [[UISwipeGestureRecognizer alloc]
+            initWithTarget:self action:@selector(adjusted:)];
+      swipe.direction = directions[i];
+      swipe.numberOfTouchesRequired = 2;
+      swipe.delegate = self;
+      [self addGestureRecognizer:swipe];
+   }
+   UITapGestureRecognizer *activate = [[UITapGestureRecognizer alloc]
+         initWithTarget:self action:@selector(tappedTwice:)];
+   activate.numberOfTapsRequired = 2;
+   activate.delegate = self;
+   [self addGestureRecognizer:activate];
+   UITapGestureRecognizer *read = [[UITapGestureRecognizer alloc]
+         initWithTarget:self action:@selector(tappedOnce:)];
+   read.delegate = self;
+   [read requireGestureRecognizerToFail:activate];
+   [self addGestureRecognizer:read];
+   UILongPressGestureRecognizer *help = [[UILongPressGestureRecognizer alloc]
+         initWithTarget:self action:@selector(held:)];
+   help.delegate = self;
+   [self addGestureRecognizer:help];
+
+   self.accessibilityCustomActions = @[
+      [[UIAccessibilityCustomAction alloc] initWithName:@"Previous item or category" target:self selector:@selector(previous)],
+      [[UIAccessibilityCustomAction alloc] initWithName:@"Next item or category" target:self selector:@selector(next)],
+      [[UIAccessibilityCustomAction alloc] initWithName:@"Enter submenu" target:self selector:@selector(enter)],
+      [[UIAccessibilityCustomAction alloc] initWithName:@"Back" target:self selector:@selector(back)],
+      [[UIAccessibilityCustomAction alloc] initWithName:@"Activate selected item" target:self selector:@selector(activateItem)],
+      [[UIAccessibilityCustomAction alloc] initWithName:@"Increase value" target:self selector:@selector(increase)],
+      [[UIAccessibilityCustomAction alloc] initWithName:@"Decrease value" target:self selector:@selector(decrease)],
+      [[UIAccessibilityCustomAction alloc] initWithName:@"Read selection" target:self selector:@selector(readSelection)],
+      [[UIAccessibilityCustomAction alloc] initWithName:@"Menu gesture help" target:self selector:@selector(readHelp)]
+   ];
+   NSNotificationCenter *center = NSNotificationCenter.defaultCenter;
+   [center addObserver:self selector:@selector(keyboardWillShow:) name:UIKeyboardWillShowNotification object:nil];
+   [center addObserver:self selector:@selector(keyboardWillHide:) name:UIKeyboardWillHideNotification object:nil];
+   [center addObserver:self selector:@selector(suspend:) name:UIApplicationWillResignActiveNotification object:nil];
+   [center addObserver:self selector:@selector(suspend:) name:UIAccessibilityVoiceOverStatusDidChangeNotification object:nil];
+   return self;
+}
+
+- (void)disable
+{
+   self.hidden = YES;
+   menu_accessibility_cancel_action();
+}
+
+- (void)suspend:(NSNotification *)notification
+{
+   [self disable];
+   self.menuSession = NO;
+}
+- (void)keyboardWillShow:(NSNotification *)notification
+{
+   self.keyboardVisible = YES;
+   [self disable];
+}
+- (void)keyboardWillHide:(NSNotification *)notification
+{
+   self.keyboardVisible = NO;
+}
+
+- (BOOL)available
+{
+   menu_accessibility_state_t state;
+   for (UIViewController *parent = self.menuController; parent; parent = parent.parentViewController)
+      if (parent.presentedViewController)
+         return NO;
+   return UIAccessibilityIsVoiceOverRunning()
+         && UIApplication.sharedApplication.applicationState == UIApplicationStateActive
+         && self.menuController && self.menuController.isViewLoaded
+         && self.menuController.view.window && !self.menuController.view.hidden
+         && !self.menuController.presentedViewController && !self.keyboardVisible
+         && ozone_accessibility_get_state(&state);
+}
+
+- (void)speak:(NSString *)text
+{
+   if (![self available] || !text.length)
+      return;
+#ifdef HAVE_ACCESSIBILITY
+   settings_t *settings = config_get_ptr();
+   if (accessibility_speak_priority(true,
+         settings->uints.accessibility_narrator_speech_speed, text.UTF8String, 10))
+      return;
+#endif
+   UIAccessibilityPostNotification(UIAccessibilityAnnouncementNotification, text);
+}
+
+- (void)refresh
+{
+   menu_accessibility_state_t state;
+   if (![self available] || !ozone_accessibility_get_state(&state))
+   {
+      [self disable];
+      if (!(menu_state_get_ptr()->flags & MENU_ST_FLAG_ALIVE))
+         self.menuSession = NO;
+      return;
+   }
+   BOOL appeared = self.hidden;
+   if (!self.menuSession)
+   {
+      self.menuSession = YES;
+      /* Start with categories on the main screen, retain nested Quick Menu. */
+      if (state.depth == 1 && !state.category && !state.message)
+         ozone_accessibility_perform(MENU_ACCESS_BACK);
+   }
+   self.hidden = NO;
+   [self.superview bringSubviewToFront:self];
+   NSString *label = RAMenuString(state.label);
+   if (!label.length)
+      label = state.count ? RAMenuString(state.title) : @"Empty list";
+   NSString *value = RAMenuString(state.value);
+   NSString *position = state.count ? [NSString stringWithFormat:@"%lu of %lu",
+         (unsigned long)state.position + 1, (unsigned long)state.count] : @"";
+   if (state.category)
+      value = [NSString stringWithFormat:@"Category, %@", position];
+   else if (position.length)
+      value = value.length ? [NSString stringWithFormat:@"%@, %@", value, position] : position;
+   BOOL changed = ![self.accessibilityLabel isEqualToString:label]
+         || ![self.accessibilityValue isEqualToString:value];
+   self.accessibilityLabel = label;
+   self.accessibilityValue = value;
+
+   if (appeared)
+   {
+      /* Focus once when entering the menu, never on each selection. Focusing
+       * this surface only reads it; it never executes the selected command. */
+      UIAccessibilityPostNotification(UIAccessibilityScreenChangedNotification, self);
+   }
+#ifdef HAVE_ACCESSIBILITY
+   else if (changed && !is_accessibility_enabled(config_get_ptr()->bools.accessibility_enable,
+         access_state_get_ptr()->enabled))
+#else
+   else if (changed)
+#endif
+      UIAccessibilityPostNotification(UIAccessibilityAnnouncementNotification,
+            [NSString stringWithFormat:@"%@. %@", label, value]);
+}
+
+- (BOOL)perform:(enum menu_accessibility_gesture)gesture
+{
+   menu_accessibility_state_t state;
+   if (![self available] || !ozone_accessibility_get_state(&state))
+      return NO;
+   if (menu_accessibility_action(&state, gesture) == MENU_ACTION_NOOP)
+   {
+      if (gesture == MENU_ACCESS_ENTER && state.count && !state.message)
+         [self speak:@"Double-tap to activate this item."];
+      else if (gesture == MENU_ACCESS_INCREASE || gesture == MENU_ACCESS_DECREASE)
+         [self speak:@"This item has no adjustable value. Double-tap to activate."];
+      else
+         [self readSelection];
+      return YES;
+   }
+   return ozone_accessibility_perform(gesture);
+}
+
+- (void)swiped:(UISwipeGestureRecognizer *)recognizer
+{
+   if (recognizer.state != UIGestureRecognizerStateRecognized)
+      return;
+   switch (recognizer.direction)
+   {
+      case UISwipeGestureRecognizerDirectionUp: [self previous]; break;
+      case UISwipeGestureRecognizerDirectionDown: [self next]; break;
+      case UISwipeGestureRecognizerDirectionLeft: [self back]; break;
+      case UISwipeGestureRecognizerDirectionRight: [self enter]; break;
+      default: break;
+   }
+}
+- (void)adjusted:(UISwipeGestureRecognizer *)recognizer
+{
+   if (recognizer.state == UIGestureRecognizerStateRecognized)
+      [self perform:recognizer.direction == UISwipeGestureRecognizerDirectionRight
+            ? MENU_ACCESS_INCREASE : MENU_ACCESS_DECREASE];
+}
+- (void)tappedTwice:(UITapGestureRecognizer *)recognizer
+{
+   if (recognizer.state == UIGestureRecognizerStateRecognized)
+      [self activateItem];
+}
+- (void)tappedOnce:(UITapGestureRecognizer *)recognizer
+{
+   if (recognizer.state == UIGestureRecognizerStateRecognized)
+      [self readSelection];
+}
+- (void)held:(UILongPressGestureRecognizer *)recognizer
+{
+   if (recognizer.state == UIGestureRecognizerStateBegan)
+      [self readHelp];
+}
+- (BOOL)gestureRecognizerShouldBegin:(UIGestureRecognizer *)recognizer
+{
+   return [self available];
+}
+- (BOOL)gestureRecognizer:(UIGestureRecognizer *)recognizer
+      shouldRecognizeSimultaneouslyWithGestureRecognizer:(UIGestureRecognizer *)other
+{
+   return NO;
+}
+
+- (BOOL)previous { return [self perform:MENU_ACCESS_PREVIOUS]; }
+- (BOOL)next { return [self perform:MENU_ACCESS_NEXT]; }
+- (BOOL)enter { return [self perform:MENU_ACCESS_ENTER]; }
+- (BOOL)back { return [self perform:MENU_ACCESS_BACK]; }
+- (BOOL)activateItem { return [self perform:MENU_ACCESS_ACTIVATE]; }
+- (BOOL)increase { return [self perform:MENU_ACCESS_INCREASE]; }
+- (BOOL)decrease { return [self perform:MENU_ACCESS_DECREASE]; }
+- (BOOL)accessibilityActivate { return [self activateItem]; }
+- (BOOL)accessibilityPerformEscape { return [self back]; }
+- (void)accessibilityIncrement { [self next]; }
+- (void)accessibilityDecrement { [self previous]; }
+- (BOOL)readSelection
+{
+   if (![self available])
+      return NO;
+   [self speak:[NSString stringWithFormat:@"%@. %@", self.accessibilityLabel, self.accessibilityValue]];
+   return YES;
+}
+- (BOOL)readHelp
+{
+   menu_accessibility_state_t state;
+   if (![self available] || !ozone_accessibility_get_state(&state))
+      return NO;
+   [self speak:[NSString stringWithFormat:@"%@. %@", RAMenuString(state.help), RAMenuGestureHelp()]];
+   return YES;
+}
+@end
+
+void cocoa_accessibility_update(UIViewController *controller)
+{
+   if (!controller || !controller.isViewLoaded)
+      return;
+   if (!ra_menu_accessibility_view && UIAccessibilityIsVoiceOverRunning())
+   {
+      ra_menu_accessibility_view = [[RAMenuAccessibilityView alloc] initWithFrame:controller.view.bounds];
+      ra_menu_accessibility_view.menuController = controller;
+      [controller.view addSubview:ra_menu_accessibility_view];
+   }
+   if (ra_menu_accessibility_view)
+   {
+      BOOL wasHidden = ra_menu_accessibility_view.hidden;
+      [ra_menu_accessibility_view refresh];
+      if (wasHidden && !ra_menu_accessibility_view.hidden)
+      {
+         cocoa_input_data_t *apple = (cocoa_input_data_t*)input_state_get_ptr()->current_data;
+         if (apple)
+            apple->touch_count = 0;
+      }
+   }
+}
+
+BOOL cocoa_accessibility_owns_touch(UITouch *touch)
+{
+   /* Ownership lasts until the touch ends, even if activation closed the menu.
+    * Its ending event must not leak into a game or native keyboard underneath. */
+   return ra_menu_accessibility_view && touch.view
+         && ((!ra_menu_accessibility_view.hidden && [ra_menu_accessibility_view available])
+            || [touch.view isDescendantOfView:ra_menu_accessibility_view]);
+}
+#endif
