+{
+   /**
+    * Set by the CORE to \c sizeof(struct retro_accessibility_speech_interface).
+    * The frontend refuses sizes smaller than the version it knows, and never
+    * writes more than this many bytes.
+    */
+   unsigned size;
+
+   /**
+    * Set by the frontend to a bitwise OR of
+    * \c RETRO_ACCESSIBILITY_SPEECH_CAP_* values. May be 0.
+    */
+   uint64_t capabilities;
+
+   /**
+    * Set by the frontend to a short, stable identifier for the active speech
+    * backend, such as "nvda", "sapi", "powershell" or "disabled". Owned by the
+    * frontend and valid until the next call. May be \c NULL.
+    */
+   const char *backend;
+};
