+   /* The pre-10.14 fallback forks one `say` per line and kills the previous one
+    * before starting the next, so it can speak and nothing more. Advertising
+    * only SPEAK keeps every request on the legacy path with flags == 0, which
+    * is exactly what that path does today. */
+   if (backend)
+      *backend = "say";
+   return RETRO_ACCESSIBILITY_SPEECH_CAP_SPEAK;
+#else
+   return 0;
+#endif
