+#include <assert.h>
+#include <stdio.h>
+#include "../../menu/menu_accessibility.h"
+
+int main(void)
+{
+   menu_accessibility_state_t s = {0};
+   enum menu_action pending;
+   s.category = true;
+   s.count = 4;
+   s.depth = 1;
+   assert(menu_accessibility_action(&s, MENU_ACCESS_PREVIOUS) == MENU_ACTION_UP);
+   assert(menu_accessibility_action(&s, MENU_ACCESS_NEXT) == MENU_ACTION_DOWN);
+   assert(menu_accessibility_action(&s, MENU_ACCESS_ENTER) == MENU_ACTION_RIGHT);
+   assert(menu_accessibility_action(&s, MENU_ACCESS_ACTIVATE) == MENU_ACTION_RIGHT);
+   assert(menu_accessibility_action(&s, MENU_ACCESS_BACK) == MENU_ACTION_NOOP);
+
+   s.category = false;
+   s.can_enter = false; /* Save Current Configuration must not run on a flick. */
+   assert(menu_accessibility_action(&s, MENU_ACCESS_ENTER) == MENU_ACTION_NOOP);
+   assert(menu_accessibility_action(&s, MENU_ACCESS_ACTIVATE) == MENU_ACTION_OK);
+   assert(menu_accessibility_action(&s, MENU_ACCESS_BACK) == MENU_ACTION_LEFT);
+   s.can_enter = true; /* Configuration submenu. */
+   assert(menu_accessibility_action(&s, MENU_ACCESS_ENTER) == MENU_ACTION_OK);
+   s.depth = 3;
+   assert(menu_accessibility_action(&s, MENU_ACCESS_BACK) == MENU_ACTION_CANCEL);
+
+   s.count = 0; /* Empty directory/playlist must remain escapable. */
+   assert(menu_accessibility_action(&s, MENU_ACCESS_ACTIVATE) == MENU_ACTION_NOOP);
+   assert(menu_accessibility_action(&s, MENU_ACCESS_ENTER) == MENU_ACTION_NOOP);
+   assert(menu_accessibility_action(&s, MENU_ACCESS_NEXT) == MENU_ACTION_NOOP);
+   assert(menu_accessibility_action(&s, MENU_ACCESS_BACK) == MENU_ACTION_CANCEL);
+   s.depth = 1;
+   assert(menu_accessibility_action(&s, MENU_ACCESS_BACK) == MENU_ACTION_LEFT);
+
+   s.count = 2;
+   s.depth = 2;
+   assert(menu_accessibility_action(&s, MENU_ACCESS_INCREASE) == MENU_ACTION_NOOP);
+   s.can_adjust = true;
+   assert(menu_accessibility_action(&s, MENU_ACCESS_INCREASE) == MENU_ACTION_RIGHT);
+   assert(menu_accessibility_action(&s, MENU_ACCESS_DECREASE) == MENU_ACTION_LEFT);
+   s.category = true;
+   assert(menu_accessibility_action(&s, MENU_ACCESS_INCREASE) == MENU_ACTION_NOOP);
+   assert(menu_accessibility_action(NULL, MENU_ACCESS_ACTIVATE) == MENU_ACTION_NOOP);
+   s.message = true;
+   assert(menu_accessibility_action(&s, MENU_ACCESS_ACTIVATE) == MENU_ACTION_CANCEL);
+   assert(menu_accessibility_action(&s, MENU_ACCESS_NEXT) == MENU_ACTION_NOOP);
+   pending = MENU_ACTION_OK;
+   assert(menu_accessibility_take_action(&pending, MENU_ACTION_NOOP, true) == MENU_ACTION_OK);
+   assert(menu_accessibility_take_action(&pending, MENU_ACTION_NOOP, true) == MENU_ACTION_NOOP);
+   pending = MENU_ACTION_OK;
+   assert(menu_accessibility_take_action(&pending, MENU_ACTION_DOWN, true) == MENU_ACTION_DOWN);
+   assert(menu_accessibility_take_action(&pending, MENU_ACTION_NOOP, true) == MENU_ACTION_NOOP);
+   pending = MENU_ACTION_OK;
+   assert(menu_accessibility_take_action(&pending, MENU_ACTION_NOOP, false) == MENU_ACTION_NOOP);
+   assert(menu_accessibility_take_action(&pending, MENU_ACTION_NOOP, true) == MENU_ACTION_NOOP);
+   puts("PASS: category navigation, enter/activate separation, empty-list escape, value adjustment");
+   return 0;
+}
