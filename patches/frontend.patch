+/**
+ * A core-provided accessibility speech request.
+ *
+ * Frontends that support \c RETRO_ENVIRONMENT_ACCESSIBILITY_SPEAK should
+ * route this through the same native accessibility backend used for frontend
+ * menu narration. The frontend should make its own copy of the submitted text.
+ */
+struct retro_accessibility_speech
+{
+   /**
+    * The \c NULL-terminated text to speak. Must not be \c NULL.
+    */
+   const char *text;
+
+   /**
+    * Relative priority. Higher values indicate speech that should interrupt
+    * or replace less important pending speech, matching frontend policy.
+    */
+   int priority;
+
+   /**
+    * Optional channel/source name, such as "menu", "navigation", or "combat".
+    * May be \c NULL.
+    */
+   const char *channel;
+
+   /**
+    * A bitwise OR of \c RETRO_ACCESSIBILITY_SPEECH_FLAG_* values, or 0.
+    *
+    * 0 requests the frontend's legacy behaviour and is always safe. A core
+    * must not set a flag whose matching capability was not reported by
+    * \c RETRO_ENVIRONMENT_GET_ACCESSIBILITY_SPEECH_INTERFACE.
+    */
+   unsigned flags;
+};
