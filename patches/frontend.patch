+
+/**
+ * Speak \c text after whatever is already speaking, without cutting it off.
+ * Requires \c RETRO_ACCESSIBILITY_SPEECH_CAP_QUEUE.
+ */
+#define RETRO_ACCESSIBILITY_SPEECH_FLAG_QUEUE     (1U << 1)
+
+/**
+ * Cancel current and pending speech. \c text is ignored and may be \c NULL.
+ * Takes precedence over the other flags. Requires
+ * \c RETRO_ACCESSIBILITY_SPEECH_CAP_STOP.
+ */
+#define RETRO_ACCESSIBILITY_SPEECH_FLAG_STOP      (1U << 2)
+
+/** The frontend can speak at all. Implied by every other capability. */
+#define RETRO_ACCESSIBILITY_SPEECH_CAP_SPEAK      (1ULL << 0)
+/** \c RETRO_ACCESSIBILITY_SPEECH_FLAG_INTERRUPT is honoured. */
+#define RETRO_ACCESSIBILITY_SPEECH_CAP_INTERRUPT  (1ULL << 1)
+/** \c RETRO_ACCESSIBILITY_SPEECH_FLAG_QUEUE is honoured: a queued line does
+ *  not cut off the line before it. Only set by backends that can really do it. */
+#define RETRO_ACCESSIBILITY_SPEECH_CAP_QUEUE      (1ULL << 2)
+/** \c RETRO_ACCESSIBILITY_SPEECH_FLAG_STOP is honoured. */
+#define RETRO_ACCESSIBILITY_SPEECH_CAP_STOP       (1ULL << 3)
+
+/**
+ * What the frontend's current speech backend can do.
+ * @see RETRO_ENVIRONMENT_GET_ACCESSIBILITY_SPEECH_INTERFACE
+ */
