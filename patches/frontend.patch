+/* One synthesizer for the whole process.
+ *
+ * Apple: "The system doesn't automatically retain the speech synthesizer, so you
+ * need to manually retain it until speech concludes." A function-local static is
+ * a strong reference under ARC, so this instance lives as long as the process.
+ *
+ * Sharing it is also what makes queueing possible at all: the utterance queue
+ * belongs to the instance, so a second synthesizer would speak over the first
+ * rather than after it. */
+API_AVAILABLE(macos(10.14), ios(7.0), tvos(9.0))
+static AVSpeechSynthesizer *darwin_speech_synth(void)
+{
+   static dispatch_once_t once;
+   static AVSpeechSynthesizer *synth;
+   dispatch_once(&once, ^{
+      synth = [[AVSpeechSynthesizer alloc] init];
+   });
+   return synth;
+}
+
+/* Builds the utterance the same way for legacy and flagged requests, so the
+ * voice and rate the user already hears cannot drift between the two paths.
+ *
+ * A fresh utterance every time is required, not an optimisation to undo: Apple
+ * documents that "attempting to enqueue the same utterance more than once throws
+ * an exception". */
+API_AVAILABLE(macos(10.14), ios(7.0), tvos(9.0))
+static AVSpeechUtterance *darwin_speech_utterance(int speed,
+      const char *speak_text)
+{
+   NSString          *text;
+   NSString          *language_string = nil;
+   AVSpeechUtterance *utterance;
+   const char        *language;
+
+   if (!speak_text)
+      return nil;
+   /* stringWithUTF8String: returns nil for malformed UTF-8, and passing nil to
+    * speechUtteranceWithString: raises an Objective-C exception, which would
+    * take RetroArch down. For any well-formed text this changes nothing. */
+   if (!(text = [NSString stringWithUTF8String:speak_text]))
+      return nil;
+   if (!(utterance = [AVSpeechUtterance speechUtteranceWithString:text]))
+      return nil;
+
+   utterance.rate  = (float)speed / 10.0f;
+   language        = get_user_language_iso639_1(false);
+   if (language)
+      language_string = [NSString stringWithUTF8String:language];
+   /* voiceWithLanguage: may return nil for a language with no installed voice;
+    * assigning nil selects the system default, which is the existing behaviour. */
+   utterance.voice = [AVSpeechSynthesisVoice voiceWithLanguage:language_string];
+
+   /* Prefer the user's active assistive technology settings. With none active,
+    * the synthesizer keeps the language and rate configured above.
+    * Guard older SDKs as well as older systems; early Big Sur SDKs use 101600. */
+#if   (defined(MAC_OS_X_VERSION_MAX_ALLOWED)    && MAC_OS_X_VERSION_MAX_ALLOWED    >= 101600) \
+   || (defined(__IPHONE_OS_VERSION_MAX_ALLOWED) && __IPHONE_OS_VERSION_MAX_ALLOWED >= 140000) \
+   || (defined(__TV_OS_VERSION_MAX_ALLOWED)     && __TV_OS_VERSION_MAX_ALLOWED     >= 140000)
+   if (@available(macOS 11.0, iOS 14.0, tvOS 14.0, *))
+      utterance.prefersAssistiveTechnologySettings = YES;
+#endif
+   return utterance;
+}
