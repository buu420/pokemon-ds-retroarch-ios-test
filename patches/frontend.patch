+/* Native assistive input reads the same visible entries and enters the normal
+ * menu frame, including its help dialogs, refresh and speech handling. */
+bool ozone_accessibility_get_state(menu_accessibility_state_t *state)
+{
+   menu_entry_t entry;
+   file_list_t *list;
+   file_list_t *stack;
+   ozone_handle_t *ozone;
+   struct menu_state *menu_st = menu_state_get_ptr();
+   if (!state)
+      return false;
+   memset(state, 0, sizeof(*state));
+   if (!(menu_st->flags & MENU_ST_FLAG_ALIVE)
+         || (menu_st->flags & (MENU_ST_FLAG_IS_BINDING
+            | MENU_ST_FLAG_BLOCK_ALL_INPUT | MENU_ST_FLAG_INP_DLG_KB_DISPLAY))
+         || !menu_st->driver_ctx || !menu_st->driver_data || !menu_st->userdata
+         || !string_is_equal(menu_st->driver_ctx->ident, "ozone")
+         || !menu_st->entries.list)
+      return false;
+
+   ozone = (ozone_handle_t*)menu_st->userdata;
+   list  = MENU_LIST_GET_SELECTION(menu_st->entries.list, 0);
+   stack = MENU_LIST_GET(menu_st->entries.list, 0);
+   if (!stack || !stack->size)
+      return false;
+   state->depth = stack->size;
+   state->category = (ozone->flags & OZONE_FLAG_CURSOR_IN_SIDEBAR) != 0;
+   menu_entries_get_title(state->title, sizeof(state->title));
+   if (menu_accessibility_dialog_active())
+   {
+      state->message = true;
+      strlcpy(state->label, menu_st->driver_data->menu_state_msg, sizeof(state->label));
+      return true;
+   }
+   if (state->category)
+   {
+      state->position = ozone->categories_selection_ptr;
+      state->count = ozone->system_tab_end
+            + (ozone->show_playlist_tabs ? ozone->horizontal_list.size : 0) + 1;
+      state->can_enter = true;
+      strlcpy(state->label, state->title, sizeof(state->label));
+      return true;
+   }
+   state->count = list ? list->size : 0;
+   state->position = menu_st->selection_ptr;
+   if (!list || !list->size || state->position >= list->size)
+   {
+      state->count = 0;
+      return true;
+   }
+
+   MENU_ENTRY_INITIALIZE(entry);
+   entry.flags = MENU_ENTRY_FLAG_PATH_ENABLED | MENU_ENTRY_FLAG_LABEL_ENABLED
+         | MENU_ENTRY_FLAG_RICH_LABEL_ENABLED | MENU_ENTRY_FLAG_VALUE_ENABLED
+         | MENU_ENTRY_FLAG_SUBLABEL_ENABLED;
+   menu_entry_get(&entry, 0, state->position, NULL, true);
+   strlcpy(state->label, !string_is_empty(entry.rich_label)
+         ? entry.rich_label : entry.path, sizeof(state->label));
+   strlcpy(state->help, entry.sublabel, sizeof(state->help));
+
+   state->can_enter = menu_cbs_ok_is_navigation(
+         (const menu_file_list_cbs_t*)list->list[state->position].actiondata)
+         || entry.setting_type == ST_PATH || entry.setting_type == ST_DIR;
+   if (!string_is_equal(entry.value, msg_hash_to_str(MENU_ENUM_LABEL_VALUE_MORE)))
+      strlcpy(state->value, !string_is_empty(entry.password_value)
+            ? entry.password_value : entry.value, sizeof(state->value));
+   switch (entry.setting_type)
+   {
+      case ST_BOOL:
+      case ST_INT:
+      case ST_UINT:
+      case ST_SIZE:
+      case ST_FLOAT:
+      case ST_STRING_OPTIONS:
+         state->can_adjust = true;
+         break;
+      default:
+         state->can_adjust = entry.type >= MENU_SETTINGS_CORE_OPTION_START
+               && entry.type < MENU_SETTINGS_CHEEVOS_START;
+         break;
+   }
+   return true;
+}
+
+bool ozone_accessibility_perform(enum menu_accessibility_gesture gesture)
+{
+   menu_accessibility_state_t state;
+   struct menu_state *menu_st = menu_state_get_ptr();
+   ozone_handle_t *ozone;
+   if (!ozone_accessibility_get_state(&state))
+      return false;
+   ozone = (ozone_handle_t*)menu_st->userdata;
+   menu_st->input_last_time_us = cpu_features_get_time_usec();
+   if (menu_st->flags & MENU_ST_FLAG_SCREENSAVER_ACTIVE)
+   {
+      menu_st->flags &= ~MENU_ST_FLAG_SCREENSAVER_ACTIVE;
+      if (menu_st->driver_ctx->environ_cb)
+         menu_st->driver_ctx->environ_cb(MENU_ENVIRON_DISABLE_SCREENSAVER,
+               NULL, menu_st->userdata);
+   }
+   ozone->flags &= ~OZONE_FLAG_CURSOR_MODE;
+   menu_st->scroll.acceleration = 0;
+   return menu_accessibility_queue_action(menu_accessibility_action(&state, gesture));
+}
