+static uint64_t accessibility_speech_caps_darwin(const char **backend)
+{
+   if (backend)
+      *backend = "none";
+
+   if (@available(macOS 10.14, iOS 7, tvOS 9, *))
+   {
+      if (!darwin_speech_synth())
+         return 0;
+      if (backend)
+         *backend = "avspeech";
+      /* All three are documented behaviour of AVSpeechSynthesizer, not
+       * inference: speak(_:) "adds the utterance you specify to the speech
+       * synthesizer's queue", and when it is already speaking "the synthesizer
+       * adds utterances to a queue and speaks them in the order it receives
+       * them"; stopSpeaking(at:) "immediately cancels speech and removes all
+       * unspoken utterances from the synthesizer's queue". */
+      return RETRO_ACCESSIBILITY_SPEECH_CAP_SPEAK
+           | RETRO_ACCESSIBILITY_SPEECH_CAP_INTERRUPT
+           | RETRO_ACCESSIBILITY_SPEECH_CAP_QUEUE
+           | RETRO_ACCESSIBILITY_SPEECH_CAP_STOP;
