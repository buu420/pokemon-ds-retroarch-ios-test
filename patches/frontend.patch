+#if defined(HAVE_CG) || defined(HAVE_GLSL) || defined(HAVE_SLANG) || defined(HAVE_HLSL)
+      action_ok_shader_preset_manager, action_ok_shader_parameters,
+      action_ok_shader_preset, action_ok_shader_preset_prepend, action_ok_shader_preset_append,
+#endif
+   };
+   if (!cbs || !cbs->action_ok)
+      return false;
+   for (i = 0; i < ARRAY_SIZE(navigation); ++i)
+      if (cbs->action_ok == navigation[i])
+         return true;
+   /* Unknown and mixed-purpose callbacks require explicit activation. In
+    * particular, core-option dropdowns can toggle a Boolean and subsystem load
+    * callbacks can launch content despite also using display-list helpers. */
+   return false;
+}
