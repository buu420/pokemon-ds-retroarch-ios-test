+/* RetroArch - A frontend for libretro.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#ifndef RETROARCH_MENU_ACCESSIBILITY_H
+#define RETROARCH_MENU_ACCESSIBILITY_H
+
+#include <stddef.h>
+#include <boolean.h>
+#include <retro_inline.h>
+#include "menu_defines.h"
+
+RETRO_BEGIN_DECLS
+
+enum menu_accessibility_gesture
+{
+   MENU_ACCESS_PREVIOUS,
+   MENU_ACCESS_NEXT,
+   MENU_ACCESS_ENTER,
+   MENU_ACCESS_BACK,
+   MENU_ACCESS_ACTIVATE,
+   MENU_ACCESS_INCREASE,
+   MENU_ACCESS_DECREASE
+};
+
+typedef struct menu_accessibility_state
+{
+   char title[512];
+   char label[512];
+   char value[512];
+   char help[512];
+   size_t position;
+   size_t count;
+   size_t depth;
+   bool category;
+   bool can_enter;
+   bool can_adjust;
+   bool message;
+} menu_accessibility_state_t;
+
+/* Resolve a completed gesture without holding or repeating any game input.
+ * Enter and activate deliberately differ for terminal commands. */
+static INLINE enum menu_action menu_accessibility_action(
+      const menu_accessibility_state_t *state,
+      enum menu_accessibility_gesture gesture)
+{
+   if (!state)
+      return MENU_ACTION_NOOP;
+   if (state->message)
+      return (gesture == MENU_ACCESS_BACK || gesture == MENU_ACCESS_ACTIVATE)
+            ? MENU_ACTION_CANCEL : MENU_ACTION_NOOP;
+   if (gesture == MENU_ACCESS_BACK)
+      return state->category ? MENU_ACTION_NOOP :
+            (state->depth > 1 ? MENU_ACTION_CANCEL : MENU_ACTION_LEFT);
+   if (!state->count)
+      return MENU_ACTION_NOOP;
+   switch (gesture)
+   {
+      case MENU_ACCESS_PREVIOUS:
+         return MENU_ACTION_UP;
+      case MENU_ACCESS_NEXT:
+         return MENU_ACTION_DOWN;
+      case MENU_ACCESS_ENTER:
+         return state->category ? MENU_ACTION_RIGHT :
+               (state->can_enter ? MENU_ACTION_OK : MENU_ACTION_NOOP);
+      case MENU_ACCESS_ACTIVATE:
+         return state->category ? MENU_ACTION_RIGHT : MENU_ACTION_OK;
+      case MENU_ACCESS_INCREASE:
+         return !state->category && state->can_adjust
+               ? MENU_ACTION_RIGHT : MENU_ACTION_NOOP;
+      case MENU_ACCESS_DECREASE:
+         return !state->category && state->can_adjust
+               ? MENU_ACTION_LEFT : MENU_ACTION_NOOP;
+      default:
+         return MENU_ACTION_NOOP;
+   }
+}
+
+/* One pending gesture, consumed by the normal menu frame. Physical input wins
+ * a simultaneous conflict so a delayed activation cannot hit a new selection. */
+static INLINE enum menu_action menu_accessibility_take_action(
+      enum menu_action *pending, enum menu_action physical, bool allowed)
+{
+   enum menu_action gesture = *pending;
+   *pending = MENU_ACTION_NOOP;
+   return allowed && physical == MENU_ACTION_NOOP ? gesture : physical;
+}
+
+bool menu_accessibility_queue_action(enum menu_action action);
+void menu_accessibility_cancel_action(void);
+/* HELP/INFO are identified from the menu stack, not transient render flags. */
+bool menu_accessibility_dialog_active(void);
+
+#ifdef HAVE_OZONE
+bool ozone_accessibility_get_state(menu_accessibility_state_t *state);
+bool ozone_accessibility_perform(enum menu_accessibility_gesture gesture);
+#endif
+
+RETRO_END_DECLS
+#endif
